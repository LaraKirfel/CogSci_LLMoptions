estionID":"QID939"},{"Type":"Question","QuestionID":"QID940"},{"Type":"Question","QuestionID":"QID941"},{"Type":"Question","QuestionID":"QID942"},{"Type":"Question","QuestionID":"QID943"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Ask for help.","2":"Take out a loan.","3":"Sell some items.","4":"Not got it.","5":"Steal money.","6":"R_11cwa4Rb5sUMoC0"},"2":{"1":"Borrow money from friends and relatives.","2":"Ask for a loan.","3":"Look for alternatives.","4":"Ask for assistance.","5":"Buy the ones he can.","6":"R_11u8lFJDCIDjOHx"},"3":{"1":"Heinz can take on extra jobs to come up with the money.","2":"Heinz can ask the doctor and pharmacy about coupons for the medicine.","3":"Heinz can sell something he owns to get the cash.","4":"Heinz can start a GoFundMe to get the cash.","5":"Heinz can ask friends or family for a loan.","6":"R_18CfvWR8YoIBQbC"},"4":{"1":"Appeal the coverage with the insurer.","2":"Look for programs the pharma company has to help.","3":"Ask for support from local organizations.","4":"Consider alternative therapies.","5":"Crowdfund or ask friends and family.","6":"R_1EZoFzjCq1uQ8s9"},"5":{"1":"He could start a GoFundMe campaign.","2":"He could see if there is a way to get a discount from the drug company.","3":"He could rob a store or a bank.","4":"He could borrow money from a loved one.","5":"He could steal money from a loved one.","6":"R_1FnUUW3HgevYzZd"},"6":{"1":"Ask a family member for money.","2":"Ask a friend for money.","3":"Ask the pharmacy for discounts.","4":"Start a GoFundMe.","5":"Not by it.","6":"R_1Hozj5hB2tr9ELj"},"7":{"1":"Start a GoFundMe or Crowdfund.","2":"Steal money from someone to opay for the meds.","3":"Attempt to find alternate or generic treatments.","4":"Contact the drug manufacturer to see if they have any assistance programs.","5":"Plea with insurance company to reconsider covering the med.","6":"R_1I3RUbhp0iKejll"},"8":{"1":"Contact her health care provider to see if an assistance program is in place.","2":"Contact the drug manufacturer to see if an assistance program is in place.","3":"Search to see if any community social services organizations provide this type of assistance.","4":"Look toward social media for a good Samaritan.","5":"Start a \"GoFundMe\" to raise money for Rx.","6":"R_1NCTivNHn2R2xwd"},"9":{"1":"See if there are any programs that may cover it.","2":"Contact local churches to see if they can help.","3":"Ask friends and family.","4":"Sell or pawn something.","5":"Take out a payday loan.","6":"R_1VBGtWflhw8qKXv"},"10":{"1":"Ask the doctor for assistance.","2":"Seek financial aid programme.","3":"Apply for a payment plan.","4":"Crowdfunding.","5":"Borrow money from family or friends.","6":"R_1WHyzUjIfj8D3MZ"},"11":{"1":"Seek financial support.","2":"Crowdfunding.","3":"Talk to the Pharmacy.","4":"Consult with doctor.","5":"Find charity organizations.","6":"R_1aNNXAPtx2JG665"},"12":{"1":"Borrow money.","2":"Steal money.","3":"Pawn valuables.","4":"Mortgage the house.","5":"Set up a GoFundMe.","6":"R_1gRsz8apkxehTES"},"13":{"1":"Ask family.","2":"New insurance.","3":"GoFundMe.","4":"Ask friends.","5":"Ask his\/her family.","6":"R_1gYkTgONa1P7tlf"},"14":{"1":"Reach out to family or friends for financial help.","2":"Look into discount programs or financial assistance from the pharmaceutical company.","3":"Sell personal belongings or valuables to raise the money.","4":"Consider taking out a loan or using a credit card to pay for the medication.","5":"Contact a local charity or non-profit organization that provides financial assistance for medical needs.","6":"R_1meCQpmm7l4RkEk"},"15":{"1":"Ask for assistance from family.","2":"Ask for assistance from friends.","3":"Ask if the doctor has any samples.","4":"Ask if the doctor has any coupons toward discounts.","5":"Try to negotiate with the insurance company.","6":"R_1oLsH88LkvnErhT"},"16":{"1":"Fundraiser.","2":"Ask family.","3":"Ask friends.","4":"Take a loan.","5":"Sell valuable personal stuff.","6":"R_1odU3Ka3wecrCse"},"17":{"1":"Take out a loan.","2":"Rob the pharmacy.","3":"Ask for money.","4":"Kill wife.","5":"Call the insurance company.","6":"R_1qeXmTebFIxcmuU"},"18":{"1":"Borrow money from friends and family.","2":"Borrow money from the bank.","3":"Contact government assistance services.","4":"Crowdfunding.","5":"Do not use the medicine.","6":"R_2LZPiBvOgQw33Ij"},"19":{"1":"Ask pharmacy\/doctors about alternatives or discounts.","2":"Ask friends and family for assistance.","3":"Sell possessions or take on extra work to get the money for it.","4":"Start a GoFundMe campaign to get the money needed.","5":"Rob a bank.","6":"R_30MXRF4OYEAUjyM"},"20":{"1":"Hope.","2":"Seek alternative options.","3":"Pray.","4":"Seek medical information.","5":"Loan.","6":"R_32R0r2qoXbuX4HA"},"21":{"1":"Get help.","2":"Ask for a cheaper script.","3":"GoFundMe.","4":"Go to hospital.","5":"Find better insurance.","6":"R_32mp9ZvRhgXm8nv"},"22":{"1":"Work extra to get extra money.","2":"Get a loan from the bank.","3":"Ask for help (GoFundMe).","4":"Take money from retirement\/savings.","5":"Search up other types of insurance that can cover the cost.","6":"R_39AOh67MgzH9Ec1"},"23":{"1":"Source for money from family.","2":"Source for money from friends.","3":"Sell some valuable assets.","4":"Use a credit card.","5":"Fundraising.","6":"R_3AYfE1sOrSAcGk1"},"24":{"1":"Seek financial.","2":"Contact the doctor.","3":"Look for a suitable payment plan.","4":"Explore sourcing at different places.","5":"Contact the pharma company.","6":"R_3GN9uIXPDKwy275"},"25":{"1":"Research different coupons.","2":"Ask the prescriber if there is a cheaper medication.","3":"Ask the pharmacy if there are any coupons.","4":"Call your insurance and question it.","5":"Ask a family member for assistance.","6":"R_3INoGfI7cOjyIEJ"},"26":{"1":"They should make a WhatsApp group for fundraising.","2":"They should raise the issue on social media platforms.","3":"They should cut their expenses.","4":"Increase savings.","5":"Pray to God.","6":"R_3IPID3OvJ1BNufp"},"27":{"1":"They could try a different drugstore.","2":"They could ask for a generic brand if it does the same.","3":"They could ask around.","4":"They could talk to their doctor, explaining they cannot afford it.","5":"They could ask to borrow money.","6":"R_3PyEZ8tqeoRu3J2"},"28":{"1":"Find out if there is an agency that could help cover the cost.","2":"See if there is a generic version.","3":"Talk to her doctor.","4":"Talk to their insurance provider.","5":"Go online and see if there are any viable solutions.","6":"R_3PyR670oZA2M5st"},"29":{"1":"Put it on a credit card and pay it off over time.","2":"Ask the pharmacist for discounted programs.","3":"Set up a GoFundMe page.","4":"Ask the doctor for a generic alternative.","5":"Go without.","6":"R_3QWOpnso93EfdZj"},"30":{"1":"Borrow Personal Loan.","2":"Get a private loan.","3":"Negotiate pay with the hospital.","4":"Talk about alternatives with the doctor.","5":"Crowdfunding.","6":"R_3RyAI83UO85Mq0k"},"31":{"1":"See if there is a generic version available.","2":"Start a GoFundMe.","3":"Reach out to the drug manufacturer to see if they have rebates or coupons.","4":"Call the doctor's office to see if they have samples.","5":"Ask family to help with money.","6":"R_3S6UjJG08PiCEPp"},"32":{"1":"Switch insurance.","2":"Sell old things.","3":"Ask doctor options.","4":"Look into state benefits for prescriptions.","5":"Go full Walter White.","6":"R_3SoVE4JwjV3oFQl"},"33":{"1":"Ask family or friends for financial assistance or a loan.","2":"Set up a fundraising campaign to raise money for the medication.","3":"Seek help from a medical assistance programme.","4":"Negotiate with the pharmacy or manufacturer for discounts or payment plans.","5":"Explore alternative medications that might be more affordable.","6":"R_3oL1VXC3odM9ry0"},"34":{"1":"He could start a GoFundMe account.","2":"He can ask for help from relatives and friends.","3":"He can ask for relatively cheaper alternatives.","4":"He could ask for discounts.","5":"He could negotiate with the pharmacy to see if they have flexible payment methods.","6":"R_3oXW4v4k4JrjH1L"},"35":{"1":"Sell an asset.","2":"Take a loan.","3":"Look for generic.","4":"Do nothing.","5":"Steal.","6":"R_3onnhStfWvSx3rG"},"36":{"1":"Heinz could sell some of his personal belongings to make ends meet.","2":"Heinz could ask to borrow money from trusted friends and family.","3":"Heinz could inquire about a cheaper generic equivalent to the medicine.","4":"Heinz could look into alternative treatments for whatever is ailing his wife.","5":"Heinz could ask his wife if she has any ideas about raising the money they need.","6":"R_511rbeex9qAL56S"},"37":{"1":"Steal money.","2":"Borrow money.","3":"Sell items to get more money.","4":"Beg the insurance company to reconsider.","5":"Get a second job.","6":"R_514nlU3fSXVOknF"},"38":{"1":"He could take on more work.","2":"He could sell some things that he owns.","3":"He could start a fundraiser.","4":"He could apply for a loan at a bank.","5":"He could turn to family for the money.","6":"R_52HHUcflPbAFLFf"},"39":{"1":"Contact the pharmaceutical company for patient assistance programs.","2":"Look into crowdfunding or fundraising.","3":"Ask the doctor for alternative medications or solutions.","4":"Seek financial assistance from charities or nonprofit organizations.","5":"Negotiate with the pharmacy or explore payment plans.","6":"R_52JBySUdttrVTi0"},"40":{"1":"Pawn items in order to pay for meds.","2":"Ask to borrow money from a friend.","3":"Apply for a credit card.","4":"Apply for a small loan.","5":"Seek out the black market for the meds.","6":"R_53V45FDrHSBpukV"},"41":{"1":"Use a credit card.","2":"Loan some money.","3":"Ask for help from friends.","4":"Buy the medication in bit.","5":"Open a GoFundMe account.","6":"R_54eLulcQnR1s3TC"},"42":{"1":"Call the company that produces the meds for coupons or reduced rates.","2":"Ask friends and family.","3":"Take on a second job.","4":"Ask the insurance company to reassess.","5":"Ask the doctor for other medications that would be as effective.","6":"R_57Qn25xpVJM8QUN"},"43":{"1":"Start a fundraiser.","2":"Call local resources.","3":"Pick up multiple jobs to cover expenses.","4":"Ask a family member.","5":"Choose to not just not get it.","6":"R_5CfFrpbgdlKYh7S"},"44":{"1":"Seek a loan to buy the medication.","2":"Sell possessions to raise the money.","3":"Seek help from social services.","4":"Seek help from clergy.","5":"Steal the money.","6":"R_5DoGtkVU2Jjwc54"},"45":{"1":"Find herbs to take instead.","2":"Find prescription discounts.","3":"Call Dr. back and find a different medication that is covered by insurance.","4":"Take over-the-counter meds instead.","5":"Do nothing.","6":"R_5DvkV3f3cVc3i13"},"46":{"1":"Start a GoFundMe.","2":"Ask family and friends for help.","3":"Try to find other ways to earn money.","4":"Save money on other things as much as you can.","5":"Sell stuff that is not important.","6":"R_5HOqqLtIEk6a2ZP"},"47":{"1":"Heinz could reach out to family members for their help.","2":"He could borrow from the bank.","3":"He could create a GoFundMe account and create awareness about his challenge on social media.","4":"He could decide to risk his life and do nothing.","5":"He could also buy over-the-counter drugs and do a self-medication for her.","6":"R_5JFQkbBsye5Z7Q9"},"48":{"1":"Ask someone for the money.","2":"Get a loan.","3":"Raise the funds.","4":"Sell something.","5":"Na.","6":"R_5KH46MDo4bO40de"},"49":{"1":"Ask for financial assistance from their doctor's office.","2":"Contact a nonprofit.","3":"Order the medications from Canada.","4":"Borrow money.","5":"Go without.","6":"R_5KxvFmEl4eN7DXR"},"50":{"1":"Ask to borrow money from a family member or friend.","2":"Ask if there is a payment plan that can be set up.","3":"Find another insurance that will cover it.","4":"See if there are alternative medications.","5":"Accept that they can't afford it and find natural remedies.","6":"R_5MR5QvICk3iVxQb"},"51":{"1":"Start a GoFundMe.","2":"Ask family.","3":"Ask friends.","4":"Steal the money.","5":"Work extra jobs.","6":"R_5QDdHosyEaRHfop"},"52":{"1":"Heinz could ask friends and family to borrow the money.","2":"Heinz could start a GoFundMe page to raise the money needed.","3":"Heinz could ask the Dr. if there is any other cheaper alternative that she could use.","4":"Heinz could ask the pharmacy for any discounts or payment plan options.","5":"Heinz could take his chances and just hope for the best without the medication.","6":"R_5RVbon0W8XsjWia"},"53":{"1":"Do freelance work to make extra money.","2":"Sell stuff that they have.","3":"Sell stocks that they have.","4":"Get a loan.","5":"Use their credit cards.","6":"R_5SejY3ouryoaGFQ"},"54":{"1":"They can open a GoFundMe for her.","2":"Heinz can ask the hospital if they can get a less expensive drug that can perform the same results.","3":"Heinz can ask friends for help.","4":"Heinz can sell some stuff he has to raise the money.","5":"Heinz can consult the insurance company to revise the policy.","6":"R_5UEstXgXyKAUHFT"},"55":{"1":"Get a second job to help pay for it.","2":"Crowdfund for it.","3":"Ask the doctor to change medication.","4":"Ask Insurance to reconsider.","5":"Go into debt.","6":"R_5VOYKBkeYCydCWE"},"56":{"1":"Sell any of his valuable properties.","2":"Beg friends for assistance.","3":"Plead with family for assistance.","4":"Beg church people for donations.","5":"Plea for fundraising.","6":"R_5dmajywumMb7QnU"},"57":{"1":"Make a GoFundMe.","2":"Get an extra job, work more.","3":"Do nothing.","4":"?.","5":"?.","6":"R_5hLArf5UT11I013"},"58":{"1":"Take out loans.","2":"Set up a donation page.","3":"Try to get an insurance that can cover the med.","4":"Borrow money.","5":"Heinz can look for a job that pays more.","6":"R_5hylUXm07Br8SGU"},"59":{"1":"Ask family and friends for the money.","2":"Pick up extra work to make money to defray the cost.","3":"Get a Loan.","4":"Sign up for a medical prescription programme.","5":"Sign up for Medicaid program.","6":"R_5lPMZUXs2CMWpvf"},"60":{"1":"Start a GoFundMe.","2":"Look for a charity that does this sort of thing.","3":"Ask family members for money.","4":"Sell an asset.","5":"Steal money.","6":"R_5sn02dInsUYYBeV"},"61":{"1":"Try to raise the money.","2":"Ask for donations.","3":"Work overtime.","4":"Steal it.","5":"Talk to someone about a payment plan.","6":"R_5tmA0q620A1GGus"},"62":{"1":"Heinz could contact the pharmacy or the drug manufacturer to ask for discounts, payment plans, or access to a patient assistance program.","2":"Heinz could reach out to loved ones to borrow money or request financial support for the medication.","3":"Heinz could look into nonprofit organizations, charities, or community programs that provide financial aid for medical expenses.","4":"Heinz could start an online crowdfunding campaign to raise money for the medication by sharing his story with a larger audience.","5":"Heinz could discuss the situation with his wife's doctor to see if there are alternative treatments, generic versions, or samples that could be provided temporarily.","6":"R_61GiVxUTAexRwSF"},"63":{"1":"Ask friends for money.","2":"Ask family for money.","3":"Buy for a cheaper price online.","4":"Don't buy the medication.","5":"Find an alternative medicine.","6":"R_6B3bcSl08N0mNBZ"},"64":{"1":"Steal the money.","2":"Pick up a gig job.","3":"Ask friends to borrow money.","4":"Ask family to borrow money.","5":"File an appeal with the insurance company.","6":"R_6Cgew2l9Qmnsmkz"},"65":{"1":"1. Look for financial assistance programs or grants that help with medication costs. 2. Contact the pharmacy to see if they offer payment plans or discounts for the medication. 3. Ask the doctor if there is a less expensive alternative or generic version of the medication. 4. Consider crowdfunding or setting up a fundraising campaign to gather the necessary funds. 5. Reach out to family, friends, or community organizations to ask for financial support or a loan.","2":"2. Contact the pharmacy to see if they offer payment plans or discounts for the medication.","3":"3. Ask the doctor if there is a less expensive alternative or generic version of the medication.","4":"4. Consider crowdfunding or setting up a fundraising campaign to gather the necessary funds.","5":"5. Reach out to family, friends, or community organizations to ask for financial support or a loan.","6":"R_6CpCYqUbssasO1L"},"66":{"1":"Reach out to the pharmaceutical company that manufactures the medication to see if they offer any financial assistance programs or discounts.","2":"Contact local nonprofit organizations or charities that provide financial assistance for medical expenses to see if they can provide any help.","3":"Set up a crowdfunding campaign to raise money from friends, family, and community members to help cover the cost of the medication.","4":"Negotiate with the hospital or pharmacy to see if they can offer a payment plan or temporary financial assistance.","5":"Look into government programs or public assistance options that may be available to help cover the cost of the medication.","6":"R_6EaRLOS4p3QbXs6"},"67":{"1":"Heinz could try to secure a loan from a bank, a family member, or a friend in order to afford the medication. This could help immediately, but might create long-term financial strain.","2":"Heinz could research patient assistance programs, nonprofit organizations, or charities that offer help to individuals who can't afford life-saving medication. Some pharmaceutical companies also have assistance programs for people in financial need.","3":"Heinz could contact the pharmacy or manufacturer of the medication to see if there are any discounts, payment plans, or generic alternatives available that would make the medication more affordable.","4":"If Heinz owns valuable assets (such as a car, jewelry, or property), he might consider selling or pawning them to gather the necessary funds.","5":"Heinz could look into alternative medications or treatments that may be more affordable, though he would have to weigh the risks involved in choosing an unapproved or less-proven option.","6":"R_6IjdYRuK4t5JRDd"},"68":{"1":"Start a crowdfunding campaign on platforms.","2":"Negotiate with the pharmaceutical company.","3":"Research and apply for programs offered by pharmaceutical companies that provide financial aid for patients.","4":"Contact nonprofit organizations and patient advocacy groups like CancerCare.","5":"Explore government programs such as Medicaid and also local resources.","6":"R_6It9aEYe3rEhwAz"},"69":{"1":"He could borrow money from his friends or family.","2":"He could find a way to change insurance.","3":"He could ask for a second opinion from another doctor.","4":"He could take a credit under his name to purchase.","5":"He could obtain money illegally to buy the medication.","6":"R_6MSVzFHUWrpm50I"},"70":{"1":"Contact the doctor or pharmacist for alternatives.","2":"Explore Patient Assistance Programs.","3":"Negotiate with the pharmacy.","4":"Crowdfunding or Community Support.","5":"Look into Non-Profit Organizations or Charities.","6":"R_6SdvCWDMX9RPjsB"},"71":{"1":"Apply for assistance.","2":"Create a GoFundMe.","3":"Ask a family member to help.","4":"Apply for a credit card.","5":"Sell stuff.","6":"R_6Sg2q8T5PybBJOV"},"72":{"1":"Find a clinic that offers this medication.","2":"Apply through Medi-Cal.","3":"Find coupons from pharmaceuticals.","4":"Start a GoFundMe.","5":"Ask family.","6":"R_6YZk5zD6aHykU8x"},"73":{"1":"Borrow money from family.","2":"Borrow money from friends.","3":"Work an extra job.","4":"Sell things in their house.","5":"Ask for government help.","6":"R_6dRkFMKKqofDP4z"},"74":{"1":"Talk to the doctor about possible generic alternatives or free samples.","2":"Apply for financial aid through non-profits or patient assistance programs offered by the drug manufacturer.","3":"Reach out to family, friends, or community groups for financial help.","4":"Set up a fundraiser online to raise the needed money quickly.","5":"Explore options like a short-term loan or credit card for emergency expenses.","6":"R_6dtRAW7AKBimeJz"},"75":{"1":"Take out a loan.","2":"Start a GoFundMe.","3":"Ask friends and family for help.","4":"Look into other insurance.","5":"Gamble to try and win money to pay for it.","6":"R_6eVJD9NA6X9ZM1U"},"76":{"1":"Ask family or friends for the money.","2":"Get a loan from the bank.","3":"Cash out their retirement savings.","4":"Pay for it with credit cards and take on debt.","5":"Start a fundraising campaign online for the money.","6":"R_6jeQDjP0f1ICJuw"},"77":{"1":"Sell items.","2":"Take out a loan.","3":"Start a GoFundMe.","4":"Borrow from family\/friends.","5":"Get a second job.","6":"R_6lMIWdZPvWj8YT6"},"78":{"1":"Heinz could not purchase the medication at all.","2":"Heinz could borrow the money for the medication from family.","3":"Heinz could take out a loan for the medication.","4":"Heinz could try to synthesize the medication himself.","5":"Heinz could sell his worldly possessions to afford the medication.","6":"R_6n0gaBJlObJZNJL"},"79":{"1":"Contact the pharmacy to inquire about any payment plans.","2":"Look into patient assistance programs from the medication's manufacturer.","3":"Seek out a more affordable generic version of the medication, if available.","4":"Set up a crowdfunding campaign or reach out to family and friends for help.","5":"Talk to the doctor about alternative treatments or medications that are more affordable.","6":"R_6plmU6Tgn0BiLtn"},"80":{"1":"Look for resources to buy the medications.","2":"Reach out to friends for help\/assistance.","3":"Talk to the hospital to administer the medication while he looks for the funds.","4":"Try to reach the insurance company to see if they can add it to the bill.","5":"Blame himself for not being able to raise the resources needed.","6":"R_6rOYPyDRQWMNwFP"},"81":{"1":"Look into government assistance programs (e.g., Medicaid, Medicare) or state-specific aid to see if you qualify.","2":"Explore crowdfunding options (e.g., GoFundMe) to raise money for the medication.","3":"Contact the pharmaceutical company directly to inquire about patient assistance programs or discounted rates.","4":"Talk to the doctor or hospital about potential financial assistance programs or discounts.","5":"Reach out to local nonprofit organizations or patient advocacy groups for guidance and support.","6":"R_6uP6OOuNejdcIe3"},"82":{"1":"Borrow money.","2":"Contact the doctor for some samples until they can afford the medications.","3":"Get a second job to earn extra income.","4":"Don't pay other bills and buy the medication.","5":"Don't buy medication at all.","6":"R_71Y4sWvyzStdHjm"},"83":{"1":"Borrow from friends\/family.","2":"Get a payday loan.","3":"Sell something.","4":"Perform a gig job for pay\/side hustle.","5":"Get a loan from a credit union.","6":"R_71jIO8XxofgA5ZU"},"84":{"1":"Seek the advice of medical professionals.","2":"Go to friends and family.","3":"Start a GoFundMe.","4":"Travel to a different country with more affordable healthcare.","5":"He could \"find\" the medication.","6":"R_72WAzU0jf8bT65J"},"85":{"1":"Take out a loan.","2":"Get a credit card.","3":"Steal money.","4":"Ask a friend for money.","5":"Steal the medication.","6":"R_75yy6rmSUauMNtI"},"86":{"1":"Sell some things.","2":"Ask for money from some friends.","3":"Ask for money from family.","4":"Try to get a loan.","5":"Talk to the insurance company.","6":"R_79bryPGTSPpyX16"},"87":{"1":"Appeal the decision of the insurance company.","2":"Set up a payment plan to pay for the medication.","3":"See if the doctor can prescribe a different medication that will work.","4":"Maybe Heinz could work more hours to pay for the medication.","5":"Research alternative treatments.","6":"R_7HGk7UW6XVk8PmB"},"88":{"1":"Get a bank loan.","2":"Pawn something.","3":"Borrow money from family.","4":"Sell something.","5":"Have a yard sale.","6":"R_7MtImT69nciApx5"},"89":{"1":"Reach out to charities.","2":"Apply for financial assistance programs.","3":"Negotiate with the pharmacy.","4":"Community support.","5":"Explore alternative treatments.","6":"R_7NnYslnXUagUp2N"},"90":{"1":"Contact doctor for recommendation.","2":"Speak with pharmacy re: discount.","3":"Ask a friend for help.","4":"Borrow money.","5":"Sell something.","6":"R_7QSNb7GnKmUekTZ"},"91":{"1":"Seek Financial Assistance Programs.","2":"Crowdfunding.","3":"Negotiate with the doctor or pharmacy.","4":"Borrow Money.","5":"Explore Community or Government Aid.","6":"R_7TWTP8RLp9qJ8CZ"},"92":{"1":"Get a loan.","2":"Get a second job.","3":"See if she can be part of a research study.","4":"Ask friends and family for help.","5":"Start a fundraiser.","6":"R_7V04Jixznx3woZr"},"93":{"1":"Borrow.","2":"Ask for help with family.","3":"Get a loan.","4":"Go without.","5":"Ask Dr. for another medication.","6":"R_7YnrqDWDo1qaZVv"},"94":{"1":"GoFundMe account.","2":"Ask family.","3":"Ask a friend.","4":"Fundraiser.","5":"Take on an extra job.","6":"R_7YyvPXVx5tsAixx"},"95":{"1":"Steal the medication.","2":"GoFundMe.","3":"Take a second job\/work overtime to make more money.","4":"Ask family or friends.","5":"Wait it out.","6":"R_7d1d18cbc3kH9qi"},"96":{"1":"Sell personal property.","2":"Have a yard sale.","3":"Start a GoFundMe.","4":"Apply for state assistance.","5":"Ask family for a loan.","6":"R_7k0W3Cz8z59clz9"},"97":{"1":"Start a GoFundMe.","2":"Ask family members and neighbors for help.","3":"Apply for a loan.","4":"Ask the insurer if there is a similar medication that is covered by their healthcare provider.","5":"Have multiple jobs.","6":"R_7kTq963Jg1uqbcd"},"98":{"1":"Contact the pharmaceutical company for assistance programs.","2":"Seek help from local charities.","3":"Explore government assistance programs.","4":"Create a crowdfunding campaign.","5":"Negotiate with the pharmacy for discounts or payment plans.","6":"R_7lXk6NMhMvuo8pE"},"99":{"1":"Talk to the insurance company.","2":"Call the company of the medical and see if they can help.","3":"Crowd sourcing.","4":"Talk to their doctor about other options.","5":"Cut back on other things.","6":"R_7rPSRV6hIbSm6cS"},"100":{"1":"Rescue.","2":"First aid.","3":"Immediate doctor.","4":"Nurse.","5":"Good husband.","6":"R_7s61YpSgjK9tTKs"}},"Randomization":"Subset","TotalRandSubset":1}}},"63":{"Type":"Standard","SubType":"","Description":"Scenario3","ID":"BL_3a7bw1Jm1liD6wm","BlockElements":[{"Type":"Question","QuestionID":"QID788"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1015"},{"Type":"Question","QuestionID":"QID789"},{"Type":"Question","QuestionID":"QID790"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID993"},{"Type":"Question","QuestionID":"QID797"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID791"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID792"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID793"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID794"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID795"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID796"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1033"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1004"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID954"},{"Type":"Question","QuestionID":"QID955"},{"Type":"Question","QuestionID":"QID956"},{"Type":"Question","QuestionID":"QID957"},{"Type":"Question","QuestionID":"QID958"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Turn around for friend's ticket.","2":"See if someone can bring the ticket.","3":"Have her friend wait outside.","4":"See if they can look his ticket up at the concert.","5":"Buy an additional ticket at the gate.","6":"R_10wtlGJBiUnExNp"},"2":{"1":"Buy him a new one.","2":"Go without him.","3":"Agree to wait for him.","4":"Go with him.","5":"Get mad at him.","6":"R_11cwa4Rb5sUMoC0"},"3":{"1":"She could offer to purchase a ticket for Ted.","2":"She could wait for him to go home and get his ticket so they'd both miss most of the concert.","3":"She could find out if Ted could call someone to get into his house and bring him the ticket.","4":"She could go into the concert without Ted.","5":"She could choose to miss the concert, and they could both choose to do something else.","6":"R_17vAnhd7IcM0K3v"},"4":{"1":"Buy another ticket for Ted.","2":"Sneak Ted into the concert.","3":"Skip the concert with Ted.","4":"Go back to Ted's house to get the ticket.","5":"Go into the concert without Ted.","6":"R_190GFKTFeGPDRx7"},"5":{"1":"Darya could arrange to meet after the concert.","2":"Darya could save his seat for when he returns.","3":"Darya could give him her ticket and miss the concert.","4":"Darya could suggest he buy another ticket.","5":"Darya could leave with him to get his ticket.","6":"R_190yYgIlepm6122"},"6":{"1":"Go to the box office to see if there is an electronic version.","2":"Look for scalpers.","3":"Buy another ticket from the venue.","4":"Share tickets.","5":"Nothing.","6":"R_1EZoFzjCq1uQ8s9"},"7":{"1":"Return to his house for the ticket.","2":"Buy a new ticket.","3":"Buy from someone who is not willing to go.","4":"Ask for someone to bring it.","5":"Explain himself to those checking the tickets.","6":"R_1FOx5fZ5R68200x"},"8":{"1":"She could yell at Ted and leave him there.","2":"She could be understanding and go with Ted to retrieve the tickets.","3":"She could suggest Ted call a friend or family member with a key to his house to bring the tickets to them.","4":"She could get upset and demand Ted to go get the tickets.","5":"She could buy more tickets at the gate.","6":"R_1FnUUW3HgevYzZd"},"9":{"1":"Give him her ticket.","2":"Buy a new ticket.","3":"Offer to go do something else together.","4":"Let him return to get his ticket.","5":"Both go back to get the ticket.","6":"R_1Gv59GbbxIG4hqx"},"10":{"1":"Go home.","2":"Ask they look up ticket receipt.","3":"Buy another ticket.","4":"Cry.","5":"See scalpers for another ticket.","6":"R_1Hcg6SPp3BVoCeB"},"11":{"1":"Jump the fence and sneak in.","2":"Plead with the ticket agent.","3":"Purchase another ticket.","4":"Miss the concert and sulk in the car.","5":"Call home and see if someone can bring it there so he doesn't miss the entire thing.","6":"R_1I3RUbhp0iKejll"},"12":{"1":"Leave and go with Ted to get ticket.","2":"Let Ted go himself to get the ticket.","3":"See if anyone is selling a ticket.","4":"Everyone leaves as a group.","5":"Go to the concert and wait for Ted.","6":"R_1Ic4ZIMVOPoURkj"},"13":{"1":"Offer to buy a new ticket for him.","2":"Offer to cover his costs.","3":"Offer to tell him about it.","4":"Do nothing.","5":"Wait for him.","6":"R_1Ijh5l65kd1Edft"},"14":{"1":"Empathize with Ted, say, \"Man, that's terrible,\" and then... proceed to go to the concert without him anyway because, well, just because he's having a bad time doesn't mean she has to, too.","2":"Give Ted her ticket.","3":"Offer to buy Ted a new ticket.","4":"Try to sneak Ted into the concert, justifying it by saying that he DID buy a ticket; he just doesn't have it on him.","5":"Try to explain the situation to the admissions staff and see if they won't let him in.","6":"R_1OAFF5UcOWR7RaQ"},"15":{"1":"Darya could offer to give Ted her ticket.","2":"She could sell her ticket at the door and skip the concert.","3":"She could not sell her ticket, but decided the money is not as important as Ted.","4":"She could take Ted back and get his ticket and catch however much of the concert is left when they get back.","5":"She could give her ticket away to someone outside the concert.","6":"R_1Ow7wZwM1JpWcyW"},"16":{"1":"Buy another ticket.","2":"Go in any way.","3":"Wait for him.","4":"See if they can look up the ticket.","5":"Not go.","6":"R_1RZdTQtOHLNmkFj"},"17":{"1":"Check for digital ticket option.","2":"Speak to the event staff about the issue.","3":"Call someone for help.","4":"Search for a resale option.","5":"Stay with Ted or coordinate a meeting point.","6":"R_1WHyzUjIfj8D3MZ"},"18":{"1":"Go inside anyway.","2":"Make a joke.","3":"In the future, do not trust Ted to keep something for her.","4":"Tell him to go get the ticket.","5":"Give him $20 toward a new ticket.","6":"R_1WItAFIsHsFVCpu"},"19":{"1":"Check for digital access.","2":"Ask for assistance at the entrance.","3":"Split Up Temporarily.","4":"Offer to Accompany Ted.","5":"Suggest Reselling or Buying Another Ticket.","6":"R_1aNNXAPtx2JG665"},"20":{"1":"Try to buy new tickets there.","2":"Buy someone's ticket.","3":"Forget about it.","4":"Go home.","5":"Drink water.","6":"R_1dYsdWEsjj4TCRX"},"21":{"1":"She could buy a new ticket for Ted.","2":"She could ask around other friends for a spare ticket.","3":"She could escort Ted back to his house for the ticket.","4":"She could stay and wait for Ted to go back for his ticket.","5":"She could forfeit the concert altogether and go home.","6":"R_1f1SXLeK9VIXIMG"},"22":{"1":"Offer to buy him a ticket.","2":"Give the keys to Ted and risk it.","3":"Not going to the concert to be with Ted.","4":"Go to the concert anyway.","5":"Sell your ticket and skip the concert with Ted.","6":"R_1gRsz8apkxehTES"},"23":{"1":"Buy another ticket.","2":"Go home.","3":"Do something else.","4":"Leave her friend and go to the concert.","5":"Sneak in.","6":"R_1l4O85U3kAj8WYN"},"24":{"1":"Give Ted her ticket.","2":"Buy Ted a new ticket.","3":"Ask someone if they will give Ted a ticket.","4":"Leave Ted at the entrance.","5":"Sneak Ted into the concert.","6":"R_1pfptn5NHWoAITf"},"25":{"1":"Try to sneak into the concert.","2":"Get it anyway and miss most of the concert.","3":"Just go home.","4":"Try and buy another ticket.","5":"Get a refund.","6":"R_1qCR4YLk8RyiKvm"},"26":{"1":"Go to the concert.","2":"Try to get a replacement ticket.","3":"See if the ticket is on the phone.","4":"Not going to concert.","5":"Tell Ted to take an Uber and get a ticket.","6":"R_1qgUPXeZqltMSJZ"},"27":{"1":"Call to have someone deliver his ticket to him at the concert.","2":"Check online if there's any way to reprint the ticket.","3":"Have someone meet him halfway.","4":"Check with a manager at the concert.","5":"Sit outside, listen, and drink.","6":"R_1wymrvVsMdik9G8"},"28":{"1":"Call someone to bring the tickets.","2":"Wait for Ted to go back to the house.","3":"See if someone could go to the house to get the tickets.","4":"Buy new tickets.","5":"Leave the concert.","6":"R_1zMquGryvF6HgYx"},"29":{"1":"Go home.","2":"Buy a new ticket.","3":"Sneak in.","4":"Leave.","5":"Try anyway.","6":"R_28Hu4dJvo1bBtOp"},"30":{"1":"Go to the Box Office and buy a ticket.","2":"Scalp a ticket.","3":"Go back with Ted.","4":"Go to the concert without Ted.","5":"Go to another event instead.","6":"R_2LZPiBvOgQw33Ij"},"31":{"1":"Check if Ted can get a digital ticket.","2":"Call the venue for help.","3":"Buy a New Ticket.","4":"Ask for the ticket from another friend.","5":"Stay and Enjoy the Concert.","6":"R_30NK8GXqVmtrzC8"},"32":{"1":"Buy a new ticket.","2":"Go home for the ticket.","3":"Stop attending the concert.","4":"Go to the concert.","5":"Cry.","6":"R_32OrViZvtk0cfip"},"33":{"1":"Darya could go to the concert without Ted.","2":"Darya could not go to the concert and do something else with Ted.","3":"Darya could see if another ticket could be purchased at the concert.","4":"Darya could take Ted home to get his ticket and miss most of the concert.","5":"Darya could see if someone outside the concert had an extra ticket to sell.","6":"R_32zpM5ZsKLVkFEy"},"34":{"1":"Tell him to buy a new ticket.","2":"Go in anyway without him.","3":"Tell Ted to go home and get it.","4":"Not go in yourself.","5":"Take him to his house.","6":"R_346RSAXMpOOSu79"},"35":{"1":"Give him her ticket.","2":"Buy another ticket.","3":"Go back and get the ticket.","4":"Have someone from home bring it.","5":"Missed the concert.","6":"R_34iLySqiDCcwHjF"},"36":{"1":"Sell her ticket, and she and Ted do something else.","2":"Go with Ted and miss some of the concert herself.","3":"Go to the concert and see Ted inside later.","4":"Wait for Ted outside for him to return.","5":"Buy another ticket, assuming it's general admission.","6":"R_3BXe3MkPaYAHQyu"},"37":{"1":"Ask someone to bring the ticket from home.","2":"Head home to get a ticket.","3":"Forget about the concert and go to a nearby bar instead.","4":"Buy a new ticket if available.","5":"Try to smooth-talk to the person taking tickets to go in.","6":"R_3Cy3l9xy7qdsin6"},"38":{"1":"See if he can buy one.","2":"Sneak him in.","3":"Missed the concert with him.","4":"Go into the concert without him.","5":"Ask around for an extra ticket.","6":"R_3DbYYjPSDcTWv9O"},"39":{"1":"Suggest alternative options: Darya could propose other solutions to Ted, such as trying to contact the venue to see if they can retrieve the ticket or if there's a way to purchase a replacement ticket.","2":"Offer to help: She could volunteer to go to Ted's house to retrieve the ticket if it's feasible and won't cause them to miss too much of the concert.","3":"Encourage Ted to stay positive: Darya could try to reassure Ted and help him stay positive about the situation, reminding him that there might be other opportunities to see the concert or that they can still enjoy the experience together.","4":"Help Ted explore other options: She could suggest that Ted try to contact the artist or the venue through social media to see if there's a way to get a replacement ticket or gain entry.","5":"Offer to share the experience: Darya could offer to share her experience with Ted later, perhaps by sending him videos or photos or recounting the highlights of the concert.","6":"R_3EDX2biNCypIGSE"},"40":{"1":"Check to see if there is a copy of the ticket in her email.","2":"Ask to speak to a staff member about it.","3":"Purchase a new one.","4":"Go home and miss the concert.","5":"Risk running home to grab the ticket.","6":"R_3INoGfI7cOjyIEJ"},"41":{"1":"They could look for an email proving he bought a ticket.","2":"Darya could stick with Ted and decide what to do.","3":"Leave Ted and enjoy the concert with her other friends.","4":"Darya can offer to call someone to bring Ted's ticket to the venue.","5":"Buy another ticket if available.","6":"R_3KGZH9OLT6wf6Et"},"42":{"1":"Buy another one.","2":"Come back home and take.","3":"Don't come to the concert.","4":"Wait here friends outside.","5":"Go away.","6":"R_3Oqo1NreUUs9hoU"},"43":{"1":"She could get mad at her friend for doing that.","2":"She could request a refund from Ted.","3":"She could help Ted get the tickets back.","4":"She could ask Ted to get new tickets.","5":"She could offer Ted to do something else.","6":"R_3PHqwmQkOjQPc2t"},"44":{"1":"Darya could pay for Ted.","2":"Darya could loan the money to Ted.","3":"Darya could get her friends to help pay for Ted.","4":"Darya could not go to the concert and remain with Ted.","5":"Darya could walk Ted home and miss some of the concert with Ted.","6":"R_3QytAI0uiHmEnyC"},"45":{"1":"Check for Digital Options.","2":"Speak with Venue Staff.","3":"Look for Resale Options.","4":"Coordinate a Delivery.","5":"Plan to Meet After the Concert.","6":"R_3R7Ee9ri1xKBpff"},"46":{"1":"Contact the venue for solutions.","2":"Ask if the venue will allow a ticket transfer.","3":"Offer to go with Ted to his house quickly.","4":"Help Ted look for a nearby ticket outlet.","5":"Look for a ticket resale option.","6":"R_3WBTnwI8QDPKK3U"},"47":{"1":"Check for Ticket Solutions at the Venue.","2":"Offer to Go Back for the Ticket.","3":"Look for an online ticket option.","4":"See if Ted can buy a new ticket.","5":"Make the Best of the Situation.","6":"R_3WI3O9L8FKzGeo9"},"48":{"1":"See if he can get his ticket online.","2":"See if he can get his ticket from his e-mail.","3":"Go to the will-call window.","4":"Offer him advice on all of the above.","5":"Calm him down.","6":"R_3fYEYedezPYLzXj"},"49":{"1":"Might decide to give up her ticket.","2":"She might decide that they both go home.","3":"She might decide to take the lead while her friend goes for her ticket.","4":"She might try to see if they can purchase an extra ticket at the gate.","5":"She will try to see if they can get someone who will give up his ticket for a higher amount.","6":"R_3fqVV7nKwu7T06u"},"50":{"1":"Explain to the ticketing officer.","2":"Have someone drop his ticket off.","3":"Show a picture version of the ticket.","4":"Leave the concert all together.","5":"Leave Ted.","6":"R_3kNvn4Q7g7DBbw0"},"51":{"1":"Use electronic methods.","2":"Sneak in.","3":"Quickly befriend the band and get on the guest list.","4":"Leave the concert and do something else.","5":"Go back for the tickets.","6":"R_3pBhiBfoQjMZ2V3"},"52":{"1":"She could see if anyone was selling tickets outside.","2":"She could check resale sites and see if they are selling any tickets.","3":"She could give her ticket to Ted.","4":"She could drive Ted home and be late for the concert.","5":"They could all decide not to go, so Ted would not feel left out.","6":"R_3pXufk8z7qV1CKS"},"53":{"1":"Buy a ticket for him at the concert ticket window.","2":"Buy a ticket for him from a scalper.","3":"Tells Ted she'll go in alone.","4":"Both leave and miss the concert.","5":"Ted sneaks in through the fire exit.","6":"R_3plErBG0o99AMKZ"},"54":{"1":"Go get the ticket with Ted.","2":"Go into the concert without Ted.","3":"Stay outside the concert with Ted and hang out.","4":"Suggest another plan to the group besides the concert.","5":"Give Ted her ticket.","6":"R_3rZlti00mf6qgCw"},"55":{"1":"Buy another ticket.","2":"Tell Ted to go home and retrieve the ticket.","3":"Sneak Ted in.","4":"Skip the concert.","5":"Unfriend Ted.","6":"R_3yW4hPACnMklSGR"},"56":{"1":"Get someone at home to bring it.","2":"Cry.","3":"Show the receipt at the entrance.","4":"See if you have email proof of it.","5":"Freak out.","6":"R_50UT37dOI0JaB8z"},"57":{"1":"Darya could offer to buy a ticket for Ted now and have him reimburse her later.","2":"Darya could ask Ted to check his email and\/or text to see if a backup e-ticket was provided.","3":"Darya could suggest that they postpone their plans until they both can enjoy the concert together.","4":"Darya could suggest something else for them to do instead of the concert if need be.","5":"Darya could ask Ted if he has any plan Bs in mind.","6":"R_511rbeex9qAL56S"},"58":{"1":"Check if the venue offers ticket reprints or digital access.","2":"Look for a ticket resale option.","3":"Contact the event organizers for help.","4":"Suggest he stays and enjoys part of the concert.","5":"Check if Ted can get in with ID or a name on the ticket.","6":"R_52JBySUdttrVTi0"},"59":{"1":"Nothing.","2":"Go in without Ted and wait for him to return.","3":"Give Ted the car keys so he can retrieve his ticket.","4":"Ask the gatekeeper to let him in anyway.","5":"Ask if Ted would rather buy another ticket.","6":"R_56mvfURuPeCXB6r"},"60":{"1":"Reschedule the Concert.","2":"Try to Enter Without a Ticket.","3":"Use Social Media.","4":"Contact the venue.","5":"Explore Online Ticket Resale.","6":"R_5Cd0igekmrN0cG5"},"61":{"1":"Ask everyone to split the price of the ticket to buy Ted another.","2":"Try to call and have someone at his home bring him the ticket.","3":"Give Ted her ticket, and she misses the concert.","4":"Completely buy a new ticket for him herself.","5":"Suggest everyone miss the concert if he cannot go.","6":"R_5CfFrpbgdlKYh7S"},"62":{"1":"Give Ted her ticket because he is much more of a fan.","2":"Going into the concert by herself with her ticket.","3":"Ted would rush home to get the ticket, even though he might miss most of the concert.","4":"Darya would not go to the concert, and she and Ted would go to dinner instead.","5":"Ted would try to buy a ticket from a scalper outside the stadium.","6":"R_5GkopTuQFGmLEt3"},"63":{"1":"Asking him if he would like to buy another ticket.","2":"Telling him that a little is more than nothing if he would return to his house for his ticket.","3":"Telling him about this concert later.","4":"Taking another concert with him.","5":"Remind him about his mistake.","6":"R_5Ldu5Sj0J03MiIu"},"64":{"1":"Insist that he returns.","2":"Try to sneak him through.","3":"Try to find a receipt for his ticket.","4":"Bribe the guard.","5":"Make him buy a new ticket.","6":"R_5OJ7K35QMBVckzn"},"65":{"1":"Go back to get the tickets and see the last part of the concert.","2":"See the concert without Ted.","3":"Give her ticket to Ted and miss the concert herself.","4":"Drive home and have both of them miss the concert.","5":"See if there was a receipt or online proof of buying the ticket that can be used instead.","6":"R_5QAPkrHYGtvwLut"},"66":{"1":"Buy Ted a new ticket.","2":"Go back to Ted's house.","3":"Ignore Ted and go inside.","4":"See if anyone around has an extra one for free.","5":"Give Ted the car and let him go back alone.","6":"R_5QDdHosyEaRHfop"},"67":{"1":"Buy a new ticket.","2":"Find someone at home to meet him somewhere with the ticket.","3":"Find someone at home to find a despatch to deliver it.","4":"Find someone at home to take a picture of the ticket.","5":"Go home and bring the ticket.","6":"R_5UEstXgXyKAUHFT"},"68":{"1":"Could purchase Ted another ticket at the box office.","2":"Could give Ted her ticket and not go herself.","3":"Darya could see if any other friends wanted to give Ted their ticket.","4":"She could call and see if someone at home (roommate, etc.) could bring the ticket.","5":"Everyone could go home.","6":"R_5aKal4VnCBZMcxU"},"69":{"1":"Darya could buy Ted another ticket.","2":"Darya could go to Ted's house with him.","3":"Darya could laugh at Ted.","4":"Darya could ask around for an extra ticket.","5":"Darya could give Ted her ticket and go home.","6":"R_5aulyey3yG8PXoJ"},"70":{"1":"To get a new ticket.","2":"To wait for them to go together.","3":"To either go back home for the ticket.","4":"To make it some other time.","5":"To schedule another time.","6":"R_5j2menEDFbYMQOU"},"71":{"1":"Suggest ways to sneak Ted into the concert.","2":"Sneak Ted into the concert.","3":"See if Ted can prove to security he bought a ticket to get in.","4":"Try to get backstage with Ted and friends.","5":"Leave the concert with Ted to get this ticket, so he doesn't feel alone.","6":"R_5kzSBtreK87WgDQ"},"72":{"1":"E-ticket on phone.","2":"Missed some of the show.","3":"Call a friend.","4":"Rush back to get them.","5":"Uber.","6":"R_5oBfzJd8oflVt23"},"73":{"1":"Not going to the concert.","2":"Buy a scalped ticket.","3":"Go out to a bar instead.","4":"Try and sneak in.","5":"Go home.","6":"R_5qew7P77BPNRXu6"},"74":{"1":"Go to the concert anyway.","2":"Go with Ted to get the ticket.","3":"Wait for Ted to come back.","4":"Both missed the concert.","5":"Sell her ticket to someone else.","6":"R_5wF8GPKxXVbjBbJ"},"75":{"1":"Tell Ted to run back to his house.","2":"Offer to go back with Ted so he won't be alone.","3":"Check the box office to see if they have any more tickets.","4":"Try to distract the ushers so Ted can sneak in.","5":"Convince e veryone to scalp their tickets and take the money and go out that night.","6":"R_5zFrEqcd0vP8HCx"},"76":{"1":"Buy new tickets.","2":"Call someone to drive the tickets to him.","3":"Leave and not go to the concert.","4":"Show proof of purchase on his phone.","5":"Ask friends to pay for the ticket.","6":"R_66aacwer5aClvAB"},"77":{"1":"If Darya has a car and time, she could offer to go back to Ted\u2019s house to get the ticket for him. This might cause her to miss part of the concert, but it could allow Ted to enjoy the full experience.","2":"Darya could help Ted contact someone at his house (like a family member or roommate) to scan or take a picture of the ticket and send it to him digitally. Some venues accept digital tickets, so this might solve the problem quickly.","3":"Darya could check with the concert venue to see if extra tickets are available for purchase or if they can issue a replacement ticket in cases of forgetfulness. Some venues might have a \"will call\" option or be understanding of such situations.","4":"Darya could call the concert venue's customer service or box office to explain the situation and ask if there is any way Ted could still get in, like verifying his identity or issuing a new ticket under special circumstances.","5":"If none of the other options work out, Darya could encourage Ted to enjoy the concert with the group in other ways, like finding a nearby spot to watch the event (if it's an outdoor concert) or making the best of the evening together, even if Ted can\u2019t fully experience the concert.","6":"R_6IjdYRuK4t5JRDd"},"78":{"1":"Purchase a new ticket.","2":"Ask venue staff for assistance.","3":"Call Venue's Box Office.","4":"Wait with Ted or find alternative arrangements.","5":"Check for digital ticket options.","6":"R_6It9aEYe3rEhwAz"},"79":{"1":"Purchase a new ticket for Ted at the venue.","2":"Sneak Ted into the concert all the same.","3":"Try to explain to whomever is screening attendees, hopefully showing them an online copy of the ticket or purchase receipt.","4":"Forgo the concert completely and go do something else together.","5":"Go in without Ted. Sucks, but what can she do?","6":"R_6LIRgvTCPrQONe8"},"80":{"1":"Check for Digital Ticket Options.","2":"Go to the box office for assistance.","3":"Ask a friend to email or text a photo of the ticket.","4":"Split Up So Darya Can Hold Ted's Spot.","5":"Look for Last-Minute Ticket Options.","6":"R_6LXt19abpf4LtPJ"},"81":{"1":"Check for Ticket Reprints.","2":"See if extra tickets are available.","3":"Look for a Last-Minute Ticket Swap or Sale.","4":"See if Ted can meet Darya inside later.","5":"Offer to Help Ted Get Back to His House.","6":"R_6SdvCWDMX9RPjsB"},"82":{"1":"Just let Ted go by himself to get the ticket.","2":"Give Ted theirs so that they can enjoy the concert.","3":"Go with Ted to get their ticket.","4":"Try to sneak Ted in.","5":"Find something else to do as a group.","6":"R_6axcFmKIHrxFVfT"},"83":{"1":"Tell Ted sorry, but you are welcome to wait in my car.","2":"You can try and buy a black-market ticket, Ted.","3":"I see a Denny's; you can wait for us there.","4":"I can call you an Uber to pick up the ticket if someone is at your house.","5":"I can call you an Uber to take you home.","6":"R_6azDKUzNwPbXPA6"},"84":{"1":"Go back to the house.","2":"Continue without him.","3":"Try to get a scalped ticket.","4":"Leave the concert.","5":"Buy another ticket.","6":"R_6jKUYnaHYdMREbf"},"85":{"1":"Give Ted her ticket and go home.","2":"Offer another concert-goer money for their ticket.","3":"Both she and Ted don't attend the concert.","4":"See if Ted has family that has a key to his house and could drive it halfway to meet him.","5":"Check the box office and see if there are any more tickets for sale.","6":"R_6jeQDjP0f1ICJuw"},"86":{"1":"Offer to buy his entrance at the gate.","2":"Give him her ticket.","3":"Drive him home to get his ticket.","4":"Try to ask if anyone is selling a ticket.","5":"Leave the concert with him.","6":"R_6jqYLUMt97mQsda"},"87":{"1":"Buy another ticket for him.","2":"Sneak him in somehow.","3":"Call and have a friend grab his ticket and bring it over.","4":"Give her ticket to him and go back to get his ticket.","5":"Let him go get his ticket and enjoy the concert alone.","6":"R_6lMIWdZPvWj8YT6"},"88":{"1":"Darya could give Ted her ticket and forgo the concert.","2":"Darya could go to the concert without Ted.","3":"Darya could ask anyone else at the concert if they want to forgo their tickets.","4":"Darya could see if she could purchase a ticket for Ted.","5":"Darya can race to the house with Ted to get the ticket and then race back.","6":"R_6n0gaBJlObJZNJL"},"89":{"1":"Loan Ted the money for a new ticket.","2":"Let off the other friends at the concert and take Ted back home.","3":"Call and have someone bring Ted's ticket to him.","4":"Miss the concert and stay with Ted.","5":"Go to dinner with Ted instead of the concert.","6":"R_6rDIPY1kPprneQi"},"90":{"1":"Beg the security guards.","2":"Buy a new ticket.","3":"Return home.","4":"Percha friend.","5":"Be around for a while maybe later they will allow him to enter.","6":"R_6rmuKX05vLAvOBH"},"91":{"1":"Offer to buy her friend another ticket.","2":"Call and see if someone can meet Tad there with his ticket.","3":"Drive back and miss part of the concert.","4":"Apologize but say there\u2019s nothing she can do.","5":"Call the venue and see if they have a record of the ticket.","6":"R_6zBHPyYPpZHrSA9"},"92":{"1":"Call Ted's house and see if someone can bring the ticket.","2":"Go to the concert without him.","3":"Buy another ticket.","4":"Miss most of the concert and go with him to get the ticket.","5":"Wait for him to go get it.","6":"R_7CAF93nL8ofFDbz"},"93":{"1":"Ask the venue for assistance.","2":"Offer to wait with Ted.","3":"Enjoy the concert and update Ted later.","4":"Contact the ticket vendor.","5":"Check for online ticket transfer.","6":"R_7FQCwzL61mqIGfl"},"94":{"1":"Go to the concert and let Ted go home and get his ticket.","2":"They all go with Ted to get his ticket.","3":"They could all skip the concert.","4":"Ted could just go home and forget it.","5":"Maybe Ted could have someone bring his ticket to save time.","6":"R_7HGk7UW6XVk8PmB"},"95":{"1":"Go with Ted to get his ticket.","2":"Buy another ticket if available.","3":"Not go at all.","4":"Go to the concert without Ted.","5":"Wait outside until Ted comes back.","6":"R_7LbbH6CJBhzkj6m"},"96":{"1":"If tickets are not sold out, Darya could lend Ted some money to buy another, and he can pay her back later.","2":"Darya and Ted could choose to skip the concert and go do something else together.","3":"Darya could choose to be a bad friend and attend the concert anyway while Ted goes home.","4":"Darya could help Ted sneak into the concert without paying.","5":"Darya could give Ted her ticket and go home alone.","6":"R_7RvzucUpWomndJz"},"97":{"1":"Go to a scalper and buy a ticket.","2":"Wait in the car and listen.","3":"Sneak in.","4":"Try to buy a ticket at the gate.","5":"Wait at the gate.","6":"R_7V04Jixznx3woZr"},"98":{"1":"Call someone to get the ticket and bring it to them.","2":"See if they can look up the ticket at the box office.","3":"Take him home to get the ticket.","4":"See if he has a receipt.","5":"See if he has an email with ticket information on it.","6":"R_7YyvPXVx5tsAixx"},"99":{"1":"Try to buy another ticket at the venue.","2":"Ask Ted if he wants to drive home and get the ticket.","3":"Ask if the ticket is on Ted's phone.","4":"Go to the concert and meet Ted later.","5":"Ask venue if they have a way to check Ted's name for the concert.","6":"R_7aJJRH6OUfnV4Sq"},"100":{"1":"Offer to go with him.","2":"Buy another ticket.","3":"Say if you hurry, you can make it.","4":"See if there is anything the venue can do.","5":"Skip the concert.","6":"R_7h4LcjPDpIK7LRo"},"101":{"1":"Nothing.","2":"Sell Ted her ticket.","3":"See if there are other tickets for sale.","4":"Offer to take Ted home to get his ticket.","5":"Sell her ticket and go to a movie with Ted.","6":"R_7k7O4QRMI4S4I0x"},"102":{"1":"Contact the venue.","2":"Retrieve the ticket.","3":"Explore ticket resale options.","4":"Suggest an alternative plan.","5":"Offer emotional support.","6":"R_7lXk6NMhMvuo8pE"},"103":{"1":"Could give Ted their tickets.","2":"Exclaim how shitty it is that Ted forgot his ticket and go to the show anyway.","3":"See if there is any way to help Ted find a digital version of his ticket.","4":"Could go with Ted to get his ticket.","5":"Skip the concert and go somewhere else with Ted.","6":"R_7n6ZmcyeOYNoo2Z"},"104":{"1":"Forgo the concert with Ted.","2":"Go with Ted to get his ticket and return to the concert.","3":"Call and ask someone to bring Ted his ticket.","4":"Try to buy a new ticket at the venue.","5":"Go to the concert alone.","6":"R_7pflm8v9g0RcukR"},"105":{"1":"Supportive.","2":"Buy a new ticket.","3":"Show her purchase.","4":"Go back home.","5":"Forget about the concert.","6":"R_7s61YpSgjK9tTKs"},"106":{"1":"Goes to the concert.","2":"Skip the concert.","3":"Goes back for ticket.","4":"Buys ticket at door.","5":"Pulls up ticket online.","6":"R_7tG7BMrK68GaXQZ"}},"Randomization":"Subset","TotalRandSubset":1}}},"64":{"Type":"Standard","SubType":"","Description":"Scenario2","ID":"BL_ezYLb3879A4Ep7w","BlockElements":[{"Type":"Question","QuestionID":"QID798"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1014"},{"Type":"Question","QuestionID":"QID799"},{"Type":"Question","QuestionID":"QID800"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID992"},{"Type":"Question","QuestionID":"QID807"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID801"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID802"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID803"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID804"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID805"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID806"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1032"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1003"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID949"},{"Type":"Question","QuestionID":"QID950"},{"Type":"Question","QuestionID":"QID951"},{"Type":"Question","QuestionID":"QID952"},{"Type":"Question","QuestionID":"QID953"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Call a cab.","2":"Call an Uber.","3":"Try to book a later flight.","4":"Cancel his trip.","5":"Hitchhike to the airport.","6":"R_110rMptMSqCu4MO"},"2":{"1":"Call for help.","2":"Change the flight time.","3":"Look into the problem.","4":"Look for alternatives.","5":"Postpone.","6":"R_11u8lFJDCIDjOHx"},"3":{"1":"Call AAA for a tow.","2":"Call the airline & reschedule the flight.","3":"Call a friend who could take him to the airport to make the flight.","4":"Just sit there and fume at the potential outcome of missing flight.","5":"Do nothing to see if the police will come.","6":"R_15XSR3ecjZ7ATur"},"4":{"1":"Flag down another driver to help get his car started.","2":"Stop another driver and offer to pay them to take him to the airport.","3":"Call a share ride.","4":"Missed the flight altogether.","5":"Call the airline to see if he can get on a later flight.","6":"R_17vAnhd7IcM0K3v"},"5":{"1":"Call a mechanic to come and service the car.","2":"Call for the car to be towed.","3":"Book an Uber.","4":"Relax and not panic.","5":"Proceed to the airport.","6":"R_1E6tiqTD3Brh0E2"},"6":{"1":"Hitchhike.","2":"Wait for a taxi.","3":"Call a friend.","4":"Walk.","5":"Missed his flight.","6":"R_1Ijh5l65kd1Edft"},"7":{"1":"Try and call a taxi.","2":"Call a friend.","3":"Stop a car.","4":"Call the airline.","5":"Call a tow truck.","6":"R_1OI30P0hw3o2XBv"},"8":{"1":"Call a friend to come get him and take him to the airport.","2":"Call a tow truck to take his car back to his house.","3":"Take an Uber to the airport after calling a tow truck.","4":"Take the bus to the airport after having the car towed.","5":"Try to get on a later flight and get the car towed.","6":"R_1Ow7wZwM1JpWcyW"},"9":{"1":"Call an Uber.","2":"Call a taxi.","3":"Call a tow truck.","4":"Walk.","5":"Call a friend.","6":"R_1RZdTQtOHLNmkFj"},"10":{"1":"Call AAA.","2":"Have the car towed to a garage.","3":"Explain the situation to the garage.","4":"Make payment arrangements.","5":"Call an Uber to get to the airport.","6":"R_1VBGtWflhw8qKXv"},"11":{"1":"Call a tow truck.","2":"Call for an Uber.","3":"Call a friend for help.","4":"Call a relative for help.","5":"Call the airline.","6":"R_1WCnLLbNlkN5Xz3"},"12":{"1":"Order an Uber or Lyft.","2":"Call a nearby friend or family member.","3":"Call roadside assistance.","4":"Hitchhike.","5":"Call emergency services.","6":"R_1dMHTTPBS7ebelo"},"13":{"1":"Watch YouTube.","2":"Go on TikTok.","3":"Watch TV.","4":"Take a walk.","5":"Take a nap.","6":"R_1gYkTgONa1P7tlf"},"14":{"1":"Call a friend to pick him up and handle getting his car towed.","2":"Cancel the trip.","3":"Call the airline to see if he can catch a later flight.","4":"Try and wait for the tow truck.","5":"Leave his car and call an Uber.","6":"R_1iBZgffUBpQdqlZ"},"15":{"1":"Call another friend.","2":"Walk.","3":"Call Uber.","4":"Be mad and wait for help.","5":"Ask a friend to push the car.","6":"R_1l4O85U3kAj8WYN"},"16":{"1":"Call an Uber.","2":"Wave someone down for a ride.","3":"Carjack someone.","4":"Call AAA.","5":"Call a taxi.","6":"R_1mEqeunjS9ZfMcu"},"17":{"1":"Call a tow truck or roadside assistance for help with the car.","2":"Call a taxi, rideshare, or car rental service to continue the journey to the airport.","3":"Use his phone to check the traffic situation or find alternative routes to the airport.","4":"Contact the airline to inform them about the delay and inquire about rebooking options.","5":"Ask nearby drivers or pedestrians for help, such as offering a ride or suggesting nearby transportation options.","6":"R_1meCQpmm7l4RkEk"},"18":{"1":"Call for roadside assistance.","2":"Hitch a ride to the airport.","3":"Walk to the airport.","4":"Wait for someone to stop and help.","5":"Skip his flight and call for repairs.","6":"R_1o7rmk66EqCjQ9b"},"19":{"1":"Call a taxi.","2":"Walk.","3":"Call the airport.","4":"Call friends.","5":"Run.","6":"R_28Hu4dJvo1bBtOp"},"20":{"1":"Call an Uber.","2":"Ask for help from a passerby.","3":"Call a friend to pick him up.","4":"Reschedule the flight.","5":"Lose the flight and not travel again.","6":"R_2JL3TNOcc14UDXz"},"21":{"1":"Call a roadside assistance.","2":"Order a Ride.","3":"Request a Taxi.","4":"Notify the airline.","5":"Fix the car temporarily.","6":"R_2eM4lcuYu5tfunU"},"22":{"1":"Call a Tow Service.","2":"Request a Ride from a Friend or Family Member.","3":"Use a Ride-Sharing Service.","4":"Call the airline for help.","5":"Look for Alternative Transportation.","6":"R_30NK8GXqVmtrzC8"},"23":{"1":"Call a tow truck and call an Uber.","2":"Get a later flight.","3":"Call a friend for help.","4":"Give up.","5":"Walk.","6":"R_30pn2AznvKMe182"},"24":{"1":"Get a taxi.","2":"Find an auto mechanic.","3":"Walk to catch his flight.","4":"Also fix it himself if he only can.","5":"Restart the car to identify the trouble.","6":"R_316ZRMJghIPfHCG"},"25":{"1":"He could call a tow truck.","2":"He could call an Uber.","3":"He could call a friend.","4":"He could call the airport to try for another flight.","5":"He could give up the trip altogether.","6":"R_325oPaz7SElRR4t"},"26":{"1":"Get out of the car and walk for help.","2":"Call Uber\/Lyft.","3":"Call roadside.","4":"Call a friend.","5":"Try to fix the car himself.","6":"R_32JhhdK2roDb2ks"},"27":{"1":"Get a ride.","2":"Get on a motorcycle.","3":"Postponed the trip.","4":"Get someone to fix the car.","5":"Go home.","6":"R_32OrViZvtk0cfip"},"28":{"1":"Abandon his car and call a taxi.","2":"Call a friend to pick up his car.","3":"Wait for roadside assistance to tow him.","4":"Get out and try to catch a ride with a stranger.","5":"Walk to the airport.","6":"R_34t6UZ15RZT05ZD"},"29":{"1":"Wait until help arrives.","2":"Call a friend to take care of his car and get an Uber.","3":"Take another flight and delay the trip.","4":"Leave the car and get an Uber ride.","5":"Cancel the event.","6":"R_39AOh67MgzH9Ec1"},"30":{"1":"Call home to bring another car.","2":"Call a friend.","3":"Search Google Maps for a public metro nearby.","4":"Book a ride.","5":"Call a mechanic.","6":"R_3AYfE1sOrSAcGk1"},"31":{"1":"Get it towed and call a ride-share.","2":"Leave it and just go.","3":"Call a buddy to come deal with the tow.","4":"Push it to the side of the road.","5":"Involve the police and hope they help.","6":"R_3BXe3MkPaYAHQyu"},"32":{"1":"Request for a ride.","2":"Ask people for help.","3":"Notify the airline.","4":"Call a friend or family.","5":"Call for roadside assistance.","6":"R_3CArglpnLjmloHL"},"33":{"1":"Call for roadside assistance.","2":"Josh should inform his airline about the situation and inquire about potential flight rebooking option.","3":"Use public transportation.","4":"Josh could ask other drivers passing by for assistance, such as a ride to the nearest public transportation station or a phone to call for help.","5":"If roadside assistance is not an immediate option, Josh can use a ride-sharing app like Uber or Lyft to request a ride to the airport.","6":"R_3EDX2biNCypIGSE"},"34":{"1":"Fix the car.","2":"Call a friend for a ride.","3":"Catch another flight.","4":"Get an Uber.","5":"Ask a stranger for help.","6":"R_3Ffkd8rLgczTTnw"},"35":{"1":"Try to set up a different flight.","2":"Take care of his car.","3":"Call a friend to take him to the airport and deal with his car.","4":"Leave the car and call a taxi.","5":"Call a road service and hope for the best.","6":"R_3GpL7t91IX7KJyU"},"36":{"1":"Nothing.","2":"Wait.","3":"Watch movies.","4":"Take a rest.","5":"Get some coffee.","6":"R_3IPID3OvJ1BNufp"},"37":{"1":"Call a tow truck to bring the car somewhere until he gets back.","2":"Call a cab to get to the airport.","3":"Hitchhike to get to the airport.","4":"Cancel his plans.","5":"Call a friend to help.","6":"R_3NfHYUYzWPJFF3b"},"38":{"1":"Call an Uber and go to the airport.","2":"Call roadside assistance like AAA. They might give him a ride.","3":"Get on a public bus to the airport.","4":"Call a friend to give him a ride.","5":"Give up on hunting safaris and leave the poor animals alone.","6":"R_3O2hk47yenGP9W5"},"39":{"1":"Take a taxi.","2":"Call an Uber.","3":"Call a Lyft.","4":"Take a bus.","5":"Call a friend.","6":"R_3Oqo1NreUUs9hoU"},"40":{"1":"Call a friend for a ride.","2":"Call a taxi.","3":"Reschedule flight.","4":"Missed flight.","5":"Reschedule trip.","6":"R_3QytAI0uiHmEny