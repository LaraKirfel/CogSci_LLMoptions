are any delays on the flight.","6":"R_7whRUS1A3tz0DzI"},"109":{"1":"Call Uber\/taxi.","2":"Hitchhike.","3":"Cancel ticket.","4":"Try to quickly repair the vehicle.","5":"Ask nearby friends\/family for a ride.","6":"R_7y4gmVfTEK1zk6l"}},"Randomization":"Subset","TotalRandSubset":1}}},"65":{"Type":"Standard","SubType":"","Description":"Scenario4","ID":"BL_3k5uDKWYt2jSYt0","BlockElements":[{"Type":"Question","QuestionID":"QID808"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1016"},{"Type":"Question","QuestionID":"QID809"},{"Type":"Question","QuestionID":"QID810"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID994"},{"Type":"Question","QuestionID":"QID817"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID811"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID812"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID813"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID814"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID815"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID816"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1034"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1005"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID959"},{"Type":"Question","QuestionID":"QID960"},{"Type":"Question","QuestionID":"QID961"},{"Type":"Question","QuestionID":"QID962"},{"Type":"Question","QuestionID":"QID963"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Take down the plate number and call the police.","2":"Ignore the situation and continue driving to the destination.","3":"Attempt to get the driver's attention and get them to stop.","4":"Pass the driver and do not inform anyone.","5":"Honk the horn at the driver and hope they become more aware.","6":"R_106wNj20KZ6xB0O"},"2":{"1":"Call the cops.","2":"Keep his distance.","3":"Choose to take a different route home.","4":"Follow the drunk driver while talking to the cops.","5":"Pull over somewhere until the drunk driver is away from you.","6":"R_10wtlGJBiUnExNp"},"3":{"1":"Eamon should keep a safe distance from the car.","2":"Eamon should try to get the plate number.","3":"Eamon should call 911 and report the vehicle.","4":"Eamon should flick his lights to warn oncoming drivers.","5":"Eamon should try to follow the car to let officers know the location.","6":"R_18CfvWR8YoIBQbC"},"4":{"1":"Call the police.","2":"Pull over and wait for the car to drive away.","3":"Speed up to get in front of the driver.","4":"Honk at the driver.","5":"Pull up next to the driver to try to talk to him.","6":"R_190GFKTFeGPDRx7"},"5":{"1":"Alert the police to a possible accident.","2":"Honk to draw the attention of the driver ahead and passersby.","3":"Fasten his seatbelt.","4":"Try to save the driver.","5":"Do not overtake the driver.","6":"R_1E6tiqTD3Brh0E2"},"6":{"1":"Maintain a safe distance.","2":"Call the authorities.","3":"Avoid passing the vehicle.","4":"Follow cautiously.","5":"Find a safe exit.","6":"R_1EVTptN2zfoV1jP"},"7":{"1":"Flash lights to driver.","2":"Blow horn.","3":"Signal the driver to pull over.","4":"Contact police.","5":"Speed Up to Avoid Driver.","6":"R_1JlXAFjunLfNJ1T"},"8":{"1":"Continue to stay behind the person.","2":"Wait for an opportunity and pass the person.","3":"Get off at the next exit and take a different route.","4":"Honk your horn at them.","5":"Flash your bright lights at them and hope they move over.","6":"R_1LwBEfudDZdSksl"},"9":{"1":"Call the police and report the vehicle for erratic driving.","2":"Pull off the road so that you are not following the vehicle.","3":"Safely pass the car if possible.","4":"Use emergency flashers while driving behind a car to alert those coming behind that there is an issue.","5":"Follow carefully.","6":"R_1NCTivNHn2R2xwd"},"10":{"1":"Just keep driving normally and hope nothing bad happens.","2":"Phone in a report of a possibly intoxicated driver on the road.","3":"Try to get off the road as soon as you can and find a different route home.","4":"Pull over to the side of the road and give the other driver time to move away from you.","5":"Try to find an opening to pull ahead of the drunk driver and then speed away from him.","6":"R_1OAFF5UcOWR7RaQ"},"11":{"1":"Keep a safe distance.","2":"Call the police.","3":"Change his lane.","4":"Put on hazard lights.","5":"Drive at a safe speed.","6":"R_1OUptQGvK0r1RIk"},"12":{"1":"Call 911.","2":"Slow down.","3":"Honk horn.","4":"Pull over.","5":"Do nothing.","6":"R_1UlRtlMFtVvMV6F"},"13":{"1":"Give the driver plenty of space.","2":"Call law enforcement.","3":"Honk, blink headlights to warn other drivers.","4":"Pull over.","5":"Get off the road.","6":"R_1VBGtWflhw8qKXv"},"14":{"1":"Call 911.","2":"Stay as far back as possible from the other car.","3":"Honk at the other car.","4":"Put hazards on to warn other drivers.","5":"Flash car lights.","6":"R_1Yac7Yn0QVqPDrO"},"15":{"1":"Call the cops.","2":"Call the non-emergency line.","3":"Drive safely around.","4":"Honk and try to get the driver to pull over.","5":"Ignore it.","6":"R_1k1jQWohFaRHghn"},"16":{"1":"Slow down and let the driver get farther ahead.","2":"Stop for a few minutes to allow the driver to get ahead.","3":"Call the police and alert them to the intoxicated driver.","4":"Speed up and attempt to pass the driver.","5":"Continue driving and monitor the driver ahead.","6":"R_1ow0wDgAr4zG6va"},"17":{"1":"Call the police.","2":"Honk his horn at the driver.","3":"Take the driver out by crashing into their rear end.","4":"Get in front of the driver and hit the brakes.","5":"Do nothing and go home.","6":"R_1pfptn5NHWoAITf"},"18":{"1":"Call 911.","2":"Hit the car.","3":"Do nothing.","4":"Follow the car.","5":"Go around the car.","6":"R_1qeXmTebFIxcmuU"},"19":{"1":"Call 911.","2":"Stay clear of that car.","3":"Honk horn.","4":"Pull over.","5":"Slow down.","6":"R_1qgUPXeZqltMSJZ"},"20":{"1":"Get off the road.","2":"Call 911.","3":"Stay far behind the driver.","4":"High beam them.","5":"Call someone.","6":"R_1zMquGryvF6HgYx"},"21":{"1":"Call 911.","2":"Protect himself.","3":"Stop his own car.","4":"Drive in the other lane.","5":"Ignore the incident.","6":"R_2JL3TNOcc14UDXz"},"22":{"1":"Slow down, maintain a large distance behind the driver, and monitor the situation.","2":"Call 911 to explain what he's seeing.","3":"Attempt to pass the driver.","4":"Take a different route.","5":"Pretend nothing is wrong.","6":"R_30MXRF4OYEAUjyM"},"23":{"1":"Call 9-1-1.","2":"Ignore it.","3":"Honk at the Car.","4":"Call nonemergency authorities.","5":"Flashlights.","6":"R_32FVc0CkQRYbsOl"},"24":{"1":"Eamon does nothing.","2":"Eamon keeps going.","3":"Eamon calls for help.","4":"Eamon follows.","5":"Eamon, make sure he gets home safely.","6":"R_32JhhdK2roDb2ks"},"25":{"1":"Call the police.","2":"Try and stop the driver.","3":"Follow the driver.","4":"Blow the horn.","5":"Yell out the window.","6":"R_32mp9ZvRhgXm8nv"},"26":{"1":"He could call the police if he had a cell phone with him.","2":"He could pull over and let the driver get farther ahead of him.","3":"He could turn off the road onto another road and take an alternative route.","4":"He could honk the horn to possibly get the driver's attention to get him to pull over.","5":"He could do nothing.","6":"R_32zpM5ZsKLVkFEy"},"27":{"1":"Call 911.","2":"Slow down.","3":"Honk the horn at the driver.","4":"Speed up and pass.","5":"Flash their lights.","6":"R_34iLySqiDCcwHjF"},"28":{"1":"Pull over and wait for the driver to get far away.","2":"Honk the horn.","3":"Pull over and call for the police.","4":"Attempt to drive around him.","5":"Continue to drive behind the driver.","6":"R_34t6UZ15RZT05ZD"},"29":{"1":"Change lanes.","2":"Call the authorities.","3":"Maintain distance.","4":"Avoid confrontation.","5":"Stay alert.","6":"R_3CArglpnLjmloHL"},"30":{"1":"Call the police.","2":"Honk to get them to stop.","3":"Run them off the road.","4":"Keep driving.","5":"Pass the driver.","6":"R_3E3U2xelzLSlypm"},"31":{"1":"Stay behind at a distance.","2":"Call the police.","3":"Go around.","4":"Take another route.","5":"Catch up and help the person.","6":"R_3Ffkd8rLgczTTnw"},"32":{"1":"Call the police.","2":"Honk to alert the other driver.","3":"Flash the high beams several times to alert the other driver.","4":"Turn on the four blinkers to alert others.","5":"Drive away.","6":"R_3FkZNCdE8A7qb9n"},"33":{"1":"Change lanes.","2":"Stay very alert.","3":"Avoid any form of confrontation.","4":"Follow at a distance.","5":"Call the police.","6":"R_3GN9uIXPDKwy275"},"34":{"1":"Slow the car.","2":"Put on double indicator.","3":"Actively examine his driving.","4":"Blow the horn.","5":"Do not ignore.","6":"R_3IPID3OvJ1BNufp"},"35":{"1":"Back off.","2":"Call 911 and advise them of the situation.","3":"Honk the horn to alert the other driver.","4":"If unable to pass, do U-turn and find another way home safely.","5":"Attempt to pass when driver returns to correct lane after honking.","6":"R_3KNtlm03Afkz9l4"},"36":{"1":"Follow him.","2":"Call the police.","3":"Make him pull over.","4":"Get tag number.","5":"Just go around him.","6":"R_3NEbUVhjZ9VuIPM"},"37":{"1":"Honk loudly.","2":"Call the police.","3":"Try to pass him and go about his own life.","4":"Drive slowly to an intersection and take a different route.","5":"Flash his high beam.","6":"R_3O2hk47yenGP9W5"},"38":{"1":"Call the police.","2":"Put distance between self and potentially intoxicated driver.","3":"Do nothing.","4":"Take an alternative route.","5":"Leave the roadway, then call 911.","6":"R_3OZyTC9XvC0OPiw"},"39":{"1":"Call 911.","2":"Overtake the car.","3":"Alert other drivers.","4":"Try talking to the driver to slow down.","5":"Driving far away from the car.","6":"R_3PaSiWIW3QpsbwG"},"40":{"1":"He could call the police.","2":"He could stop and wait for that driver to clear.","3":"He could take a different road.","4":"He could pass the other driver.","5":"He could slow down.","6":"R_3ReVhaxfBloav88"},"41":{"1":"Avoid Overtaking in an Unsafe Way.","2":"Alert Authorities.","3":"Stay Calm and Observant.","4":"Pull Over and Wait.","5":"Maintain a Safe Distance.","6":"R_3WI3O9L8FKzGeo9"},"42":{"1":"Pull over and contact law enforcement.","2":"Keep a safe distance from the vehicle ahead.","3":"Avoid engaging with this vehicle.","4":"Turn on hazard lights to possibly alert the driver ahead.","5":"Avoid trying to pass or go around the vehicle ahead.","6":"R_3agAyEXqHxnMecc"},"43":{"1":"He might honk at him several times.","2":"He will decide to get out of his car to help him.","3":"He will call to come and help.","4":"He might be angry at the driver.","5":"Probably call the cops.","6":"R_3fqVV7nKwu7T06u"},"44":{"1":"Call the cops.","2":"Slow down.","3":"Slow lane.","4":"Honk.","5":"Exit.","6":"R_3hzhNe5kZRkNRve"},"45":{"1":"Stop until the car passes.","2":"Drive slowly and carefully.","3":"Attempt to stop the car.","4":"Notify the police.","5":"Accelerate until he passes the car.","6":"R_3iL1UtysTZKhStX"},"46":{"1":"Call 911 and report the driver.","2":"Try to honk to get their attention.","3":"Follow them to make sure they don't cause an accident and leave.","4":"Try to pass them and honk at them.","5":"Just leave them alone.","6":"R_3ifobTM0IGVNiPD"},"47":{"1":"Slow down.","2":"Move to another lane.","3":"Call 911.","4":"Honk the horn.","5":"Find another road.","6":"R_3kNvn4Q7g7DBbw0"},"48":{"1":"Keep a safe distance and avoid trying to pass the car.","2":"Note the car\u2019s license plate, make, and model.","3":"Call the police to report the driver and provide details.","4":"Flash his lights or honk briefly to try to alert the driver to their erratic behavior.","5":"Pull over to a safe spot to call for help if he feels unsafe continuing near the car.","6":"R_3oL1VXC3odM9ry0"},"49":{"1":"He could use a different path to home.","2":"Call the police.","3":"Report to necessary authorities.","4":"He can honk at the driver to alert him.","5":"He can try to overtake him if it's safe.","6":"R_3oXW4v4k4JrjH1L"},"50":{"1":"Call 911 or the police and report the driver.","2":"Continue following the driver in case he crashes.","3":"Do nothing and continue on your way.","4":"Pull in front of the driver and slow down in hopes they'll stop.","5":"Flag down a police officer if nearby to ask for help.","6":"R_3pX5TXj5EJ2NFWo"},"51":{"1":"Pull off to the side of the road.","2":"Keep driving, although it would be very unsafe.","3":"Call the police.","4":"Honk his horn.","5":"Flash his lights.","6":"R_3pXufk8z7qV1CKS"},"52":{"1":"Eamon should report this to the police.","2":"Eamon should slow down.","3":"Eamon should cross the driver ahead with caution.","4":"Eamon should have taken another road.","5":"Eamon should have stopped the car and waited for some time.","6":"R_3wCWQztEFMuESAx"},"53":{"1":"Keep a safe distance from the car, and avoid getting too close.","2":"Try to safely pass the car if there's a clear opportunity to do so.","3":"Call 911 to report the suspected intoxicated driver.","4":"Keep an eye on the car\u2019s movements and provide the dispatcher with details, like location and license plate number.","5":"Stay calm and avoid confronting the driver directly, as it could escalate the situation.","6":"R_3yeGLkSRIO8FnVq"},"54":{"1":"Call 911.","2":"Pass the car.","3":"Pull over and stop.","4":"Drive straight to the police station.","5":"Pull up and honk.","6":"R_5074epk0KmokfdJ"},"55":{"1":"Slow down to put more space between the vehicles.","2":"Pull over to the shoulder for a bit.","3":"After pulling over, call the police to report the driver.","4":"Take a different route home (turn off this road).","5":"Accelerate to pass the vehicle (bad idea!).","6":"R_53V45FDrHSBpukV"},"56":{"1":"Stay back.","2":"Call the non-emergency police line.","3":"Call the emergency line.","4":"Record the other driver for the police.","5":"Try to get the driver to pull over.","6":"R_57Qn25xpVJM8QUN"},"57":{"1":"Keep a long distance from this car.","2":"Wait patiently until it's safe to pass over.","3":"Call police if the drive seems to cause accident.","4":"Pass over when safe.","5":"Avoid aggressive behavior.","6":"R_5G9pPAWQ0rKuL5f"},"58":{"1":"Eamon could call the police.","2":"Eamon could slowly follow while calling the police.","3":"Eamon could get the license plate number.","4":"Eamon could pull over and let them drive away.","5":"Eamon could ignore them and just continue on his way.","6":"R_5HOqqLtIEk6a2ZP"},"59":{"1":"Call the police.","2":"Try to get the driver to pull over.","3":"Block the road.","4":"Nothing.","5":"Honk the horn.","6":"R_5KH46MDo4bO40de"},"60":{"1":"Go around.","2":"Call the police.","3":"Mind his own business.","4":"Honk.","5":"Find alternate route.","6":"R_5MSXi1UQzBU8zv3"},"61":{"1":"Call the police.","2":"Honk the horn.","3":"Stay away from him.","4":"Turn down another road.","5":"Flash his high beams.","6":"R_5MusV3psiAY3z1v"},"62":{"1":"Call 911.","2":"Ignore.","3":"Try and help.","4":"Honk.","5":"Throw highlights.","6":"R_5My5OV3JHKAZCrk"},"63":{"1":"Call 911.","2":"Fishtail the driver.","3":"Drive around and block the road.","4":"Drive alongside of him and yell.","5":"Honk his horn.","6":"R_5PvF1S60eajf04m"},"64":{"1":"Stay behind the driver, but far enough back.","2":"Pass the driver.","3":"Call the police and report the license plate.","4":"Take a new route.","5":"Honk at the person.","6":"R_5QAPkrHYGtvwLut"},"65":{"1":"Not move so close.","2":"Make sure he's concentrating.","3":"Drive slowly.","4":"Not try to overtake.","5":"And don't frighten the intoxicated driver.","6":"R_5Vy8E2IsOpaOyS2"},"66":{"1":"To be careful.","2":"To drive well.","3":"To avoid reckless driving.","4":"To be focused.","5":"To draw attention to police officers.","6":"R_5j2menEDFbYMQOU"},"67":{"1":"Stay calm and avoid provoking the driver.","2":"Call 911 or local authorities.","3":"Avoid Overtaking Until Safe.","4":"Maintain a Safe Distance.","5":"Look for a Safe Place to Pull Over (If Needed).","6":"R_5qIbmcmlSBbB56x"},"68":{"1":"Pull over.","2":"Try to get ahead of the car.","3":"Call the police and inform them.","4":"Slow down.","5":"Honk the horn and see if it helps.","6":"R_5tmA0q620A1GGus"},"69":{"1":"Create Distance.","2":"Observe and Gather Information.","3":"Pull Over and Report.","4":"Avoid Passing.","5":"Continue with Caution.","6":"R_5uS62q5PwR000YF"},"70":{"1":"Maintain a safe distance.","2":"Stay alert.","3":"Call emergency services.","4":"Avoid overtaking unless it's safe.","5":"Pull over safely if needed.","6":"R_5xz0PrPzqNyIgb7"},"71":{"1":"Be patient.","2":"Drive carefully.","3":"Be in his lane.","4":"Report to the police.","5":"Break.","6":"R_64Mlypf2TgMbmz6"},"72":{"1":"Pull over to the side of the road.","2":"Write down the license plate number.","3":"Call the police.","4":"Keep driving.","5":"Find an alternative route.","6":"R_6B3bcSl08N0mNBZ"},"73":{"1":"Call 911.","2":"Follow the person.","3":"Try to get their attention to pull them over and check on them.","4":"Honk at them.","5":"Pull over and wait until they are out of sight, then continue on their way.","6":"R_6Cgew2l9Qmnsmkz"},"74":{"1":"Eamon could call the police.","2":"Eamon could follow the driver.","3":"Eamon could ignore the driver.","4":"Eamon could pass him up and try to stop him.","5":"Eamon could blink his lights to make the driver aware.","6":"R_6IAeyh3yCz7vUGM"},"75":{"1":"Pull over.","2":"Call the police.","3":"Attempt to notify other drivers on the road.","4":"Speed ahead and get away from the car.","5":"Mind his own business.","6":"R_6L4wNwTzxkkeJnX"},"76":{"1":"Keep a Safe Distance.","2":"Avoid Passing the Vehicle.","3":"Call the authorities.","4":"Use Hazard Lights.","5":"Stay Calm and Observant.","6":"R_6LXt19abpf4LtPJ"},"77":{"1":"Pull over.","2":"Call 911 for help.","3":"Hang back and stay out of his way.","4":"Speed ahead and get off the highway\/street.","5":"Tail him while calling the police so he can give the location.","6":"R_6SRtp44g5ttufV7"},"78":{"1":"Maintain a Safe Distance.","2":"Stay Alert.","3":"Avoid Passing Unnecessarily.","4":"Call 911.","5":"Pull over and wait for law enforcement.","6":"R_6SdvCWDMX9RPjsB"},"79":{"1":"Speed past.","2":"Stay way behind.","3":"Call the police.","4":"Pull over and wait.","5":"Get next to the car and flash lights to pull the driver over.","6":"R_6YZk5zD6aHykU8x"},"80":{"1":"Try to pass around them when it's safe to do so.","2":"Give the car in front more space in case anything goes wrong.","3":"Drive a different route as soon as you can to avoid being near that driver.","4":"Call the police and report the vehicle.","5":"Get near them and accidentally \"have them hit you so that you can get paid, they're drunk so it'll most likely be their fault if you play it right.","6":"R_6axcFmKIHrxFVfT"},"81":{"1":"Stay behind and away from that car.","2":"Call non-emergency number.","3":"Try not to panic.","4":"Put on hazards to alert other drivers so no accidents.","5":"Call 911 if an accident happens.","6":"R_6fOekFtDGz6G3Da"},"82":{"1":"Pull over and call the police.","2":"Keep following the car, but at a distance.","3":"Take a different way home.","4":"Try to get past the intoxicated driver.","5":"Call a family or a friend and ask them to contact the police.","6":"R_6g0Hs6TEwcmmwBT"},"83":{"1":"The car might crash into another car.","2":"Another car at full speed can crash it.","3":"It will delay the time of Eramon.","4":"He will be patient for it.","5":"He will be angry.","6":"R_6rmuKX05vLAvOBH"},"84":{"1":"Maintain a safe distance.","2":"Pull over and wait for assistance.","3":"Follow at a safe distance.","4":"Avoid engaging with the driver.","5":"Call the authorities.","6":"R_71d2fLSYJMHxME9"},"85":{"1":"Keep a safe distance.","2":"Avoid passing in dangerous areas.","3":"Call 911.","4":"Signal intentions clearly.","5":"Stay alert for erratic behavior.","6":"R_72sGEqTvQKyRicF"},"86":{"1":"Put the car aside.","2":"Call the police.","3":"Make sure the driver is okay.","4":"Honk to make sure he is okay.","5":"Call 911.","6":"R_79bryPGTSPpyX16"},"87":{"1":"Call the police.","2":"Try to pass him.","3":"Go a different way.","4":"Honk his horn to try to get him to pull over.","5":"Stay behind him and avoid a dangerous situation.","6":"R_7HGk7UW6XVk8PmB"},"88":{"1":"Blow the horn.","2":"Wait for the other car to pass.","3":"Should not drive in the blind spot of the car.","4":"Warn or signal other cars.","5":"Pull over if possible.","6":"R_7JfFwcDJP35Hzln"},"89":{"1":"Maintain a safe distance.","2":"Call the authorities.","3":"Signal other drivers.","4":"Prepare to stop if needed.","5":"Avoid distracted driving.","6":"R_7NnYslnXUagUp2N"},"90":{"1":"Hold back and drive behind him.","2":"Call 9-1-1 to alert them of a possible drunk driver.","3":"Pull off to the side of the road.","4":"Honk at the driver to get their attention.","5":"Turn off at the next exit.","6":"R_7PiTrt6sUtipXwT"},"91":{"1":"Report it.","2":"Follow them discreetly.","3":"Try to alert any oncoming traffic.","4":"No idea.","5":"No other idea.","6":"R_7V04Jixznx3woZr"},"92":{"1":"Have a passenger call 911.","2":"Honk horn to get the driver's attention.","3":"Try to stop the driver.","4":"\/\/.","5":"\/\/.","6":"R_7ZW6aWsDMZcXZIJ"},"93":{"1":"Call 911.","2":"Follow behind the car while waiting for the police.","3":"Drive up by the car to check driver in case he's ill.","4":"If possible, drive slow by car, honk horn to get driver's attention.","5":"Honk and gesture for them to pull over.","6":"R_7aJJRH6OUfnV4Sq"},"94":{"1":"Call 911 to take care of it.","2":"Call 911, but follow the driver closely until 911 takes care of it.","3":"Avoid the car by taking a different route.","4":"Pull in front of car to stop it.","5":"Beep at the car to stop it.","6":"R_7hcCmfBjloGjeY9"},"95":{"1":"He could alert the authorities to the situation.","2":"He could find an alternative route to ensure his safety.","3":"He could attempt to pass the driver ahead of him and, hopefully, avoid a collision to ensure his safety.","4":"He could attempt to force the driver off the road for the safety of other drivers.","5":"If he has a dash cam he could submit the footage to the authorities.","6":"R_7n6ZmcyeOYNoo2Z"},"96":{"1":"Call the police.","2":"Stop driving and wait until that car is long gone.","3":"Try to flag the car down.","4":"Honk at the car to get its attention.","5":"Pass the car.","6":"R_7pflm8v9g0RcukR"},"97":{"1":"Pull over.","2":"Chill out on the side of the road.","3":"Call the police.","4":"Call an ambulance for help.","5":"Call family member.","6":"R_7y4gmVfTEK1zk6l"},"98":{"1":"Call 911.","2":"Pass car to get out of the way.","3":"Get off that road.","4":"Honk at other cars.","5":"Slow way down, away from the other car.","6":"R_8xJ9v7zSTbpsHIJ"}},"Randomization":"Subset","TotalRandSubset":1}}},"66":{"Type":"Standard","SubType":"","Description":"Scenario5","ID":"BL_cuO66AmYKIX9eEC","BlockElements":[{"Type":"Question","QuestionID":"QID818"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1017"},{"Type":"Question","QuestionID":"QID819"},{"Type":"Question","QuestionID":"QID820"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID995"},{"Type":"Question","QuestionID":"QID827"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID821"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID822"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID823"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID824"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID825"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID826"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1035"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1006"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID964"},{"Type":"Question","QuestionID":"QID965"},{"Type":"Question","QuestionID":"QID966"},{"Type":"Question","QuestionID":"QID967"},{"Type":"Question","QuestionID":"QID968"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"119":{"1":"Give her a ride.","2":"Not give her a ride.","3":"Direct her to the nearest bus.","4":"Give her the phone number for an Uber.","5":"Give her the phone number for a taxi.","6":"R_110rMptMSqCu4MO"},"120":{"1":"Offer the ride.","2":"Politely decline.","3":"Suggest an alternative.","4":"Assess safety.","5":"Ask for more details.","6":"R_11Gwq1nh41XJk6C"},"121":{"1":"Give her a ride.","2":"Offer her an Uber.","3":"Give her bus or taxi fare.","4":"Say no.","5":"Give her a ride closer to her destination.","6":"R_11cwa4Rb5sUMoC0"},"122":{"1":"Ask her questions.","2":"Greet the lady.","3":"Have a talk.","4":"Examine her by looking at her keenly.","5":"Drive her to the city.","6":"R_11u8lFJDCIDjOHx"},"123":{"1":"Cameron could say no.","2":"Cameron could pretend not to hear her.","3":"Cameron could say yes.","4":"Cameron could say he would take her as far as his house, but no further.","5":"Cameron could call her a taxi.","6":"R_190yYgIlepm6122"},"124":{"1":"Tell her no.","2":"Tell her yes.","3":"Say you have somewhere to be, and you can't.","4":"Apologize and say that's out of the way.","5":"Take her.","6":"R_1E1DXURxHj5zoWd"},"125":{"1":"Suggest a taxi.","2":"Say no.","3":"Only take her halfway.","4":"Drop her at a police dept.","5":"Help her find a different ride.","6":"R_1Hcg6SPp3BVoCeB"},"126":{"1":"Say yes and give her a ride.","2":"Say no because it is too far, and she is a stranger.","3":"Offer her money for a cab.","4":"Give her a ride to her destination only.","5":"Ask why she needs the ride.","6":"R_1Hozj5hB2tr9ELj"},"127":{"1":"Politely decline and continue about his day.","2":"Offer a ride to her destination.","3":"Offer her a ride part of the way so as not to go out of the way.","4":"Offer her a ride at 80% of the UBER cost.","5":"Ignore the woman.","6":"R_1I3RUbhp0iKejll"},"128":{"1":"Give her a ride.","2":"Tell her no.","3":"Offer to take her part of the way.","4":"Pretend he doesn't speak English.","5":"Ignore her.","6":"R_1Ic4ZIMVOPoURkj"},"129":{"1":"Say No.","2":"Say Yes.","3":"Offer to call her a cab.","4":"Point her to the bus stop.","5":"Ignore her.","6":"R_1KwX4aJlFHBndGV"},"130":{"1":"Go ahead and give the lady a ride.","2":"Apologize and say you aren't quite fully going in the direction.","3":"Mention you have plans and cannot help out.","4":"Offer to give her some money for a cab.","5":"Offer to drop her off a little closer to her destination, but not all the way.","6":"R_1LwBEfudDZdSksl"},"131":{"1":"Take her.","2":"Refuse to take her.","3":"Offer to take her part way (appropriate drop off near house).","4":"Offer fare for public transportation if available.","5":"Call a friend that lives near her to see if they are on their way home yet that may be able to help her.","6":"R_1NCTivNHn2R2xwd"},"132":{"1":"Assess the Situation and Trust His Instincts.","2":"Ask for More Information.","3":"Offer to Help in a Different Way.","4":"Consider Her Appearance and Behavior.","5":"Set Boundaries and Be Clear About His Decision.","6":"R_1QDCLxUFcI9nrsz"},"133":{"1":"Do not give the ride to the woman.","2":"Lie and say you are not going that way.","3":"Offer to call the police for assistance.","4":"Offer to call an Uber.","5":"Offer to call a friend for the woman.","6":"R_1WCnLLbNlkN5Xz3"},"134":{"1":"Offer to drive her to the nearby city, going out of her way to help.","2":"Call a taxi\/ride-sharing service for her.","3":"Direct her to public transportation options.","4":"Politely decline, citing his original plans.","5":"Suggest calling a local friend\/family member for assistance.","6":"R_1f7QxkxXe60wB94"},"135":{"1":"Give her a ride.","2":"Decline.","3":"Decline and say you're going the other way.","4":"Decline you have lunch plans with a coworker.","5":"Decline and say you're running late.","6":"R_1gRsz8apkxehTES"},"136":{"1":"Say no.","2":"Offer her an Uber.","3":"Allow her to use his phone to call someone else.","4":"Give her a ride.","5":"Show her where public transportation is.","6":"R_1iBZgffUBpQdqlZ"},"137":{"1":"He could say no.","2":"He could say yes.","3":"He could give her money for an Uber.","4":"He could order her an Uber.","5":"He could ignore her.","6":"R_1k1jQWohFaRHghn"},"138":{"1":"Tell her he can't; it's not safe to let a stranger in the car.","2":"Offer to take her as far as he's going.","3":"Take her the entire way.","4":"Offer to call her an Uber.","5":"Offer to give her bus fare.","6":"R_1oLsH88LkvnErhT"},"139":{"1":"He could tell her no, and walk away.","2":"He could offer to get her an Uber.","3":"He could drive her halfway there and drop her off somewhere to catch another ride.","4":"He could ignore her.","5":"He could take her where she needs to go.","6":"R_1qCR4YLk8RyiKvm"},"140":{"1":"Could've called a rideshare for the woman.","2":"Agreed to give her a ride.","3":"Gave money for the bus\/train.","4":"Call the police for assistance.","5":"Call an organisation.","6":"R_1wJMzTjIO3wuPvj"},"141":{"1":"Politely decline the request.","2":"Offer to help in another way.","3":"Assess the situation and trust his instincts.","4":"Offer a short ride to a nearby location.","5":"Check for a public or shared ride option.","6":"R_2I3GLk4ENruE9Vg"},"142":{"1":"Help the woman.","2":"Lie about his direction.","3":"Tell the woman he cannot help her.","4":"Act dumb.","5":"Ignore the woman.","6":"R_2JL3TNOcc14UDXz"},"143":{"1":"Apologize and say it's out of his way.","2":"Decide to help her anyway.","3":"Ask if he knows her.","4":"Offer other suggestions for her to get there.","5":"Ignore her completely.","6":"R_30MXRF4OYEAUjyM"},"144":{"1":"Help the woman out.","2":"Make more research about the place.","3":"Make sure he is picking the right person.","4":"Make sure he don't fall in the wrong hands.","5":"Call to be tracked.","6":"R_31D4VrSDquNTfA5"},"145":{"1":"Cameron would bring the lady home.","2":"Cameron would let the lady know he was unable to take her home.","3":"Cameron would give her money to help her.","4":"Cameron would tell her to call Uber or Lyft.","5":"Cameron would just ignore her.","6":"R_32JhhdK2roDb2ks"},"146":{"1":"Offer the ride.","2":"Decline the ride.","3":"Give her suggestions.","4":"Tell her you are running late.","5":"Ignore her.","6":"R_346RSAXMpOOSu79"},"147":{"1":"Say no.","2":"Offer the ride.","3":"Offer to drive part of the way.","4":"Drive her there.","5":"Call her a taxi.","6":"R_34t6UZ15RZT05ZD"},"148":{"1":"Help her with cash to enter the cab.","2":"Carry her and drop her halfway.","3":"Give her the ride.","4":"Refuse to help her.","5":"Help her with some cash to enter the cab but not the complete payment for the ride.","6":"R_3AYfE1sOrSAcGk1"},"149":{"1":"Give her a ride.","2":"Suggest calling a taxi for her.","3":"Suggest her getting an Uber or Lyft for herself.","4":"Talk about why it is dangerous to approach random men for rides.","5":"Point her to the nearest bus pick-up.","6":"R_3Cy3l9xy7qdsin6"},"150":{"1":"Leave.","2":"Take the women.","3":"Help her find another ride.","4":"Get her a cab.","5":"Give her cash.","6":"R_3E3U2xelzLSlypm"},"151":{"1":"Make up an excuse.","2":"Claim he's going in the opposite direction.","3":"Give the woman a ride.","4":"Take the woman to a bus stop\/station.","5":"Decline the woman's request.","6":"R_3Ea8aK90rB1mdue"},"152":{"1":"He could deny the ride.","2":"He could ask for gas money.","3":"He could lie and say he is experiencing car problems.","4":"He could cheerfully oblige.","5":"He could tell her that he just wants to get home, but he could take her that far.","6":"R_3GpL7t91IX7KJyU"},"153":{"1":"Offer a ride to the woman.","2":"He could find an alternative way for the woman to reach her destination.","3":"He could drive her halfway.","4":"He has to consider whether the situation feels safe or not.","5":"He could also say no.","6":"R_3KGZH9OLT6wf6Et"},"154":{"1":"Agree and drive her the extra 10 miles.","2":"Say No.","3":"Agree to drive her up until the point of his house.","4":"Offer to assist her in calling a friend to fetch her.","5":"Assisting her to use Uber.","6":"R_3KNtlm03Afkz9l4"},"155":{"1":"Give her a ride.","2":"Give her money for transportation.","3":"Reject her offer.","4":"Yell angrily at her.","5":"Direct her to another car.","6":"R_3PaSiWIW3QpsbwG"},"156":{"1":"He could maybe say he is in a hurry and sorry he cannot take her.","2":"He could look at her and assess the area to see if he's comfortable with giving her a ride.","3":"He could offer her some spare cash to call a rideshare.","4":"He could direct her to a nearby bus stop.","5":"Trust his instincts.","6":"R_3PyEZ8tqeoRu3J2"},"157":{"1":"Call an Uber.","2":"Tell her 'no.'","3":"Give her the number for a taxi.","4":"Look up the bus route.","5":"Give her the fare.","6":"R_3PyR670oZA2M5st"},"158":{"1":"Ask what happened to her car.","2":"Offer to call a friend or family member.","3":"Offer to get the woman an Uber.","4":"Say no to the woman.","5":"Offer to take her if she gives him gas money.","6":"R_3Vkpcf3f3aqTzgZ"},"159":{"1":"Offer to call a friend or a family member.","2":"Assess the safety of the situation.","3":"Politely decline the request.","4":"Offer to help in a different way.","5":"Offer a public transportation option.","6":"R_3WBTnwI8QDPKK3U"},"160":{"1":"Politely Decline.","2":"Offer Alternative Help.","3":"Assess the Situation.","4":"Offer to Call a Rideshare.","5":"Trust His Gut.","6":"R_3WI3O9L8FKzGeo9"},"161":{"1":"Cameron might decide not to give the ride.","2":"Cameron might decide to give her the ride.","3":"Cameron will ask some questions.","4":"Cameron will think through it.","5":"Cameron will check if he actually knows where the woman is going.","6":"R_3fqVV7nKwu7T06u"},"162":{"1":"Say no.","2":"Ask for gas.","3":"Take the bus.","4":"Lie.","5":"Leave.","6":"R_3hzhNe5kZRkNRve"},"163":{"1":"Say he will do it, but ask for gas money.","2":"Decline.","3":"Call someone who is going that way.","4":"Get an Uber.","5":"Drive until her destination and drop her off so she can hitch a ride.","6":"R_3jTHlloF0CcCinm"},"164":{"1":"Give the woman a ride.","2":"Decline giving the lady a ride.","3":"Buy her a drink.","4":"Give her a ride and buy her a drink.","5":"Decline her a ride and buy her a drink.","6":"R_3mmDkGpCz2DOfny"},"165":{"1":"Say no.","2":"Give her money to get a taxi.","3":"Ask a friend to ride along.","4":"Say he will take her to the city where he lives.","5":"Call an Uber.","6":"R_3p51sIe0DUaY2zt"},"166":{"1":"Take her the whole way.","2":"Take her part of the way.","3":"Tell her he can't do it.","4":"Pay for an Uber.","5":"Give her a bike.","6":"R_3pBhiBfoQjMZ2V3"},"167":{"1":"Politely say no.","2":"Suggest she calls for a taxi or Uber.","3":"Give her a ride to where you are going.","4":"Give her a ride all the way to where she wants to go.","5":"Ignore her.","6":"R_3pX5TXj5EJ2NFWo"},"168":{"1":"Tell the lady he is in a hurry.","2":"Give the lady a ride.","3":"Offer to set up an Uber for her.","4":"Ask anyone else at the gas station if they have time.","5":"Ignore her.","6":"R_3pXufk8z7qV1CKS"},"169":{"1":"Say no because she's a stranger.","2":"Offer to call her a ride.","3":"Offer to call one of her friends.","4":"Let her know where the nearest bus stop is.","5":"Give her the ride.","6":"R_3pgdUQuoesxSY9j"},"170":{"1":"Take her home.","2":"Ask if she's okay.","3":"Make sure it's not a setup.","4":"Give her money for a bus ride.","5":"Ask for gas money.","6":"R_50UT37dOI0JaB8z"},"171":{"1":"Tell the lady no; he can't help her.","2":"Tell the lady he will consider it if she reimburses him for gas.","3":"Tell the lady he will take her halfway, and she can figure out the rest.","4":"Tell the lady he will take her the whole way, free of charge.","5":"Ask the lady for the best way to get there since he's willing but unfamiliar with the area.","6":"R_511rbeex9qAL56S"},"172":{"1":"Assess Safety and Trustworthiness.","2":"Offer to Help in Other Ways (e.g., Call a Ride Service).","3":"Ask for more details about her situation.","4":"Offer to Drive Partway or Suggest a Different Meeting Spot.","5":"Decline Politely and Stick to His Plans.","6":"R_52JBySUdttrVTi0"},"173":{"1":"Help the woman to her destination.","2":"Drop her at his stop.","3":"Assist her with transportation fare.","4":"Explain to her he can't go farther.","5":"Decline.","6":"R_54eLulcQnR1s3TC"},"174":{"1":"Take her to the next city.","2":"Reject her request.","3":"Ask nearby people if anyone is going that far in that direction.","4":"Ignore her.","5":"Ask if taking her part way is acceptable.","6":"R_56mvfURuPeCXB6r"},"175":{"1":"Help her.","2":"Answer her question.","3":"Ignore her.","4":"Be nice.","5":"Offer her to follow him.","6":"R_5Cye5rvDuqKReQJ"},"176":{"1":"Ignore the woman.","2":"Explain the inconvenience to the woman.","3":"Drive the woman.","4":"Apologize and decline the woman.","5":"Drive the woman part of the way.","6":"R_5FnDIvEjRPhM6LE"},"177":{"1":"Politely decline the request because it is not safe to give rides to strangers.","2":"Offer an alternative transportation option, like public transport.","3":"If he feels unsafe, let another person know about it.","4":"Stay in the car.","5":"Just leave.","6":"R_5G9pPAWQ0rKuL5f"},"178":{"1":"Tell her it's out of her way.","2":"Take her to the city.","3":"Say he's going in the opposite direction.","4":"Take her as far as his turn-off.","5":"Tell her no.","6":"R_5GVJUa2sMK038sM"},"179":{"1":"Cameron would decline, saying it is out of the way.","2":"Cameron would give her money to take a taxi.","3":"Would get you an Uber and pay for it.","4":"Cameron would give her a ride part of the way.","5":"Cameron would give her a ride home.","6":"R_5GkopTuQFGmLEt3"},"180":{"1":"He could politely tell her he was sorry, but he would not be able to drive beyond his destination.","2":"He could simply ignore her and focus on refilling his tank.","3":"He could book an Uber or another similar ride-hailing service for her.","4":"He could as well tell her it is fine and agree to offer her a ride to her destination.","5":"He could advise her on any other possible options that could help her get home.","6":"R_5JFQkbBsye5Z7Q9"},"181":{"1":"Ask why she needs to go there.","2":"Ask her why she is struggling to get there by herself.","3":"Explain that he does not feel comfortable doing so.","4":"He is only getting enough gas to get home.","5":"Find another way for her to get there.","6":"R_5MR5QvICk3iVxQb"},"182":{"1":"Offer to call a cab.","2":"Tell her he doesn't pick up strangers.","3":"Give her money for a cab.","4":"Call his friends and ask them to pick her up.","5":"Give her a ride.","6":"R_5MusV3psiAY3z1v"},"183":{"1":"He could offer to help the woman.","2":"He could drop the woman off at where he was headed.","3":"He could decide not to help.","4":"NA","5":"NA","6":"R_5Ttm6GBL7wtSai9"},"184":{"1":"Refuse to help politely.","2":"Alight here at this junction for the lady to continue.","3":"Don't pick her.","4":"Set boundaries.","5":"Assess the situation.","6":"R_5fwalBO7F218CTD"},"185":{"1":"Decline the ride.","2":"Ask for gas money.","3":"Agree to take them.","4":"Decline the ride. Give them some money.","5":"Agree to take them. Give them some money.","6":"R_5gzLTn0JQtz61wE"},"186":{"1":"Politely tell the woman, \"No.\"","2":"Say yes and take her.","3":"Offer to order her an Uber.","4":"Ignore her.","5":"Take her, but not all the way.","6":"R_5hLArf5UT11I013"},"187":{"1":"Give her a ride.","2":"Give her a ride as far as her house and let her figure out how to go the next 10 miles.","3":"Pretend he did not hear her.","4":"Call her an Uber and pay for it himself.","5":"Politely explain it is not safe to give rides to strangers, and he can't help her.","6":"R_5sn02dInsUYYBeV"},"188":{"1":"Politely decline.","2":"Assess the woman's situation.","3":"Offer alternative help.","4":"Ensure safety.","5":"Trust his instincts.","6":"R_5xz0PrPzqNyIgb7"},"189":{"1":"Give the woman a ride.","2":"Tell the woman no.","3":"Give the woman money to take a taxi.","4":"Call the police to report the woman for suspicious behaviour.","5":"Tell the woman to go to the gas station and ask for assistance.","6":"R_61GmBkLBYTD3DPg"},"190":{"1":"Give her a ride as far as she is going.","2":"Refuse to give her a ride.","3":"Let her use his phone to call someone else.","4":"Give her money to help her get a taxi or something.","5":"Report her to the store manager.","6":"R_66gvtEzsDayFAGr"},"191":{"1":"1. Offer a ride.","2":"2. Politely decline.","3":"3. Suggest other transportation options.","4":"4. Check for identification or verification.","5":"5. Call for help.","6":"R_6CpCYqUbssasO1L"},"192":{"1":"Call a taxi for the woman.","2":"Provide directions to the nearby city.","3":"Offer to drive her to the city.","4":"Politely decline.","5":"Offer to drop her off at a safe location.","6":"R_6It9aEYe3rEhwAz"},"193":{"1":"He could agree to give her a ride.","2":"He could give her some money for Uber.","3":"He could politely tell her that he is in a rush and can't give her a ride.","4":"He could tell her how she could get there using public transportation.","5":"He could say no without explanation.","6":"R_6MSVzFHUWrpm50I"},"194":{"1":"Tell her no.","2":"Tell her yes and give her the ride for free.","3":"Have her pay him gas money for the ride.","4":"Pay an Uber\/Lyft for her.","5":"Take her as far as near his place, but not the extra 10 miles.","6":"R_6axcFmKIHrxFVfT"},"195":{"1":"Don't take her.","2":"Take her.","3":"Yell at her and tell her to go away.","4":"Cry and say gas prices are too high. Sorry.","5":"Ignore her completely.","6":"R_6eVJD9NA6X9ZM1U"},"196":{"1":"Say no.","2":"Explain that he could only take her so far.","3":"Go the extra ten miles.","4":"Ask her to see if she could get someone else to give her the ride.","5":"Ask for payment for the extra mileage.","6":"R_6g0Hs6TEwcmmwBT"},"197":{"1":"Say no.","2":"Say absolutely not.","3":"Call her an Uber.","4":"Call her a taxi.","5":"Tell her where the bus is.","6":"R_6jKUYnaHYdMREbf"},"198":{"1":"Refuse her.","2":"Tell her he can take her halfway.","3":"Help her find public transportation.","4":"Help her find another customer who can help.","5":"Tell her to call a family member.","6":"R_6jqYLUMt97mQsda"},"199":{"1":"Offer the ride.","2":"Don't offer the ride.","3":"Tell her you are busy.","4":"Tell her to contact Uber.","5":"Tell her to ask a friend for a ride.","6":"R_6kNuNPNFAKSyN3S"},"200":{"1":"Cameron could call a ride for the woman but go his own way.","2":"Cameron could drive the woman to the nearby city.","3":"Cameron could decline and leave the woman where she is.","4":"Cameron could give the woman his car and let her drive while he walks.","5":"Cameron could drive the woman to his home and let her walk the rest of the way to the city.","6":"R_6n0gaBJlObJZNJL"},"201":{"1":"Offer to drive her to the nearby city, going out of his way to assist.","2":"Refuse, stating that he is going home and cannot detour.","3":"Call a local taxi or ride-sharing service for her.","4":"Suggest alternative transportation options (e.g., public transit, taxi, ride-sharing).","5":"5. Offer to drop her off at a safe location (e.g., a bus station) where she can continue her journey.","6":"R_6uP6OOuNejdcIe3"},"202":{"1":"Apologize but say he can't do it.","2":"Explain it's too far and decline.","3":"Ask for money for gas.","4":"Drive here.","5":"Drive her only part of the way.","6":"R_6zBHPyYPpZHrSA9"},"203":{"1":"Offer to take her as far as he's going.","2":"Say he can't but offers money for a meal or something.","3":"If you're rich, you could pay for an Uber.","4":"Say no.","5":"Say yes and just take her.","6":"R_71jIO8XxofgA5ZU"},"204":{"1":"Say yes.","2":"Say no.","3":"Pay for a cab.","4":"Take her most of the way there.","5":"Ignore her.","6":"R_72WAzU0jf8bT65J"},"205":{"1":"Politely decline.","2":"Call a ride service.","3":"Agree to give a ride.","4":"Offer a shorter ride as an alternative.","5":"Ask for more information.","6":"R_72sGEqTvQKyRicF"},"206":{"1":"He can offer to call someone to pick her up.","2":"He could take her as far as he could based on his route.","3":"He could take her all the way to where she needs to go.","4":"He could say he can't and continue on his way.","5":"He could pay for an Uber for her.","6":"R_74NxEjV7dEE5904"},"207":{"1":"Say no.","2":"Say no.","3":"Say no.","4":"Say no.","5":"Say yes and get murdered.","6":"R_79bryPGTSPpyX16"},"208":{"1":"Not give a stranger a ride.","2":"Give her the ride.","3":"Drop her near his destination.","4":"Offer a taxi.","5":"Offer bus fare.","6":"R_7CAF93nL8ofFDbz"},"209":{"1":"Not give her a ride.","2":"Offer to call a cab.","3":"Tell her to take a bus.","4":"Apologize and tell her no.","5":"Ask why she needs the ride.","6":"R_7CyjUM1lnYTRXWr"},"210":{"1":"Politely decline.","2":"Offer a compromise.","3":"Assess the situation.","4":"Help with alternative solutions.","5":"If he feels safe, provide the ride.","6":"R_7FQCwzL61mqIGfl"},"211":{"1":"Take the woman to the city.","2":"Decline to take the woman to the city.","3":"Act like he cannot speak the womans language and doesnt understand.","4":"Act like he is going the other way.","5":"Pretend to have an emergency; he has to rush to.","6":"R_7Fyi9b5fRdcmEUN"},"212":{"1":"Not doing it at all.","2":"Suggest that she call an Uber.","3":"Take her, but tell her that he needs gas money.","4":"Suggest that she calls a friend or family member.","5":"Suggest that she take the city bus.","6":"R_7LbbH6CJBhzkj6m"},"213":{"1":"Ignore her.","2":"Explain that the wife would not approve.","3":"Tell her you're going the other way.","4":"Take her only as far as you're already going.","5":"Drive her to the city.","6":"R_7QSNb7GnKmUekTZ"},"214":{"1":"Cameron could give her a ride anyway.","2":"Cameron could lend her money for an Uber\/taxi ride.","3":"Cameron could say no.","4":"Cameron could advise her on bus route resources so she could find her own ride.","5":"Cameron could agree to drive her if she pays him.","6":"R_7RvzucUpWomndJz"},"215":{"1":"Say no.","2":"Give her a paid Uber.","3":"Give her a ride.","4":"Give her a paid Lyft.","5":"Ask to help call her friends.","6":"R_7TYuRV0fo2RuQFb"},"216":{"1":"Drive her as far as your house.","2":"Drive her to the nearest public transport.","3":"Drive her to her location.","4":"Drive her as far as your house, but ask for money to drive all the way.","5":"Say no.","6":"R_7d1d18cbc3kH9qi"},"217":{"1":"Politely decline, explaining that he's on his way home and can't deviate from his route.","2":"Help the woman find alternative transportation, such as calling a taxi or rideshare service.","3":"Offer to drive the woman to a nearby bus stop or gas station where she can find other transportation options.","4":"Request a fee for the extra mileage and time.","5":"Trust his gut and decline the request, regardless of any potential guilt or inconvenience.","6":"R_7eITVZii96Fx1HJ"},"218":{"1":"Give the woman a ride.","2":"Order the woman an Uber\/Lyft\/ride-sharing service.","3":"Help the woman order an Uber\/Lyft\/ride-sharing service.","4":"Give the woman a ride to a public transportation station.","5":"Not helping the woman at all.","6":"R_7hcCmfBjloGjeY9"},"219":{"1":"Offer to pay for a shared ride service like Uber.","2":"Offer to take her at a public place nearby his house like a Walmart.","3":"Offer to take her to her destination.","4":"Offer to give her money for a cab.","5":"Offer his cell phone so she can call a friend or family member to take her.","6":"R_7kTq963Jg1uqbcd"},"220":{"1":"Say no.","2":"Say yes.","3":"Take her as far as her house.","4":"Call the police.","5":"Tell her she would if she pays her.","6":"R_7lKxI48EgTdnMm4"},"221":{"1":"Tells her no.","2":"Tells her yes.","3":"Calls her a cab.","4":"Drives her close to the city, not all the way.","5":"Pretends not to hear her.","6":"R_7tG7BMrK68GaXQZ"},"222":{"1":"Decline.","2":"Give her a ride.","3":"Refer her to the nearest bus station.","4":"Call her an Uber.","5":"Suggest that she asks someone else.","6":"R_7y4gmVfTEK1zk6l"},"223":{"1":"Tell her no.","2":"Tell her it's too far.","3":"Tell her he's too tired.","4":"Tell her to find another ride.","5":"Tell her he don't give rides to strangers.","6":"R_8xJ9v7zSTbpsHIJ"}},"Randomization":"Subset","TotalRandSubset":1}}},"67":{"Type":"Standard","SubType":"","Description":"Scenario6","ID":"BL_9AfOVQdg9XYtSg6","BlockElements":[{"Type":"Question","QuestionID":"QID828"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1018"},{"Type":"Question","QuestionID":"QID829"},{"Type":"Question","QuestionID":"QID830"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID996"},{"Type":"Question","QuestionID":"QID837"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID831"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID832"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID833"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID834"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID835"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID836"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1036"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1007"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1216922699"},{"Type":"Question","QuestionID":"QID1216922700"},{"Type":"Question","QuestionID":"QID1216922701"},{"Type":"Question","QuestionID":"QID1216922702"},{"Type":"Question","QuestionID":"QID1216922703"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Call the cops.","2":"Go inside to try to find the owner.","3":"Break the car window.","4":"Call animal control.","5":"Wait for the owner to come out and lecture them about the dangers of leaving the dog inside the car.","6":"R_10wtlGJBiUnExNp"},"2":{"1":"Stay with the dog.","2":"Take Photos.","3":"Warn Other Passersby.","4":"Look for Signs of Heat Stroke.","5":"Try to Create Ventilation.","6":"R_11Gwq1nh41XJk6C"},"3":{"1":"Call 911.","2":"Look for the owner.","3":"Go into the mall and see if someone can announce over the loudspeaker.","4":"Break the window.","5":"Look around the parking lot for the owner.","6":"R_1E1DXURxHj5zoWd"},"4":{"1":"Call animal control or law enforcement.","2":"Inform mall security or management.","3":"Check for the car owner.","4":"Provide shade and water (if possible).","5":"Take photos\/video as evidence.","6":"R_1EVTptN2zfoV1jP"},"5":{"1":"Call 911.","2":"Go back into the mall, go to the receptionist to make an announcement about the dog.","3":"Break the window of the car.","4":"Call for help around.","5":"Stay with the dog.","6":"R_1FOx5fZ5R68200x"},"6":{"1":"She could call the police.","2":"She could stop someone passing by to help.","3":"She could break the window.","4":"She could yell for help.","5":"She could notify mall security.","6":"R_1Gv59GbbxIG4hqx"},"7":{"1":"Call 911.","2":"Check the doors to see if they're locked.","3":"Call for help.","4":"Break a window.","5":"Do nothing.","6":"R_1Ijh5l65kd1Edft"},"8":{"1":"Check if the car doors are unlocked.","2":"Try and locate the dog's owner.","3":"Call the police.","4":"Break car window.","5":"Mind her own business.","6":"R_1JlXAFjunLfNJ1T"},"9":{"1":"Go back into the mall and find security to contact the owner.","2":"Wait in her car for a little while to see if someone comes out soon.","3":"Bust out the window if she really thinks the dog is in trouble.","4":"Mention it to other people.","5":"Check to see if the door is open on the car.","6":"R_1LwBEfudDZdSksl"},"10":{"1":"Find the owner to prompt them.","2":"Find a way to open the door.","3":"Break the glass if the door is locked.","4":"Call for help.","5":"Call the ambulance after getting the dog out.","6":"R_1OUptQGvK0r1RIk"},"11":{"1":"Assess the Situation.","2":"Look for the owner.","3":"Call Animal Control or the Non-Emergency Police Line.","4":"Take Note of the Car's Details.","5":"Try to keep the dog calm.","6":"R_1QDCLxUFcI9nrsz"},"12":{"1":"Shopping.","2":"Drive.","3":"Observant.","4":"Pity.","5":"Careful.","6":"R_1QmIdypXuN6APyV"},"13":{"1":"Assess the situation.","2":"Look for the car owner.","3":"Call animal control or the police.","4":"Document the incident.","5":"Take emergency action only if necessary.","6":"R_1WHyzUjIfj8D3MZ"},"14":{"1":"Start looking for the car owner.","2":"Notify security or police by phone.","3":"Forget about it and drive home, don't get involved.","4":"Wait at the car.","5":"Talk to someone passing by and ask their advice.","6":"R_1WItAFIsHsFVCpu"},"15":{"1":"Get mall security.","2":"Call 911.","3":"Call the animal shelter.","4":"Try to get the window down.","5":"Try to get the car door open.","6":"R_1Yac7Yn0QVqPDrO"},"16":{"1":"Call the police.","2":"Wait by the car for the owner.","3":"Call the mall office.","4":"Break the car windows, if allowed by law.","5":"Record the dog and car for video evidence.","6":"R_1dMHTTPBS7ebelo"},"17":{"1":"Check if the doors are locked.","2":"Look around for the owners.","3":"Break the window.","4":"Walk back into the mall and have them make an announcement.","5":"Call fire fighters.","6":"R_1dYsdWEsjj4TCRX"},"18":{"1":"Call local animal control.","2":"Inform the mall security.","3":"Try and provide water for the dog. That's if it's safe.","4":"Document vehicle info.","5":"Try to locate the car owner inside the mall.","6":"R_1f7QxkxXe60wB94"},"19":{"1":"Walk away.","2":"Call the police.","3":"See if the doors are unlocked.","4":"Contact mall management.","5":"Break a window.","6":"R_1iBZgffUBpQdqlZ"},"20":{"1":"Call authorities.","2":"Break the window and rescue the dog.","3":"Try to find the owner.","4":"Walk away and go on with her day.","5":"Stay until the owner returns.","6":"R_1o7rmk66EqCjQ9b"},"21":{"1":"Break a window.","2":"Find mall security.","3":"Ignore.","4":"Try to open the doors.","5":"Scream.","6":"R_1odU3Ka3wecrCse"},"22":{"1":"Call 911.","2":"Break the window.","3":"Get mall security.","4":"Get license plate number.","5":"Try to open car door.","6":"R_1qgUPXeZqltMSJZ"},"23":{"1":"Call the police.","2":"Call mall security.","3":"Look for the owner.","4":"Break out the window.","5":"Yell for help.","6":"R_1rBphvdw3otUTwT"},"24":{"1":"BUST THE WINDOW!!!!.","2":"Call the cops.","3":"Get the pup some water.","4":"Wait on the cops and pay for the window.","5":"Keep the pupper.","6":"R_1s7dewV7OhGhLiU"},"25":{"1":"Call the police.","2":"Call the ASPCA.","3":"Go to mall security and have them look for the owner.","4":"Put it on social media for help.","5":"Call the local news.","6":"R_1wJMzTjIO3wuPvj"},"26":{"1":"Call 911.","2":"Go into the mall and alert security.","3":"Ask around to see if anyone knows the car.","4":"Ask and see if anyone knows the dog.","5":"Ask for an announcement to be made on the mall speaker.","6":"R_1zMquGryvF6HgYx"},"27":{"1":"Try to open the car door.","2":"If locked, break open the window.","3":"Call the police to open the window.","4":"Ask people in the parking lot for the owner.","5":"Ask people in the mall for the owner.","6":"R_2LZPiBvOgQw33Ij"},"28":{"1":"Look for the car owner.","2":"Call mall security.","3":"Stay with the dog.","4":"Find out the dog's condition.","5":"Call Animal Control.","6":"R_2eM4lcuYu5tfunU"},"29":{"1":"Have the owner paged.","2":"Break the window.","3":"Leave.","4":"Call Animal Control.","5":"Wait for the owner.","6":"R_30pn2AznvKMe182"},"30":{"1":"Call the mall's security.","2":"Call the police.","3":"Break the window.","4":"Do nothing.","5":"Open the door and give water.","6":"R_325oPaz7SElRR4t"},"31":{"1":"Alert Mall Security.","2":"Leave.","3":"Call Animal Control.","4":"Break the Window.","5":"Call 9-1-1.","6":"R_32FVc0CkQRYbsOl"},"32":{"1":"Call the police.","2":"Break the window.","3":"Find driver.","4":"Pry window down.","5":"Find water.","6":"R_32mp9ZvRhgXm8nv"},"33":{"1":"Call 911.","2":"Break the window.","3":"Try to find the car's owner.","4":"Ask for help from people around.","5":"Call animal control.","6":"R_34iLySqiDCcwHjF"},"34":{"1":"Erica will shout.","2":"Erica will call for help.","3":"Erica will hit the dog with an object.","4":"Erica will open the door.","5":"Erica will run away.","6":"R_35QLVlHPdqDuAq1"},"35":{"1":"Call mall security.","2":"Call the police.","3":"Call Animal Welfare.","4":"Look around to see if the person is near.","5":"Break the window.","6":"R_35XJBN8g5CqCxcR"},"36":{"1":"Stay with the dog.","2":"Document the situation.","3":"Contact animal control.","4":"Try to locate the owner.","5":"Attempt to open the car.","6":"R_3CArglpnLjmloHL"},"37":{"1":"Break the window.","2":"Call the police.","3":"Find the owner.","4":"Call 911.","5":"Go and tell security.","6":"R_3DbYYjPSDcTWv9O"},"38":{"1":"Wait for the owner.","2":"Break a window.","3":"Call the police.","4":"Try to open the door.","5":"Leave.","6":"R_3E3U2xelzLSlypm"},"39":{"1":"Break the window.","2":"Contact the police.","3":"Do nothing.","4":"Document the scene.","5":"Look for the owner in the mall.","6":"R_3FkZNCdE8A7qb9n"},"40":{"1":"Erica can go on about her business as usual.","2":"Erica could call 911.","3":"Erica could check to see if the car is locked.","4":"Erica could inform security and ask to make an announcement.","5":"Erica could break the car window.","6":"R_3HzWRb7OlSvSi0v"},"41":{"1":"Take the plate number and take it inside to page someone.","2":"Calls the police.","3":"Stands there until someone comes out.","4":"Checks to see if the door is open.","5":"Leave and do nothing.","6":"R_3INoGfI7cOjyIEJ"},"42":{"1":"Call the cops.","2":"Break the window.","3":"Call security.","4":"Wait until they return.","5":"Go to the stores and have them ask.","6":"R_3NEbUVhjZ9VuIPM"},"43":{"1":"Attempt to find the owner.","2":"See if the mall can announce a plate number to find the owner.","3":"Call the police or 911.","4":"Ask help services what to do. (Don't break car without permission unless extremely serious.)","5":"See if the door is unlocked; if it is, let the dog out and provide water.","6":"R_3NfHYUYzWPJFF3b"},"44":{"1":"Call the police.","2":"Tell mall security.","3":"Do nothing.","4":"Check to see if the car is unlocked.","5":"If the car is unlocked, open the door\/try to open the window.","6":"R_3OZyTC9XvC0OPiw"},"45":{"1":"Find the owner of the dog.","2":"Give food and water to it.","3":"Open the window for fresh air.","4":"Pat the dog.","5":"Play with the dog.","6":"R_3PaSiWIW3QpsbwG"},"46":{"1":"She could look at the dog a little closer to see if it's okay.","2":"If the dog doesn't look good, she can report it.","3":"She could try to locate the owner.","4":"Look for security to maybe help locate the owner.","5":"She could stay with the dog until the owner returns.","6":"R_3PyEZ8tqeoRu3J2"},"47":{"1":"Call mall security.","2":"Visit mall security.","3":"Call 911.","4":"Call the Animal Control Centre.","5":"Leave a message on the car window.","6":"R_3PyR670oZA2M5st"},"48":{"1":"Call 911.","2":"Find mall security.","3":"Try to open the car door.","4":"Break the car window.","5":"Get in your car and go home.","6":"R_3QWOpnso93EfdZj"},"49":{"1":"Break the window.","2":"Call the police.","3":"Inform mall security.","4":"Jimmy lock to open the door.","5":"Call fire dept.","6":"R_3QytAI0uiHmEnyC"},"50":{"1":"Wait for the owner to come back.","2":"Call the police.","3":"Break the windows and rescue the dog.","4":"Go into the mall and page the owner.","5":"Ignore the situation.","6":"R_3SoVE4JwjV3oFQl"},"51":{"1":"Erica should immediately go back to the mall and ask the staff at the customer service to make an announcement for the car owner to return to their vehicle.","2":"Erica should contact local animal control or the police to report the situation, as leaving a dog in a hot car can be dangerous.","3":"Erica should see if anyone nearby has tools or knowledge about how to handle such situations, or if they can help find the owner.","4":"Carefully check if any of the car doors are unlocked, as some people might accidentally leave their cars open.","5":"If the dog's life is clearly in immediate danger and authorities haven't arrived, Erica could break the window carefully to rescue the dog. However, this should only be a last resort, as it may have legal consequences.","6":"R_3dQLVP8lko9epzc"},"52":{"1":"Call 911.","2":"Break the window.","3":"Ask someone around if they can help.","4":"Ask an associate in the mall.","5":"Call a friend to get advice.","6":"R_3fYEYedezPYLzXj"},"53":{"1":"Break the window.","2":"Call the police.","3":"Try to find the owner.","4":"Call fire company.","5":"Call Animal Control.","6":"R_3iETHngP2xWuNGh"},"54":{"1":"Try to open the door.","2":"Go back into the mall and ask that security or someone make an announcement.","3":"Break the window.","4":"Call 911.","5":"Try to find the owner on her own.","6":"R_3ifobTM0IGVNiPD"},"55":{"1":"Call security at the mall.","2":"Call Animal Control.","3":"Call the police.","4":"Leave the doggy.","5":"Break the window.","6":"R_3jTHlloF0CcCinm"},"56":{"1":"Call the police.","2":"Break the window.","3":"Call Animal Control.","4":"Go into the store to find the owner.","5":"Mind her business.","6":"R_3mmDkGpCz2DOfny"},"57":{"1":"Call the mall's security.","2":"Talk to the management of the mall.","3":"Call animal control.","4":"Try to locate the owner of the dog.","5":"Stay with the dog if it is safe to do so.","6":"R_3oXW4v4k4JrjH1L"},"58":{"1":"Call fire fighters.","2":"Do nothing.","3":"Try to see if any door is unlocked, and if so, open and roll windows down.","4":"If she knows the car owner, go and get them.","5":"Break the window.","6":"R_3onnhStfWvSx3rG"},"59":{"1":"Open the door.","2":"Roll down the window.","3":"Look for the owner.","4":"Call the police.","5":"Break the window.","6":"R_3p51sIe0DUaY2zt"},"60":{"1":"Look for the owner.","2":"Call the police.","3":"Call the SPCA.","4":"Try to open the door.","5":"Break a car window to save the dog.","6":"R_3plErBG0o99AMKZ"},"61":{"1":"Assess the severity.","2":"Locate the owner.","3":"Call for help.","4":"Take photos or videos of the car, the license plate, and the dog\u2019s condition as evidence in case intervention is needed or legal action arises.","5":"If the dog appears to be in immediate danger and no help is forthcoming, Erica might consider taking action, such as finding a way to provide ventilation or water.","6":"R_3wdw3gEcVFqSsI7"},"62":{"1":"Ask around the parking lot or have the mall announce the owner's car information over the PA system.","2":"They can intervene if the situation seems dangerous for the dog.","3":"Keep an eye on the dog until help arrives, ensuring it doesn't get worse.","4":"Take a photo of the car and license plate.","5":"Break the window.","6":"R_3yeGLkSRIO8FnVq"},"63":{"1":"Call the police.","2":"Call a mall officer to find the owner.","3":"Break the window.","4":"Stay and fight the dog owner.","5":"Tell people around to see what other solutions they have.","6":"R_50UT37dOI0JaB8z"},"64":{"1":"Call 911.","2":"Ask the mall to make an announcement.","3":"Break the window.","4":"Cry.","5":"Ask someone else to break the window.","6":"R_514nlU3fSXVOknF"},"65":{"1":"Call the non-emergency police and report it.","2":"Call Animal Control.","3":"Look for the owner.","4":"Stay with the car until help arrives.","5":"Assess the situation.","6":"R_52xZVKt713vcEs9"},"66":{"1":"Call the police.","2":"Break the window.","3":"Ask for help.","4":"Go to the store, have them page.","5":"Yell out.","6":"R_54i4YC3HUUp89BR"},"67":{"1":"Call for help from mall security.","2":"Break a window to rescue the dog.","3":"Ignore the problem.","4":"See if she can break into the car without damaging it.","5":"Call the emergency animal rescue nearby.","6":"R_56mvfURuPeCXB6r"},"68":{"1":"Call mall security.","2":"Break a window.","3":"Just leave.","4":"Call 911.","5":"Wait for the owner while monitoring the dog.","6":"R_590Q0GsB3BrCf97"},"69":{"1":"Contact the police.","2":"Report it to the mall's security.","3":"Bring it to the attention of passersby and let someone else decide what to do.","4":"See if the car is unlocked and try to lower a window to allow air into the car.","5":"Break a window to let in air.","6":"R_5DoGtkVU2Jjwc54"},"70":{"1":"Call the non-emergency 911 number.","2":"Report it to mall security.","3":"Wait by the car for the owner to return.","4":"Google what to do if a dog is locked in a car and it's hot.","5":"Stay calm.","6":"R_5EgbdD2MwKgbJT7"},"71":{"1":"Ask a clerk for help.","2":"Call the police.","3":"Call the Humane Society.","4":"Smash a window.","5":"Wait outside the car.","6":"R_5FnDIvEjRPhM6LE"},"72":{"1":"Try finding the owner of the car.","2":"Call for help.","3":"Call the police.","4":"Stay around to monitor the situation.","5":"Break the window to save the dog.","6":"R_5G9pPAWQ0rKuL5f"},"73":{"1":"Attempt to locate the owner and have them rectify the issue.","2":"Call the police and alert them to the matter.","3":"Call mall security and have them deal with the problem.","4":"Try to find ways to block the sunlight from falling directly on the car.","5":"Check if one of the doors is unlocked and try to manually roll down a window depending on the car.","6":"R_5K2uhJmpmm5NO58"},"74":{"1":"Call security.","2":"Call the police.","3":"Break the window.","4":"Have customer service page the dog owner.","5":"Alert other people.","6":"R_5MusV3psiAY3z1v"},"75":{"1":"Ignore.","2":"Call 911.","3":"Call for help from people around.","4":"Go about her day.","5":"Put matters into her own hands.","6":"R_5My5OV3JHKAZCrk"},"76":{"1":"Break the window.","2":"Wait for the owner.","3":"Call the police.","4":"Walk away.","5":"Smash the windshield.","6":"R_5QDdHosyEaRHfop"},"77":{"1":"Erica would try opening the windows.","2":"Erica can also ask for help.","3":"She can announce it at the mall.","4":"She can also decide to break the windows to free the dog.","5":"She can decide not to engage.","6":"R_5Ttm6GBL7wtSai9"},"78":{"1":"Try to get the owner of the car.","2":"Call people's attention.","3":"Look for help.","4":"Try to see if the dog breathes.","5":"Mind your business.","6":"R_5Vy8E2IsOpaOyS2"},"79":{"1":"Erica could leave the dog to suffer.","2":"Erica could leave a note.","3":"Erica could notify somebody in the store.","4":"Erica could break the window and free the dog.","5":"Erica could call the police.","6":"R_5aulyey3yG8PXoJ"},"80":{"1":"Call Animal Control.","2":"Call 911.","3":"Let someone know at the front desk Mall.","4":"Wait for someone to come.","5":"Leave the dog.","6":"R_5lPMZUXs2CMWpvf"},"81":{"1":"Erica could go back into the mall and ask mall security or store employees to make an announcement over the loudspeaker to locate the car owner.","2":"Erica could contact animal control or the non-emergency police line to report the situation and request assistance.","3":"Erica could stay by the car to monitor the dog and wait for the owner or authorities to arrive.","4":"Erica could use a piece of clothing, a shopping bag, or another object to shield the dog from direct sunlight while waiting for help.","5":"If the dog appears to be in immediate danger of overheating and no help is arriving, Erica could break the car window to rescue the dog, but only if it is legal in her jurisdiction and she is prepared to explain her actions.","6":"R_61GiVxUTAexRwSF"},"82":{"1":"Try to open the car door to let air in.","2":"Call the police.","3":"Go in the mall and ask them to page the owner of the car make and model.","4":"Break the window and take the dog out.","5":"She could just leave the dog to die and go about her business.","6":"R_61GmBkLBYTD3DPg"},"83":{"1":"Erica could immediately call animal control or the local non-emergency police line to report the situation. They would be able to respond quickly and take appropriate action to save the dog.","2":"Erica could try to find the owner of the car by checking for any nearby stores or asking people in the parking lot if they know who the car belongs to. If the owner can be located, they can address the dog's distress without further escalation.","3":"If Erica can't locate the owner and the situation seems urgent, she could write down the license plate number and call the authorities with that information, allowing them to track down the owner.","4":"If the dog is showing signs of heatstroke or is in immediate danger, Erica might decide to break the car window (if she can do so safely) to free the animal. In some states, laws protect individuals who break a car window to rescue a pet in distress.","5":"If Erica is unsure about what to do or the situation doesn\u2019t seem immediately life-threatening, she could stay nearby and monitor the dog\u2019s condition while continuing to try to find the car owner or waiting for authorities to arrive.","6":"R_6IjdYRuK4t5JRDd"},"84":{"1":"Tell the mall to call the owner.","2":"See if the owner left a phone number on his window.","3":"Wait.","4":"I don't know.","5":"Call animal control.","6":"R_6Sg2q8T5PybBJOV"},"85":{"1":"In my state, it is legal to break the window.","2":"Break the window and call the cops.","3":"Break the window and wait for the owner and then punch them in the face.","4":"Record yourself breaking the window and taking the dog.","5":"Break the window and drive away so at least the dog can breathe or escape on its own.","6":"R_6azDKUzNwPbXPA6"},"86":{"1":"Call an officer.","2":"Look for someone in the parking lot.","3":"Look for someone in the mall.","4":"Try to open the door of the car.","5":"Try to break the window of the car.","6":"R_6dRkFMKKqofDP4z"},"87":{"1":"Look for the car owner by asking nearby people or having the mall page them.","2":"Call animal control for assistance.","3":"Stay by the car to monitor the dog's condition until help arrives.","4":"Take a photo of the car and license plate as a record for authorities.","5":"If the dog\u2019s life seems in immediate danger, break the window as a last resort.","6":"R_6dtRAW7AKBimeJz"},"88":{"1":"Break the window.","2":"Contact the police.","3":"Ask mall security to make an announcement.","4":"Jimmy the lock and open the door.","5":"Nothing.","6":"R_6eVD6NqwbW8dqAB"},"89":{"1":"Do nothing.","2":"Break the window and get the dog out.","3":"Call 911.","4":"Report the car to mall security.","5":"Wait until the owner comes back and yells at them.","6":"R_6eVJD9NA6X9ZM1U"},"90":{"1":"Call mall security.","2":"Call Animal Control.","3":"Call the police.","4":"Call for help.","5":"Break a window in the car.","6":"R_6jKUYnaHYdMREbf"},"91":{"1":"Call the police.","2":"Get help from the mall.","3":"Get someone to unlock the door.","4":"Break a window so she could get the dog out.","5":"Summon the mall guard.","6":"R_6rDIPY1kPprneQi"},"92":{"1":"Call security guard.","2":"Look for the car owner.","3":"Break the car boot.","4":"Get the dog something.","5":"Ask the owner some questions.","6":"R_6rmuKX05vLAvOBH"},"93":{"1":"Call for help.","2":"Stay with the dog.","3":"Provide water.","4":"Locate the owner.","5":"Block the direct sunlight.","6":"R_71d2fLSYJMHxME9"},"94":{"1":"Go back into the mall and tell security.","2":"Find something and break the window.","3":"Ignore it and keep walking.","4":"Ask the mall to make an announcement.","5":"Call the cops.","6":"R_71jIO8XxofgA5ZU"},"95":{"1":"Call an animal officer.","2":"Take the pet with her to the store.","3":"Park in the shade and leave ice-cold water for no longer than 5 minutes.","4":"Don't take your dog shopping and leave them in the car.","5":"Stop being irresponsible.","6":"R_7TYuRV0fo2RuQFb"},"96":{"1":"Call the police.","2":"Break a window.","3":"Get help from other shoppers.","4":"Call Animal Control.","5":"Try the car doors before breaking a window.","6":"R_7aJJRH6OUfnV4Sq"},"97":{"1":"Call 911.","2":"Ignore.","3":"Call for help around.","4":"Do nothing.","5":"Break the car glass for air to pass through.","6":"R_7b1S2VvxXNTuB9L"},"98":{"1":"Call mall security.","2":"Call the police.","3":"Break a window in the car to get air for the dog.","4":"If you have a \"jimmy,\" use it to pop lock, open the door, roll down the window part way, lock the car back up, and close the door.","5":"Do nothing.","6":"R_7fK7QK8Y4xWk1nJ"},"99":{"1":"Continue on without stopping to check on the dog.","2":"Call 911 to help the dog.","3":"Try to find the owner of the car through the mall's intercom system.","4":"Try to open up the car window herself to give the dog some air.","5":"Ask a stranger for help on what to do.","6":"R_7fkOe4dbCqL1JhN"},"100":{"1":"Call mall security.","2":"Call the police.","3":"Look for owner of car\/dog.","4":"Break the window of the car and rescue the dog.","5":"Nothing.","6":"R_7k7O4QRMI4S4I0x"},"101":{"1":"Do nothing.","2":"Look for the owner.","3":"Break the window.","4":"Call the police.","5":"Wait for the owner.","6":"R_7lKxI48EgTdnMm4"},"102":{"1":"Call emergency services.","2":"Locate the owner.","3":"Seek mall security assistance.","4":"Break into the car.","5":"Stay with the car.","6":"R_7lXk6NMhMvuo8pE"},"103":{"1":"Check if Ted can get a digital ticket.","2":"Call the Venue for Help.","3":"Buy a New Ticket.","4":"Ask for the ticket from another friend.","5":"Stay and Enjoy the Concert.","6":"R_7n2E1w0T0tmBrSb"},"104":{"1":"She should call the police.","2":"She should see if the door is locked.","3":"She should break a window.","4":"She should ask someone to help.","5":"She should call animal control.","6":"R_7rPSRV6hIbSm6cS"}},"Randomization":"Subset","TotalRandSubset":1}}},"68":{"Type":"Standard","SubType":"","Description":"Scenario7","ID":"BL_0IELkbwzoUmDGlg","BlockElements":[{"Type":"Question","QuestionID":"QID838"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1019"},{"Type":"Question","QuestionID":"QID839"},{"Type":"Question","QuestionID":"QID840"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID997"},{"Type":"Question","QuestionID":"QID847"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID841"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID842"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID843"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID844"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID845"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID846"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1037"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1008"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID974"},{"Type":"Question","QuestionID":"QID975"},{"Type":"Question","QuestionID":"QID976"},{"Type":"Question","QuestionID":"QID977"},{"Type":"Question","QuestionID":"QID978"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Call a friend or famiily member to take the knife.","2":"Inform airport security about the knife.","3":"Attempt to hide the knife in a secure area and hope it isnt found and taken.","4":"Abandon the knife entirely.","5":"Go through security and hope they don't mention the knife.","6":"R_106wNj20KZ6xB0O"},"2":{"1":"Tell security the problem.","2":"Throw it away.","3":"Leave the line and miss his flight.","4":"Book another flight.","5":"Bring it through security and hope for the best.","6":"R_190GFKTFeGPDRx7"},"3":{"1":"Throw it away.","2":"Tell security he forgot.","3":"Run to car and put it in car.","4":"Give it to security.","5":"Not attending the festival.","6":"R_1E1DXURxHj5zoWd"},"4":{"1":"Mail it to his house.","2":"Get an Uber and have them take it to the house.","3":"Pay to store it in a locker.","4":"Have a friend come and get it.","5":"Put it in lost and found, and come back and pick it up.","6":"R_1EZoFzjCq1uQ8s9"},"5":{"1":"He could return to the counter and try to put the knife in his checked luggage.","2":"He could rent a locker at the airport and store it there.","3":"He could call a friend to meet him at the airport to take the knife.","4":"He could cancel his trip and return home.","5":"He could see it as a loss and just toss it.","6":"R_1FnUUW3HgevYzZd"},"6":{"1":"Declare to TSA that he has a knife.","2":"Go home and return the knife.","3":"Try to sneak a knife through.","4":"Tell his friends he can't make it.","5":"Drop his knife in a garbage can and go through security.","6":"R_1Ic4ZIMVOPoURkj"},"7":{"1":"Discard it.","2":"Sell it.","3":"Explain the situation to security.","4":"Go home to return it.","5":"Stab himself with it in agony.","6":"R_1LZL7fIzii8yVXA"},"8":{"1":"Report to security.","2":"Call for a friend to come for it.","3":"Leave it with security.","4":"Hide it.","5":"Throw it away.","6":"R_1OI30P0hw3o2XBv"},"9":{"1":"Get out of the line to get rid of the knife.","2":"Surrender the knife to security personnel.","3":"Send it back for safekeeping.","4":"Alert security to the situation.","5":"Missed the flight.","6":"R_1OUptQGvK0r1RIk"},"10":{"1":"Cook.","2":"Support.","3":"Kill.","4":"Stab.","5":"Lie.","6":"R_1QmIdypXuN6APyV"},"11":{"1":"Mail it to himself.","2":"Put it in checked luggage.","3":"Rent a locker.","4":"Leave it behind.","5":"See if they miss it.","6":"R_1RZdTQtOHLNmkFj"},"12":{"1":"Do nothing.","2":"Take it out.","3":"Call someone to come and get it.","4":"Tell someone.","5":"Rent a locker.","6":"R_1UlRtlMFtVvMV6F"},"13":{"1":"Ditch the knife in the trash.","2":"Check the knife in with the TSA.","3":"Give the knife to an airport police officer.","4":"Put it in a secure locker.","5":"Give the knife to another person.","6":"R_1WCnLLbNlkN5Xz3"},"14":{"1":"He should alert one of the officials to see the best course of action.","2":"He could call a friend to come for the knife.","3":"He could wait till it gets to his turn and explain to the staff.","4":"He can rush back and drop off the knife at home.","5":"He could dispose of the knife.","6":"R_1f1SXLeK9VIXIMG"},"15":{"1":"Return to check-in counter: Inform airline staff, check knife in luggage.","2":"Check TSA knife policy: Confirm prohibited items, consider alternatives.","3":"Use airport mail center: Ship knife to destination or home.","4":"Leave knife at airport: Surrender to security or airport lost-and-found.","5":"Go back to car\/transport: Store knife safely, then return to security.","6":"R_1f7QxkxXe60wB94"},"16":{"1":"He could leave.","2":"He could tell them what happened.","3":"He could try to get past without them seeing.","4":"He could hide the knife somewhere.","5":"He could ask the security guard what to do.","6":"R_1k1jQWohFaRHghn"},"17":{"1":"Get out of line and ditch the knife behind a trashcan.","2":"Be honest about his profession and the knife.","3":"Drop the knife on the floor and kick it out of sight.","4":"Use it to kill the bag inspector.","5":"Go to the bathroom and leave the knife in there.","6":"R_1mEqeunjS9ZfMcu"},"18":{"1":"Toss the knife in the trash.","2":"Report the knife to security.","3":"Take the knife back out to his car.","4":"Try to get through security with the knife.","5":"Take the knife back home.","6":"R_1o7rmk66EqCjQ9b"},"19":{"1":"Do nothing and see if it is caught.","2":"Alert the security officer when he gets to the front of the line.","3":"Throw the knife away.","4":"Give the knife to a friend.","5":"Try to hide the knife better so it is not seen.","6":"R_1ow0wDgAr4zG6va"},"20":{"1":"Turn around and go put the knife in his car.","2":"Place the knife in his checked bagged.","3":"Just let it be confiscated.","4":"Ask if there is anything he can do with the knife like store it somewhere.","5":"Throw the knife away.","6":"R_1qCR4YLk8RyiKvm"},"21":{"1":"Ignore it.","2":"Ask a stranger to hold it for you until you get back.","3":"Tell TSA.","4":"Throw away.","5":"Eat it.","6":"R_1qeXmTebFIxcmuU"},"22":{"1":"Take the knife back to the car.","2":"Tell security.","3":"Throw it away.","4":"Get a new one shipped to his destination.","5":"Bundle it in clothes?","6":"R_1s7dewV7OhGhLiU"},"23":{"1":"He can leave it with Security and go on the plane.","2":"If he has time maybe someone can come and pick it up.","3":"Return home and don't go.","4":"Return home and reschedule the flight.","5":"Stay calm don't be nervous.","6":"R_1wJMzTjIO3wuPvj"},"24":{"1":"Dispose of the knife.","2":"Contact the Festival Organisers.","3":"Notify Security.","4":"Return the knife to his car.","5":"Check the knife in as luggage.","6":"R_30NK8GXqVmtrzC8"},"25":{"1":"Get rid of it and take the loss.","2":"Plant it in someone else's bag.","3":"Go check his carry-on.","4":"Not go.","5":"Kill TSA.","6":"R_30pn2AznvKMe182"},"26":{"1":"Leave it in a dustbin.","2":"Throw it away and get a new one.","3":"Hide it in a secret closet.","4":"Tell them you are a chef, so you must need it.","5":"Convince them.","6":"R_316ZRMJghIPfHCG"},"27":{"1":"Dispose the knife.","2":"Report to the security check with his documents and appointments.","3":"Call for support.","4":"Explain things to the security.","5":"Cancel the trip and go with a different flight.","6":"R_31D4VrSDquNTfA5"},"28":{"1":"Criticize.","2":"Rush through.","3":"Confront.","4":"Argue.","5":"Clarify stuff.","6":"R_32R0r2qoXbuX4HA"},"29":{"1":"Not saying anything.","2":"If he drove himself to the airport, he could take it back to his car.","3":"He could tell security that it is in there.","4":"If someone drove him to the airport, he could give it to them to keep while he was gone.","5":"He could see if he could have his bag put in the cargo bay and not as a carry-on.","6":"R_32zpM5ZsKLVkFEy"},"30":{"1":"Tell the screeners about the knife.","2":"Put his hands in the air.","3":"Remain calm.","4":"Remain focused.","5":"Pray.","6":"R_35XJBN8g5CqCxcR"},"31":{"1":"Explain it to a manager\/security.","2":"Call someone to pick it up from him and hold it for him until he comes back.","3":"Throw it away.","4":"Try to sell it on the spot.","5":"Give it to a stranger.","6":"R_39AOh67MgzH9Ec1"},"32":{"1":"Give it to security.","2":"Ask a friend to pick it up.","3":"Dump it in the trash before going through security.","4":"Try to sneak it in.","5":"Be honest about forgetting and let it get taken.","6":"R_3Cy3l9xy7qdsin6"},"33":{"1":"Get out of the queue, return to the check-in counter, and check bag.","2":"Ask security for advice on proceeding further.","3":"Call a friend to come pick up knife and leave without it, using knives available at festival.","4":"Throw knife away - last resort.","5":"Check for storage lockers within airport, and store knife until return - using knives at festival.","6":"R_3KNtlm03Afkz9l4"},"34":{"1":"Give up the knife and surrender it to the TSA.","2":"Leave the line and leave the knife in his car and come back.","3":"Try to plead with the TSA people.","4":"Try to bribe the TSA people.","5":"Ask the TSA people if there is any way to keep the knife safe till he comes back.","6":"R_3O2hk47yenGP9W5"},"35":{"1":"Leave the line and throw the knife away.","2":"Find out if it can be moved to checked baggage.","3":"Do nothing.","4":"Tell security what happened.","5":"Ask Security what his options are.","6":"R_3OZyTC9XvC0OPiw"},"36":{"1":"Return to his car and leave the knife there.","2":"Rent a locker and put the knife in it.","3":"Throw it away.","4":"Ask airport personnel for help with the situation.","5":"Give it up to security.","6":"R_3QWOpnso93EfdZj"},"37":{"1":"Notify airport security.","2":"Ask about checked baggage options.","3":"Consider borrowing a knife from a collegue.","4":"Safety deposit box option.","5":"Get your items confiscated.","6":"R_3RyAI83UO85Mq0k"},"38":{"1":"Go put the knife in his car.","2":"Throw the knife away.","3":"No other options.","4":"No other options.","5":"No other options.","6":"R_3S6UjJG08PiCEPp"},"39":{"1":"Ditch the line and call in a bomb threat, and leave the knife at home.","2":"Miss the flight and pay for another, if the knife costs more or is irreplaceable.","3":"Pay off the TSA guy to ship it to your home or ignore it.","4":"Try to hide the knife in his bag somehow.","5":"Give up the knife and chalk it up to his stupidity, maybe watch for it on ebay.","6":"R_3TZbSUK6pjoBxp2"},"40":{"1":"He could check his bag with the knife in it.","2":"He could get a locker and pick the knife up from the locker on his return home.","3":"He could ask security what should he do in case he needs to bring the knife with him.","4":"He could call a friend or family member to pick the knife up before he goes through security.","5":"He could throw the knife away and take the loss.","6":"R_3Vkpcf3f3aqTzgZ"},"41":{"1":"Dispose of the knife.","2":"Give the knife to security.","3":"Contact the airline for assistance.","4":"Mail the knife to the festival location.","5":"Ask to speak to a supervisor.","6":"R_3WBTnwI8QDPKK3U"},"42":{"1":"Carl could let the security officers know about the knife before going through the scanner to avoid misunderstandings.","2":"Carl can inquire if the airport has a storage facility where he can temporarily leave the knife and retrieve it later.","3":"Carl can contact a friend nearby or available and ask them to pick up the knife from the airport and hold it until he returns.","4":"Arrange for a local delivery service to pick up and deliver the knife to his home or a secure place.","5":"Carl can request a police escort that may provide guidance on transporting restricted items, though this would likely involve extra steps or fees.","6":"R_3dQLVP8lko9epzc"},"43":{"1":"Go put it back in his vehicle.","2":"Explain to TSA.","3":"Call family to come and get it.","4":"Call a friend to come get it.","5":"Don't get on the flight and reschedule.","6":"R_3fYEYedezPYLzXj"},"44":{"1":"Notify the police not to arrest him.","2":"Put the knife in the right suitcase.","3":"Call colleagues in case you are delayed.","4":"Be serene.","5":"Tell the truth.","6":"R_3hTY6vVsznCQz9T"},"45":{"1":"Throw away the knife.","2":"Give to security.","3":"Try to hide in the bag.","4":"Put in someone else's bag.","5":"Try to move in another bag.","6":"R_3iETHngP2xWuNGh"},"46":{"1":"Ask a friend to come pick it up.","2":"Throw it away.","3":"Ask security to hold onto it for him.","4":"Sneak it in.","5":"Stab the security guard.","6":"R_3j1CwjCwlWNYtRn"},"47":{"1":"Explain to the TSA officer.","2":"Leave the airport.","3":"Keep moving and hope they don't notice.","4":"Blame his friend.","5":"Apologize.","6":"R_3kNvn4Q7g7DBbw0"},"48":{"1":"Rent a storage locker to hold the knife until he returns.","2":"Get a later flight so he can go home to return the knife.","3":"Maybe he still has his luggage he can store it in.","4":"Abandon the knife.","5":"Cancel his trip.","6":"R_3pgdUQuoesxSY9j"},"49":{"1":"Abandon his knife.","2":"Get out of line and check his bag.","3":"Wing it.","4":"Proceed through security and hope they don't confiscate the knife.","5":"Tell security that he has a knife.","6":"R_3yW4hPACnMklSGR"},"50":{"1":"Inform the security staff immediately and explain the situation before they find the knife.","2":"Offer to check the knife in with the airline if that's allowed.","3":"If possible, return to a designated area outside security and dispose of or store the knife temporarily.","4":"Ask if there\u2019s a way to safely mail the knife back home or to the food festival location.","5":"Stay calm and polite, explaining that it was an honest mistake and that it\u2019s important for his work.","6":"R_3yeGLkSRIO8FnVq"},"51":{"1":"Mail\/send it back home with security.","2":"Take it back home.","3":"Put it in check on.","4":"Cut someone.","5":"Throw it away.","6":"R_5074epk0KmokfdJ"},"52":{"1":"Leave the line and, in hopes to keep the knife with him, find a security officer to explain what happened.","2":"Leave the line and in hopes to keep the knife with him, go to customer service and see if he can declare it as a package to be sent separately.","3":"Leave the line and take it back to leave it in his car.","4":"Leave the line and see if the airport has storage lockers.","5":"Leave the line and take it back home.","6":"R_52HHUcflPbAFLFf"},"53":{"1":"Give it away.","2":"Throw it away.","3":"Take it back to the car.","4":"Put in a locker.","5":"Sell it.","6":"R_54i4YC3HUUp89BR"},"54":{"1":"Tell the workers before they find it.","2":"Brandish it.","3":"Throw it in the trash.","4":"Claim it's not his.","5":"Take responsibility and explain.","6":"R_57Qn25xpVJM8QUN"},"55":{"1":"Call a friend or family member to come pick it up.","2":"Try to get through security anyway.","3":"Throw the knife away.","4":"Give the knife away.","5":"Ask an employee of an airport store to hold onto it for him until he returns.","6":"R_590Q0GsB3BrCf97"},"56":{"1":"Store the knife in a bag to go into the underbelly of the plane.","2":"Throw the knife away.","3":"Show the knife to the TSA and explain the situation.","4":"Try to sell or give it to someone at the airport.","5":"Try to smuggle it on board.","6":"R_5DoGtkVU2Jjwc54"},"57":{"1":"Bring it back to the vehicle.","2":"Toss it in the garbage.","3":"Bring it back to the luggage.","4":"Mail it from the airport back to his home.","5":"Leave it behind in the airport.","6":"R_5DvkV3f3cVc3i13"},"58":{"1":"Carl could check the knife at an airport locker.","2":"Carl could check the knife as part of checked luggage.","3":"Carl could throw the knife away.","4":"Carl could give the knife to a friend to take it home.","5":"Carl could explain his situation to the airline to see if they could help.","6":"R_5FnDIvEjRPhM6LE"},"59":{"1":"Get out of line and mail his knife back home.","2":"Stay in line and let security take his knife.","3":"Go back home.","4":"Try to get through with his knife.","5":"Throw his knife away.","6":"R_5GVJUa2sMK038sM"},"60":{"1":"He could ask to go put it in his checked bag.","2":"Carl could choose to surrender the expensive knife.","3":"Carl could choose to surrender the knife and buy a new one in Chicago.","4":"Carl could give it to a friend who drove him to the airport.","5":"Carl could choose to miss the flight, take the knife home, and take the next flight out to Chicago.","6":"R_5GkopTuQFGmLEt3"},"61":{"1":"Throw it away.","2":"Return home and catch an alternative flight.","3":"Try to go back to the desk and have the knife put in a checked-in bag.","4":"Book an additional checked-in bag and put the knife in it.","5":"Give it to someone in TSA for safekeeping.","6":"R_5I3kqgv2emazTa1"},"62":{"1":"He could walk up to the security officials and hand over the large knife to them after explaining how he came about having it in his bag.","2":"He could drop the knife in a place at the airport where no one would be able to suspect him of being the owner.","3":"He could also decide to get out of the venue and dispose of the knife.","4":"He could also look for someone who could help him get rid of the knife while he remains in the queue.","5":"Carl could also decide against attending the food festival.","6":"R_5JFQkbBsye5Z7Q9"},"63":{"1":"Throw away the knife in a designated wastebasket.","2":"Go back to check-in and see if it's possible to check-in the knife with his luggage.","3":"Check with staff for advice on how to handle the matter.","4":"Leave the line, call a friend and have them hold onto the knife until he returns from the festival.","5":"See if the airport has a way to mail his knife to either his home or to Chicago.","6":"R_5K2uhJmpmm5NO58"},"64":{"1":"Throw the knife away in a trash can.","2":"Admit to security that he accidentally brought it.","3":"If he has time, go back home to drop it off.","4":"Ask for assistance on how to best approach the situation.","5":"Hide it.","6":"R_5MR5QvICk3iVxQb"},"65":{"1":"Turn back.","2":"Put it away.","3":"Go ahead for the security check.","4":"Leave it back.","5":"Explain it to the security.","6":"R_5My5OV3JHKAZCrk"},"66":{"1":"Throw it out.","2":"Give it away.","3":"Try to sneak it through.","4":"Leave.","5":"Put it in someone else's bag.","6":"R_5OJ7K35QMBVckzn"},"67":{"1":"Call a friend.","2":"Get out of line.","3":"Give the knife to security.","4":"Go home.","5":"Throw it away.","6":"R_5TACPZZzRKtWPbr"},"68":{"1":"He could explain his situation.","2":"He could say that they took the knife away from him.","3":"He can quickly excuse himself and drop the knife somewhere safe.","4":"He could turn back, get it sorted, and later join another flight.","5":"Carl forgoes the festival in all.","6":"R_5Ttm6GBL7wtSai9"},"69":{"1":"Throw it away.","2":"Let security know the error.","3":"See if they can still put it in his luggage.","4":"Go back to check in and check it.","5":"Go home.","6":"R_5VOYKBkeYCydCWE"},"70":{"1":"Beg them for him to take it along because of the food festival.","2":"Tell them to keep it safe in a locker till he gets back.","3":"Go back home to keep it safe.","4":"Call one of his friends or family members to come get it.","5":"Get a dispatch rider to come get it and deliver it to his house.","6":"R_5XpUEq4GIuQvetv"},"71":{"1":"Discard the knife at security.","2":"Explain his profession to security.","3":"Explain to his colleagues that he might be late.","4":"Do not bring the knife with you.","5":"Return the knife to his car.","6":"R_5aKal4VnCBZMcxU"},"72":{"1":"Put it in his bag.","2":"Do not bring it out.","3":"Look for where to get knife.","4":"Check the nearest shop.","5":"Look for who has a knife.","6":"R_5dmajywumMb7QnU"},"73":{"1":"Return the knife to the car.","2":"Alert the security.","3":"Ask for a storage room and place the knife there.","4":"Return the journey.","5":"Call someone to come for it.","6":"R_5fwalBO7F218CTD"},"74":{"1":"When it's his turn, tell the agent it's for work and not going in checked luggage.","2":"?.","3":"?.","4":"?.","5":"?.","6":"R_5hLArf5UT11I013"},"75":{"1":"Try to hide the knife so it doesn't get noticed.","2":"Let the officers know he is carrying a knife of that size.","3":"Leave the knife behind to avoid trouble.","4":"Don't go to the festival.","5":"Do nothing and hope he doesn't get caught.","6":"R_5iyQxTv3HgDVAWv"},"76":{"1":"To hide it.","2":"To submit it to the security personnel.","3":"To give it to a family.","4":"To trash it.","5":"To hide for him not to be checked.","6":"R_5j2menEDFbYMQOU"},"77":{"1":"Rent a locker to store it.","2":"Call someone he knows to pick it up.","3":"Throw it away.","4":"Try to explain himself to the security.","5":"Not going to festival.","6":"R_5kMNt0gG6xGwQJD"},"78":{"1":"Be honest and let security know he accidentally brought his expensive knife, but emphasize he's a chef.","2":"Go back home and drop off his expensive knife, then return to the airport.","3":"Call a friend and ask them to come by and pick up his knife.","4":"Call a family member and ask if they can come by and pick up his knife.","5":"Hide the knife somewhere, or throw it away.","6":"R_5kzSBtreK87WgDQ"},"79":{"1":"Toss the knife.","2":"Hand over to security.","3":"Go home.","4":"Nothing.","5":"Nothing.","6":"R_5qew7P77BPNRXu6"},"80":{"1":"Miss the Flight.","2":"See if someone can retrieve it.","3":"Leave the knife with security.","4":"Declare the Knife.","5":"Check for Shipping Options.","6":"R_5uS62q5PwR000YF"},"81":{"1":"Panic.","2":"Tell the TSA agent about the knife.","3":"Turn around.","4":"Get out of line.","5":"Go back to the counter and try to ship it another way.","6":"R_5wF8GPKxXVbjBbJ"},"82":{"1":"Try to sneak the knife past security.","2":"Cancel his flight and apologize to his friends.","3":"Step out of line and try to find some place to mail the knife back to his house.","4":"Turn the knife over to security and lose it forever.","5":"Reschedule his flight and deal with the knife, and fly in later.","6":"R_5zFrEqcd0vP8HCx"},"83":{"1":"Hide the knife.","2":"Drop the knife.","3":"Give the knife to security.","4":"Ask if he could put it in the luggage.","5":"Go back and rent a storage unit in the airport and put it in.","6":"R_66aacwer5aClvAB"},"84":{"1":"Call someone to come and get the knife.","2":"Put the knife in the trash before going through baggage checks.","3":"Try to hide the knife in his bag.","4":"Give the knife to security before they find it.","5":"Hide the knife in the airport somewhere and get it when he comes back.","6":"R_66gvtEzsDayFAGr"},"85":{"1":"Leave the knife in the bag.","2":"Put the knife in his car.","3":"Ask security to hold the knife.","4":"Throw the knife away.","5":"Give it to someone else.","6":"R_6B3bcSl08N0mNBZ"},"86":{"1":"Inform the security personnel.","2":"Remove the knife and hand it over to the security.","3":"Show chef credentials.","4":"Dispose of the knife.","5":"Give to someone like giving it to airport staff to hold.","6":"R_6CI5mU6EdnnCFpM"},"87":{"1":"Step out of the line and dispose of the knife.","2":"Step out of the line and find somewhere to save it so he picks it up when he comes back.","3":"Move forward and hope he doesn't get caught.","4":"Step out of the line and explain his predicament to a security officer.","5":"Cancel his flight so he can go drop off his \"expensive\" knife at home.","6":"R_6LIRgvTCPrQONe8"},"88":{"1":"Go back to check the knife.","2":"Use an Airport Mail Service.","3":"Ask a Friend or Family Member to Pick It Up.","4":"Store the knife in an airport locker (if available).","5":"Surrender the knife to security.","6":"R_6LXt19abpf4LtPJ"},"89":{"1":"Leave the knife behind.","2":"Explain that he is working there.","3":"Have someone pick up the knife.","4":"Declare the knife.","5":"Check the knife.","6":"R_6SRtp44g5ttufV7"},"90":{"1":"Inform the security immediately.","2":"Check if there's a designated area for knives.","3":"Consider checking if the bag in his luggage is accepted by the airline.","4":"Prepare to surrender the knife if it is deemed prohibited by the airline.","5":"Call his colleagues for assistance.","6":"R_6k66YXQ58YnUgwc"},"91":{"1":"Run it back to his car.","2":"See if security could hold it somewhere until his return.","3":"Call a friend to come pick it up.","4":"Toss it in the trash.","5":"Hide it in the bathroom somewhere to get upon his return.","6":"R_6lMIWdZPvWj8YT6"},"92":{"1":"Get out of line and check his bag instead.","2":"Alert TSA beforehand.","3":"Go through security and let them take the knife.","4":"Pretend like he forgot and see what options they give him.","5":"Leave. Go home and not attend the festival.","6":"R_710EYMMzCCNmc1x"},"93":{"1":"Tell the security about the knife before going through security.","2":"Try to hide the knife.","3":"Explain to the security why he has the knife.","4":"Throw it away.","5":"Place it on someone else's luggage.","6":"R_72n64wF7PssOQ7v"},"94":{"1":"Leave the knife with TSA to have it sent back.","2":"Call someone to come get the knife from him.","3":"Leave the knife and buy a new one when he arrives.","4":"Return home to leave the knife and miss the flight.","5":"Run the security check.","6":"R_75yy6rmSUauMNtI"},"95":{"1":"Inform officials that he is a chef and needs the knife.","2":"Ask officials to keep the knife at the airport for pick-up when he comes back.","3":"Hide the knife from security.","4":"Throw away the knife before he is searched by officials.","5":"Hope they don't find the knife or stop him from taking it.","6":"R_7Fyi9b5fRdcmEUN"},"96":{"1":"If he has time, go back to his car.","2":"If you have time, rent a locker at the airport.","3":"Consult an agent at the terminal and explain the situation.","4":"User express mail at airport and mail knife to location.","5":"Call a friend to come pick it up.","6":"R_7MtImT69nciApx5"},"97":{"1":"Keep quiet about it.","2":"Turn back.","3":"Boycott the bag.","4":"Confront the security.","5":"Run away.","6":"R_7b1S2VvxXNTuB9L"},"98":{"1":"Not saying anything and risk security finding it.","2":"Explain to security their mistake.","3":"Better hide it so that it is not discovered by security.","4":"Call a friend to come pick it up.","5":"Plant it in someone else's bag for discovery then steal it back.","6":"R_7hcCmfBjloGjeY9"},"99":{"1":"Carl should immediately notify security.","2":"Carl should dispose of his knife.","3":"Carl should give it away to a random adult.","4":"Carl should call a friend to pick up his knife.","5":"Carl should hand the knife over to security.","6":"R_7k0W3Cz8z59clz9"},"100":{"1":"Call a Tow Service.","2":"Request a Ride from a Friend or Family Member.","3":"Use a Ride-Sharing Service.","4":"Call the airline for help.","5":"Look for Alternative Transportation.","6":"R_7n2E1w0T0tmBrSb"},"101":{"1":"He could return to the airline check-in and check his bag for the flight.","2":"He could decide to surrender the knife at security.","3":"He could try to persuade the security officer to let him through with the knife after explaining why he has it.","4":"He could do nothing and see if security found the knife.","5":"He could make a run for it through security with the knife.","6":"R_7n6ZmcyeOYNoo2Z"},"102":{"1":"He should declare it and tell the TSA.","2":"He should go back and put it in his car.","3":"He should throw it away.","4":"He should give it away to someone.","5":"He should III.","6":"R_7rPSRV6hIbSm6cS"},"103":{"1":"Cook.","2":"Supportive.","3":"Protective.","4":"Higher skill.","5":"Fight.","6":"R_7s61YpSgjK9tTKs"}},"Randomization":"Subset","TotalRandSubset":1}}},"69":{"Type":"Standard","SubType":"","Description":"Scenario8","ID":"BL_79ABWba2o5JIRIG","BlockElements":[{"Type":"Question","QuestionID":"QID848"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1020"},{"Type":"Question","QuestionID":"QID849"},{"Type":"Question","QuestionID":"QID850"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID998"},{"Type":"Question","QuestionID":"QID857"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID851"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID852"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID853"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID854"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID855"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID856"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1038"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1009"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID979"},{"Type":"Question","QuestionID":"QID980"},{"Type":"Question","QuestionID":"QID981"},{"Type":"Question","QuestionID":"QID982"},{"Type":"Question","QuestionID":"QID983"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"114":{"1":"Ask the Officiant for a Brief Pause.","2":"Have a family member or friend run to retrieve it.","3":"Use a Temporary Placeholder.","4":"Use the Mistake as a Teaching Moment.","5":"Send a Text or Quick Message.","6":"R_11Gwq1nh41XJk6C"},"115":{"1":"Tell someone quickly.","2":"Not tell anyone and see what happens.","3":"Have someone else call the taxi company.","4":"Borrow a ring from someone just for the ceremony.","5":"Do nothing.","6":"R_15XSR3ecjZ7ATur"},"116":{"1":"Daniel should first admit his mistake to the couple.","2":"Daniel should find a ring that will work just for the ceremony.","3":"Daniel should call the cab company to try to locate the car he left the ring in.","4":"Daniel should tip the driver really well to get the ring to the ceremony.","5":"Daniel should apologise profusely to the couple.","6":"R_18CfvWR8YoIBQbC"},"117":{"1":"Inform the sister.","2":"Track the taxi down and go for the ring.","3":"Inform the police.","4":"Relax.","5":"Go get the ring.","6":"R_1E6tiqTD3Brh0E2"},"118":{"1":"Inform the wedding officiant or best man.","2":"Send someone to retrieve the ring.","3":"Borrow a temporary ring.","4":"Stall or delay the ceremony.","5":"Inform his sister and the groom.","6":"R_1EVTptN2zfoV1jP"},"119":{"1":"He could take off his own ring and offer it temporarily.","2":"He could admit what he did.","3":"He could make a ring from flowers at the wedding.","4":"He could quickly call the taxi company.","5":"He could leave the ceremony and buy a new one.","6":"R_1Gv59GbbxIG4hqx"},"120":{"1":"Tell his sister that he lost the ring.","2":"Pretend he has it and then not have it at the last minute when asked.","3":"Deny he ever had it.","4":"Leave and call the taxi company's lost and found.","5":"Tell his sister he was robbed of the ring.","6":"R_1Hozj5hB2tr9ELj"},"121":{"1":"Call the taxi company.","2":"Explain to the groom what happened.","3":"Yell and be angry.","4":"Run away.","5":"Use a temporary ring for the ceremony.","6":"R_1K8yzhA7DBacMiY"},"122":{"1":"Call the taxi service.","2":"Run away.","3":"Explain the situation and go from there.","4":"Find a local jeweler to buy another one locally.","5":"Ask someone there to borrow their ring for the ceremony.","6":"R_1LZL7fIzii8yVXA"},"123":{"1":"Call the taxi company and ask them if they can\u2019t give him the location of the taxi.","2":"Try to track down the taxi's probable location himself using educated guesses of where it might go.","3":"Just own up to what he did and say, \"Sorry, Sis, I lost your ring, my bad.\"","4":"Try to get the wedding called off so no one ever has to know what happened.","5":"Casually swipe a ring off the finger of someone married in the crowd and substitute that.","6":"R_1OAFF5UcOWR7RaQ"},"124":{"1":"Stall.","2":"Inform the bride and groom.","3":"Call the taxi.","4":"Use a fake ring.","5":"Disappear.","6":"R_1OI30P0hw3o2XBv"},"125":{"1":"Give the groom a ring off his own finger as a temporary substitute ring to use.","2":"Whisper to the minister what happened so he can alter the ceremony.","3":"Whisper to the guy next to him to let him borrow a ring.","4":"Make a wedding day memory for everyone, with a classy apology.","5":"Pretend to hand the rings, and signal to the bride and groom to fake the ring portion of the ceremony.","6":"R_1Ow7wZwM1JpWcyW"},"126":{"1":"Call the taxi.","2":"Get another ring.","3":"Tell the truth.","4":"Delay the event.","5":"Use any available ring.","6":"R_1QmIdypXuN6APyV"},"127":{"1":"Make a joke.","2":"Tell the groom.","3":"Start touching his pocket repeatedly.","4":"Prepare to whisper to them; he doesn't have it.","5":"Take the ring he is wearing to temporarily substitute.","6":"R_1WItAFIsHsFVCpu"},"128":{"1":"Call the taxi company to ask them if it's there and to bring it back.","2":"Text the taxi company to see if they can bring the ring back.","3":"Explain to the groom what has happened.","4":"Ask the bridesmaid for help.","5":"Borrow a ring from someone in the wedding party to use for the ceremony.","6":"R_1Yac7Yn0QVqPDrO"},"129":{"1":"Leave the wedding and hide.","2":"Tell the truth.","3":"Call the taxi company and have it return.","4":"Say there's a hole in his pocket.","5":"Borrow a temporary ring from a guest.","6":"R_1mEqeunjS9ZfMcu"},"130":{"1":"Call the taxi company to ask the driver to return to the ceremony location.","2":"Ask a family member or guest to quickly drive to the taxi service and retrieve the ring.","3":"Inform the wedding planner or officiant about the situation and ask for advice.","4":"Search around the ceremony area to see if the ring fell out of his pocket earlier.","5":"Use his phone to call the taxi driver directly and explain the urgency of retrieving the ring.","6":"R_1meCQpmm7l4RkEk"},"131":{"1":"Stay calm.","2":"Panic.","3":"Try to find the driver.","4":"Tell someone.","5":"Disappear.","6":"R_1odU3Ka3wecrCse"},"132":{"1":"Attempt to call the taxi driver to have the ring returned.","2":"Alert the groom and sister to the situation.","3":"Stop the ceremony and apologize.","4":"Do nothing.","5":"Alert someone in the audience and ask them to track down the ring.","6":"R_1ow0wDgAr4zG6va"},"133":{"1":"Tell his sister.","2":"Call the taxi company.","3":"Tell the preacher.","4":"Burst into tears.","5":"Run to his mother.","6":"R_1s7dewV7OhGhLiU"},"134":{"1":"Signal to a trusted person for help.","2":"Contact the taxi driver.","3":"Stay calm and conceal the situation.","4":"Ask for a backup ring.","5":"Delegate someone to handle the situation quietly.","6":"R_2I3GLk4ENruE9Vg"},"135":{"1":"CHECK BACK TO THE SEAT.","2":"CALL THE DRIVER TO CHECK ON HIM.","3":"GET THE RING BEFORE TIME.","4":"INFORM THE FAMILY ABOUT THAT.","5":"GET THE EXACT SAME RING IF NOT FOUND.","6":"R_31D4VrSDquNTfA5"},"136":{"1":"Call the taxi company.","2":"Go buy a replacement ring.","3":"Send someone to go get the ring.","4":"Use someone else's ring.","5":"Possibly continue without the ring.","6":"R_325oPaz7SElRR4t"},"137":{"1":"Call the taxi company.","2":"Alert the bride's family.","3":"Get another set of rings for the ceremony.","4":"Run.","5":"Panic.","6":"R_32FVc0CkQRYbsOl"},"138":{"1":"Purchase a new one.","2":"Go after it.","3":"Informs them about the missing ring.","4":"Worried.","5":"Desperate.","6":"R_32R0r2qoXbuX4HA"},"139":{"1":"Call the cab company.","2":"See if the cab is near.","3":"Use his own ring as a temporary ring.","4":"Pray.","5":"Cry.","6":"R_35XJBN8g5CqCxcR"},"140":{"1":"Call the taxi company.","2":"Go find the taxi.","3":"Go buy a new ring.","4":"Tell the groom.","5":"Cry.","6":"R_3DbYYjPSDcTWv9O"},"141":{"1":"Tell the truth.","2":"Contact the taxi company.","3":"Use someone else's ring until the right one is found.","4":"Leave the wedding.","5":"Pretend nothing happened.","6":"R_3Ea8aK90rB1mdue"},"142":{"1":"Call the taxi.","2":"Buy another ring.","3":"Borrow one for the moment.","4":"Tell the groom.","5":"Try to find the taxi.","6":"R_3Ffkd8rLgczTTnw"},"143":{"1":"Contact the taxi immediately.","2":"Ask two people for their rings as stand-in rings.","3":"Send someone to retrieve the rings.","4":"Inform the wedding coordinator.","5":"Do nothing and pretend he didn't noticed.","6":"R_3FkZNCdE8A7qb9n"},"144":{"1":"Make an immediate call to the taxi service.","2":"Tell sister she is doing everything possible to locate the ring.","3":"Buy a look-alike ring as a temporary measure.","4":"Panic.","5":"Ask his mother what he should do.","6":"R_3GpL7t91IX7KJyU"},"145":{"1":"Collapse so he has to be carried out.","2":"Scream \"fire\" real loud and run to the exit, hoping others will follow.","3":"Text the taxi service and get them to bring it just in time for rings.","4":"Object to the marriage when asked.","5":"Punch the groom.","6":"R_3HzWRb7OlSvSi0v"},"146":{"1":"He could rush to find a new ring.","2":"Inform someone to delay the ceremony a bit in order to find the ring.","3":"Call the taxi company.","4":"The couple could proceed with the wedding and later get a ring.","5":"They could just proceed without a ring, as they are there to celebrate love and union.","6":"R_3KGZH9OLT6wf6Et"},"147":{"1":"Text the taxi driver.","2":"Call the taxi driver.","3":"Go to a ring shop.","4":"Buy another one online.","5":"Tell my sister.","6":"R_3Oqo1NreUUs9hoU"},"148":{"1":"He could excuse himself for a few minutes to look for it.","2":"He may be trying to call the taxi driver to see if he could save it.","3":"He could apologize and leave.","4":"He could quickly excuse himself to make some ring off of scratch somehow.","5":"He could quickly run to buy a new ring and then explain what happened to his sister and apologize.","6":"R_3PHqwmQkOjQPc2t"},"149":{"1":"Notify the Bride and Groom immediately.","2":"Ask for a Temporary Replacement.","3":"Contact the taxi company.","4":"Ask someone to retrieve the ring.","5":"Proceed Without the Ring Momentarily.","6":"R_3R7Ee9ri1xKBpff"},"150":{"1":"He could race out and try to find it.","2":"He could give her a ring he was wearing.","3":"He could just try to explain.","4":"He could try to fake it.","5":"He could try to postpone things.","6":"R_3ReVhaxfBloav88"},"151":{"1":"Call the taxi service immediately.","2":"Send someone to retrieve the ring.","3":"Inform the officiant.","4":"Find a temp ring.","5":"Stay calm.","6":"R_3RyAI83UO85Mq0k"},"152":{"1":"Discreetly let someone know.","2":"Call the taxi company.","3":"Apologize.","4":"Ask someone for a placeholder ring so the ceremony isn't disrupted.","5":"Check the rest of his pockets just in case.","6":"R_3SoVE4JwjV3oFQl"},"153":{"1":"Call the cab company.","2":"Call police and get a report started, let cab co know you're doing this.","3":"Find some gold tin foil and make some kind of ring for the ceremony.","4":"Tell the bride & groom what happened & what you did to remedy.","5":"Offer to replace the ring at some later date if not found.","6":"R_3TZbSUK6pjoBxp2"},"154":{"1":"Discreetly signal a family member or friend.","2":"Ask someone you know to retrieve the ring.","3":"Remain calm and improvise.","4":"Use a stand-in ring if possible.","5":"Alert the bride and groom discreetly.","6":"R_3agAyEXqHxnMecc"},"155":{"1":"Daniel can quickly inform someone in charge, like the bride or the wedding planner, about the situation to prevent misunderstandings.","2":"Ask a family member or friend if they have a temporary ring that could be used for the ceremony.","3":"Daniel can apologize to his sister and reassure her that he's actively working to resolve the issue as quickly as possible.","4":"Daniel can ask the guest to quickly search the area outside the venue in case the ring was dropped nearby.","5":"Daniel can calmly explain the situation to the officiant and ask for a brief pause in the ceremony.","6":"R_3dQLVP8lko9epzc"},"156":{"1":"Try to find the ring and get back in time.","2":"Admit his mistake.","3":"Buy a new ring and pretend it's the same one.","4":"Accuse someone of stealing it.","5":"Fake an emergency to have an excuse to leave.","6":"R_3j1CwjCwlWNYtRn"},"157":{"1":"Tell someone as soon as possible.","2":"Call the taxi company.","3":"Go outside to see if the taxi has come back.","4":"Cry.","5":"Apologize.","6":"R_3jTHlloF0CcCinm"},"158":{"1":"Quietly inform his sister or someone close, so they can help come up with a plan.","2":"Call the taxi company immediately to report the lost ring.","3":"Borrow a simple ring from someone in the audience as a temporary substitute.","4":"Have a guest quickly retrieve the ring if the taxi is nearby.","5":"Stay calm and focus on the moment\u2014he can explain the situation later.","6":"R_3oL1VXC3odM9ry0"},"159":{"1":"Find the taxi.","2":"Tell the couple.","3":"Delay the ceremony.","4":"Have someone find the taxi.","5":"Tell the groom.","6":"R_3p51sIe0DUaY2zt"},"160":{"1":"Ask someone to call the taxi company to find the ring.","2":"Do nothing and hope it works out.","3":"Stop the wedding and explain your mistake.","4":"Leave and go find the taxi.","5":"Leave and never come back.","6":"R_3pX5TXj5EJ2NFWo"},"161":{"1":"Call the taxi company to put out an alert on all the taxis in the local area.","2":"Let someone in the wedding know and tell them to stall the ceremony.","3":"Get in a car and drive around to see if he can find that same taxi.","4":"Call the taxi driver if he has that driver's number somehow.","5":"Let the ceremony go on without the ring.","6":"R_3rZlti00mf6qgCw"},"162":{"1":"Daniel could quietly inform the bride's or groom's family members.","2":"He could quickly check his surroundings.","3":"He could ask someone to retrieve the ring.","4":"If the ring cannot be retrieved in time, Daniel or someone else could suggest using a substitute ring.","5":"He could focus on the ceremony and resolve it later.","6":"R_3wdw3gEcVFqSsI7"},"163":{"1":"Call the taxi company.","2":"Get a substitute ring.","3":"Tell the bride and groom.","4":"Run away.","5":"Pretend he doesn't know what happened.","6":"R_5074epk0KmokfdJ"},"164":{"1":"Ask to call the taxi company.","2":"Use his own ring as a placeholder.","3":"Call for the wedding to stop.","4":"Cry.","5":"Borrow the ring of another guest as a placeholder.","6":"R_514nlU3fSXVOknF"},"165":{"1":"Text the taxi company to bring it back.","2":"Make a graceful exit and retrieve it.","3":"Make a funny comment and go get it.","4":"Ask someone who works at the ceremony to get in contact with the taxi company.","5":"Call the taxi company and ask them to get in contact with their driver.","6":"R_52xZVKt713vcEs9"},"166":{"1":"Fess up immediately.","2":"Apologize profusely.","3":"If he has a ring of his own, offer to have him use it to finish the ceremony.","4":"If he doesn't have a ring of his own to loan, find someone who does.","5":"Run out and call the cab company.","6":"R_53V45FDrHSBpukV"},"167":{"1":"Put a call through to the driver or company.","2":"Go to the park to look for the taxi.","3":"Inform anyone who can help.","4":"Inform the sister about the situation and calm her down.","5":"Suggest if there could be an alternative ring.","6":"R_54eLulcQnR1s3TC"},"168":{"1":"Call the taxi company.","2":"Cry.","3":"Tell the bride and groom what happened.","4":"Run and hide until he gets it back.","5":"Pretend to be sick.","6":"R_590Q0GsB3BrCf97"},"169":{"1":"Inform the Wedding Planner.","2":"Contact the Taxi Service.","3":"Search the venue.","4":"Borrow a Ring.","5":"Purchase a Replacement Ring.","6":"R_5Cd0igekmrN0cG5"},"170":{"1":"Go back to the taxi.","2":"Call the taxi company and get the ring brought back.","3":"Tell them you forgot the ring.","4":"Use a different ring temporarily.","5":"Don't show up.","6":"R_5DvkV3f3cVc3i13"},"171":{"1":"Inform someone about the incident (not the bride or groom).","2":"Locate the taxi driver using the app he booked it with.","3":"Reach out to the company's helpline.","4":"Try to remember the plate number.","5":"Make sure this does not reach the bride or the groom.","6":"R_5I3kqgv2emazTa1"},"172":{"1":"Tell the groom.","2":"Go look for it.","3":"Borrow one.","4":"Tell the bride.","5":"Leave the ceremony.","6":"R_5KH46MDo4bO40de"},"173":{"1":"Tell the groom immediately.","2":"Call the taxi company.","3":"Apologize profusely.","4":"Find a substitution.","5":"Offer to replace the ring.","6":"R_5KxvFmEl4eN7DXR"},"174":{"1":"Contact the taxi.","2":"Try to delay the ceremony.","3":"Talk to the preacher.","4":"Talk to the groom.","5":"Talk to his sister.","6":"R_5PvF1S60eajf04m"},"175":{"1":"I believe Daniel could be truthful to the people, which would be embarrassing for him.","2":"I think Daniel could make a joke of the situation to make people feel a little better about it.","3":"I think Daniel could send someone to track down the taxi in order to find and retrieve the ring.","4":"I believe Daniel could ask to borrow someone else's ring for the time being until he could retrieve the original ring.","5":"I think Daniel could send someone to the store to buy a new ring.","6":"R_5RVbon0W8XsjWia"},"176":{"1":"Pretend to die.","2":"Object to the wedding.","3":"Ask someone for a wedding ring to borrow for the ceremony.","4":"This is the best thing to do.","5":"This is the best thing to do again.","6":"R_5SejY3ouryoaGFQ"},"177":{"1":"Tell the truth.","2":"Call the taxi company.","3":"Stop the ceremony.","4":"Find another ring.","5":"Freak out.","6":"R_5TACPZZzRKtWPbr"},"178":{"1":"If he could still get ahold of the taxi.","2":"Try to contact his sister and tell her about the situation.","3":"Try to get a new one immediately, if possible.","4":"Be apologetic so they can understand.","5":"Try not to their moods.","6":"R_5Vy8E2IsOpaOyS2"},"179":{"1":"Call the taxi company and explain the situation.","2":"Tell his sister what happened.","3":"Use a spare one for the ceremony (e.g., his own or a family member's).","4":"Create a fake one.","5":"Lie.","6":"R_5aKal4VnCBZMcxU"},"180":{"1":"Call a friend to check for you.","2":"Call friends to see if they can bring you some.","3":"Try and see if you can see the car.","4":"Improvisation.","5":"Stay calm.","6":"R_5fwalBO7F218CTD"},"181":{"1":"Call the taxi company.","2":"Go to the taxi company.","3":"Email the taxi company.","4":"Text the taxi company.","5":"Message the taxi company.","6":"R_5gzLTn0JQtz61wE"},"182":{"1":"Say that he lost the ring.","2":"Run away from the scene.","3":"Apologize to his sister.","4":"Blame someone else.","5":"Put an excuse to not have the ring.","6":"R_5iyQxTv3HgDVAWv"},"183":{"1":"Call the taxi company and try to retrieve it.","2":"Admit the truth to the groom.","3":"Panic and abandon the wedding.","4":"Do not tell the truth and act surprised at the ceremony.","5":"Borrow some rings from the guests and handle them later.","6":"R_5nPfHw3O1iw4AOn"},"184":{"1":"Ask someone to retrieve the ring.","2":"Notify the officiant or wedding planner.","3":"Contact the taxi driver.","4":"Stay Calm and Discreet.","5":"Use a Substitute Ring or Object for the Ceremony.","6":"R_5qIbmcmlSBbB56x"},"185":{"1":"Ask to delay the wedding and call the taxi company.","2":"Take off his own ring so they can use a substitute.","3":"Do nothing and just cry.","4":"Make a joke out of it and tell the priest to do the same.","5":"Make one out of some string in his pocket for a temporary fix.","6":"R_5sn02dInsUYYBeV"},"186":{"1":"Panic.","2":"Call the taxi company.","3":"Tell his sister.","4":"Tell everyone at the wedding.","5":"Leave to go find the taxi.","6":"R_5wF8GPKxXVbjBbJ"},"187":{"1":"Call the taxi company.","2":"Go to the taxi company.","3":"Tell sister you left the ring in the taxi.","4":"Find a replacement ring.","5":"Faint.","6":"R_66aacwer5aClvAB"},"188":{"1":"Call the taxi service.","2":"Stall the wedding.","3":"Ask them to get married without rings.","4":"Run away and let them deal with it.","5":"Blame someone else.","6":"R_66gvtEzsDayFAGr"},"189":{"1":"Discreetly inform the best man or a trusted family member.","2":"Quickly assess if someone can retrieve the ring or send someone to retrieve the ring.","3":"Use a substitute ring or placeholder.","4":"Delay the ceremony temporarily.","5":"Inform the wedding officiant.","6":"R_6CI5mU6EdnnCFpM"},"190":{"1":"Ask a guest to borrow one of their rings.","2":"Whisper to the bride and groom an apology.","3":"Cry.","4":"Stop the ceremony to call the taxi company.","5":"Use a flower stem for a temporary ring.","6":"R_6Cgew2l9Qmnsmkz"},"191":{"1":"Discreetly inform the wedding officiant or the best man about the missing ring.","2":"Try to find a way to communicate with the taxi company to see if the ring has been found.","3":"Offer to temporarily delay the ceremony.","4":"Find an alternative way to retrieve the ring.","5":"Suggest using a substitute ring or a placeholder for the ceremony, and then exchange the actual rings later.","6":"R_6EaRLOS4p3QbXs6"},"192":{"1":"Ask someone to get in contact immediately with the taxi company.","2":"Apologize to his sister.","3":"Suggest using a temporary band from a guest to continue the ceremony.","4":"Try not to panic.","5":"Tell the groom.","6":"R_6L4wNwTzxkkeJnX"},"193":{"1":"Call the taxi company.","2":"Try to reach the driver.","3":"Ask a friend to help.","4":"Ask family to help.","5":"Take the car and leave.","6":"R_6Sg2q8T5PybBJOV"},"194":{"1":"Call the taxi company.","2":"Tell his sister immediately.","3":"Provide a temporary alternative.","4":"Ask someone else to track it down.","5":"Stop the wedding.","6":"R_6YbOL8ZdNaZuHmq"},"195":{"1":"Run away and never come back.","2":"Apologize.","3":"Shrug.","4":"Blame someone else.","5":"Claim it was stolen.","6":"R_6azDKUzNwPbXPA6"},"196":{"1":"Call the taxi company.","2":"Do whatever you can to find it.","3":"Have people help him locate it.","4":"Tell his sister.","5":"Don't panic!.","6":"R_6dW9vHpmI7WoPKe"},"197":{"1":"Contact the taxi company.","2":"Tell his sister and ask her opinion.","3":"Get a temporary replacement for the ring.","4":"Delay the wedding.","5":"Keep it a secret and cause a scene during the ceremony.","6":"R_6eVD6NqwbW8dqAB"},"198":{"1":"Call the taxi company.","2":"Call the non-emergency number.","3":"Call your future brother-in-law.","4":"Ask a friend for bail money.","5":"Move to Canada.","6":"R_6fOekFtDGz6G3Da"},"199":{"1":"Panic and inform the wedding party.","2":"Send someone to retrieve the ring.","3":"Improvise with a temporary ring.","4":"Delay the ceremony.","5":"Making use of a ring that belongs to another family for the meantime.","6":"R_6k66YXQ58YnUgwc"},"200":{"1":"Use a fake made-up ring and explain.","2":"Call the taxi company.","3":"Suspend the wedding.","4":"Contact a friend\/relative and ask to borrow a ring.","5":"Do not use any ring and explain.","6":"R_6kNuNPNFAKSyN3S"},"201":{"1":"Quietly inform a trusted person about the situation for help in retrieving it.","2":"Ask the wedding coordinator or someone in the audience to help locate the taxi company.","3":"Call the taxi company immediately to retrieve the ring.","4":"Quickly excuse himself to check for the ring at the entrance or nearby.","5":"Ask someone to rush to retrieve the ring if the taxi is close by.","6":"R_6plmU6Tgn0BiLtn"},"202":{"1":"Look for the taxi number to call and ask him to return the ring.","2":"Inform the sister and the husband about it.","3":"Check the closest store to buy any available one for the meantime.","4":"Talk to the parents to see if they have an old ring they can use for the meantime.","5":"Take the blame for the incident.","6":"R_6rOYPyDRQWMNwFP"},"203":{"1":"Tell an adult.","2":"Call the cab company.","3":"Tell the officiant.","4":"Use another ring from an adult.","5":"Cry.","6":"R_70vIFXS6ejXemnv"},"204":{"1":"Call the taxi company.","2":"Tell his sister.","3":"Go buy another ring.","4":"Pretend someone else lost it.","5":"Call off the wedding.","6":"R_710EYMMzCCNmc1x"},"205":{"1":"Reach out to the taxi service to request the driver to come back.","2":"Try to delay the ceremony.","3":"Come clean.","4":"Ask someone to go pick up the rings.","5":"Leave to pick up the rings himself.","6":"R_71Y4sWvyzStdHjm"},"206":{"1":"Alert the wedding planner.","2":"Send someone to retrieve the ring.","3":"Use a backup ring.","4":"Continue the ceremony without rings.","5":"Remain calm.","6":"R_72sGEqTvQKyRicF"},"207":{"1":"He could call the taxi guy to get it back.","2":"Borrow someone else's ring.","3":"Nothing and be empty-handed.","4":"Use a string as a replacement for now.","5":"Run to a jeweler and buy a new ring.","6":"R_74NxEjV7dEE5904"},"208":{"1":"Call the taxi service.","2":"Alert another guest to call the taxi service.","3":"Fashion a ring out of something until after the ceremony.","4":"Run away.","5":"Substitute someone else's ring.","6":"R_7CAF93nL8ofFDbz"},"209":{"1":"Get a new ring at a nearby store.","2":"Take someone's ring and use it in the interim.","3":"Prolong the wedding to the ring exchange part.","4":"Try calling the taxi driver, if possible.","5":"Tell the truth.","6":"R_7JfFwcDJP35Hzln"},"210":{"1":"Call the taxi agency, explain the situation.","2":"Ask a friend\/family member to loan a ring.","3":"Explain the situation to sister.","4":"See if gift shop or anything nearby to purchase a ring.","5":"Use his own ring for the ceremony.","6":"R_7MtImT69nciApx5"},"211":{"1":"Apologize to everyone.","2":"Run to get his phone to call the taxi.","3":"Talk to the minister about the situation.","4":"Walk back down the aisle.","5":"Pull the groom aside and let him know what happened.","6":"R_7PiTrt6sUtipXwT"},"212":{"1":"Call the taxi company.","2":"Ask one of the guests for a temp ring replacement.","3":"Pause the wedding until they can buy a new ring.","4":"Use a piece of string as a ring substitution.","5":"Ask the bride to get married without the ring.","6":"R_7RgtKNwB4sFbjoS"},"213":{"1":"Inform the Bride and Groom Immediately.","2":"Ask someone to retrieve the ring.","3":"Use a Substitute Ring Temporarily.","4":"Stay Calm and Focus on the Ceremony.","5":"Offer to Follow Up After the Ceremony.","6":"R_7SxpkpXtIoUbFSN"},"214":{"1":"Delay the ceremony.","2":"Order a new one.","3":"Postpone the ceremony.","4":"Proceed with the ceremony.","5":"Tell everyone what has happened.","6":"R_7b1S2VvxXNTuB9L"},"215":{"1":"Use a Temporary Ring.","2":"Send a trusted friend or family member to retrieve the ring from the taxi.","3":"Inform the Officiant: Immediately inform the officiant or a trusted family member about the missing ring.","4":"Contact the taxi company to locate the ring.","5":"Postpone the ceremony until the ring is found.","6":"R_7eITVZii96Fx1HJ"},"216":{"1":"Whisper quietly to the bride or groom; he doesn't have the ring.","2":"Turn and tell the minister he doesn't have the ring.","3":"Turn and tell the congregation he does not have the ring, but add the ceremony can continue without it.","4":"Apologize to the groom.","5":"Apologize to the bride.","6":"R_7fK7QK8Y4xWk1nJ"},"217":{"1":"Call the taxi company.","2":"Alert the wedding planner.","3":"Don't panic.","4":"Try to remember what the driver looked like.","5":"Wait to tell my sister.","6":"R_7h4LcjPDpIK7LRo"},"218":{"1":"Explain the situation to the bride and groom. Call the taxi.","2":"Call the taxi and hope you get the ring back before the bride and groom notice.","3":"Offer a replacement while you find the ring.","4":"Offer to pay for replacing the rings.","5":"Report the rings as stolen.","6":"R_7kTq963Jg1uqbcd"},"219":{"1":"Tells his sister.","2":"Call the taxi.","3":"Runs away.","4":"Stops the ceremony.","5":"Lies.","6":"R_7tG7BMrK68GaXQZ"},"220":{"1":"Call someone at the house; he might have left it there.","2":"Buy one now at the closest ring store.","3":"Check all his pockets, even the small ones.","4":"Call the taxi driver to come back.","5":"Use the taxi app to contact the driver.","6":"R_7whRUS1A3tz0DzI"}},"Randomization":"Subset","TotalRandSubset":1}}},"70":{"Type":"Standard","SubType":"","Description":"Scenario9","ID":"BL_cXWlxxeonMLjkkS","BlockElements":[{"Type":"Question","QuestionID":"QID858"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1021"},{"Type":"Question","QuestionID":"QID859"},{"Type":"Question","QuestionID":"QID860"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID999"},{"Type":"Question","QuestionID":"QID867"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID861"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID862"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID863"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID864"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID865"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID866"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1039"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1010"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID984"},{"Type":"Question","QuestionID":"QID985"},{"Type":"Question","QuestionID":"QID986"},{"Type":"Question","QuestionID":"QID987"},{"Type":"Question","QuestionID":"QID988"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Expanded","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"Continue calling his boss and hope he picks up.","2":"Call the court and make them aware of the situation.","3":"Call another co-worker to take over until the boss shows up.","4":"Leave and close the store.","5":"Do nothing and wait for his boss to show up or call him back.","6":"R_106wNj20KZ6xB0O"},"2":{"1":"Keep trying to reach his boss.","2":"Try to reach another employee.","3":"Close the store.","4":"Missed his appointment.","5":"Cry.","6":"R_110rMptMSqCu4MO"},"3":{"1":"Call someone at the court and explain the situation.","2":"Fume & be mad at this boss.","3":"Lock the door and leave anyway.","4":"Call another employee to see if they can take over.","5":"Keep waiting no matter what & miss court appointment.","6":"R_15XSR3ecjZ7ATur"},"4":{"1":"Call Jeff to find out what time he'll arrive.","2":"Give Jeff a few minutes to see if he'll arrive soon.","3":"Leave a note for Jeff and lock up.","4":"Call his lawyer to let him know he's going to be late.","5":"Call his lawyer, notify him of his situation, and see if he might be able to reschedule.","6":"R_17vAnhd7IcM0K3v"},"5":{"1":"Jeff could leave the store unlocked and go to his appointment.","2":"Jeff could call another employee to cover his shift.","3":"Jeff could wait a while longer to see if his boss showed up.","4":"Jeff could close the store and go to his appointment.","5":"Jeff could call for a welfare check for his boss.","6":"R_190yYgIlepm6122"},"6":{"1":"Call his lawyer.","2":"Lock up and go to court.","3":"Cry.","4":"Ask another coworker to fill in.","5":"Don't go into work.","6":"R_1Hcg6SPp3BVoCeB"},"7":{"1":"Try to see if anyone else who works at the store is available.","2":"Try to contact the person he has an appointment with to reschedule.","3":"Temporarily close the store.","4":"Leave message on boss's phone with issue and his solution.","5":"Come back to the store after the appointment.","6":"R_1JlXAFjunLfNJ1T"},"8":{"1":"Call Jeff to ask what to do.","2":"Leave without warning.","3":"Call the court to postpone.","4":"Have someone local cover.","5":"Have a coworker cover.","6":"R_1LZL7fIzii8yVXA"},"9":{"1":"Jeff should try reaching out to his boss again, perhaps leaving a polite voicemail or text explaining the urgency of the situation and requesting an immediate response.","2":"If Jeff knows of any other employees who might be able to cover the shift or help out, he should reach out to them. Even if it\u2019s not someone normally scheduled, they might be available to come in on short notice.","3":"Jeff should check the store's schedule or any communication (e.g., text group, email, or physical notice) to see if there\u2019s been any change in the schedule or if someone else was assigned to cover for his boss.","4":"If Jeff can't get in touch with his boss and no one else can come in, he may need to start preparing to close the store temporarily (if possible) in order to make it to his court appointment on time.","5":"If Jeff has to leave the store temporarily, he should post a sign or make a brief announcement to let any customers know that the store will be closed or briefly unavailable due to an emergency or unavoidable situation.","6":"R_1QDCLxUFcI9nrsz"},"10":{"1":"Get someone to cover for him.","2":"Lock the store and leave.","3":"Secure all cash.","4":"Try to call his boss again.","5":"Stay and miss court.","6":"R_1UlRtlMFtVvMV6F"},"11":{"1":"Call a Backup.","2":"Notify the court.","3":"Lock the Store Temporarily.","4":"Ask a Trusted Friend or Family Member for Help.","5":"Document the situation.","6":"R_1aNNXAPtx2JG665"},"12":{"1":"Call a co-worker.","2":"Call his boss's boss.","3":"Call the person in charge at the court.","4":"Close shop and go to court.","5":"Missed court.","6":"R_1dMHTTPBS7ebelo"},"13":{"1":"Close up and leave.","2":"Have a friend cover.","3":"Call his wife.","4":"Missed the court appointment.","5":"Have another employee cover.","6":"R_1dYsdWEsjj4TCRX"},"14":{"1":"He could call someone to cover for him.","2":"He could try reaching his boss's friend or relative.","3":"He could lock up the store and leave a note at the entrance.","4":"He could forfeit his appointment and wait for his boss.","5":"He could rush to the court and then rush back to check the store.","6":"R_1f1SXLeK9VIXIMG"},"15":{"1":"Wait.","2":"Call someone else.","3":"Close until he gets there.","4":"Call the boss and see how long he will be.","5":"Just be late.","6":"R_1gYkTgONa1P7tlf"},"16":{"1":"Keep calling the boss.","2":"Close the store.","3":"Call someone else to come in.","4":"Call the court and cancel.","5":"Call court, say you're running late.","6":"R_1l4O85U3kAj8WYN"},"17":{"1":"Lock up the store and leave.","2":"Try to get someone else to come in.","3":"Try to reschedule his court date.","4":"Call the corporate office and explain the problem; lock up and leave.","5":"Wait as long as possible, then lock up and leave.","6":"R_1oLsH88LkvnErhT"},"18":{"1":"Call the court and tell them his circumstances.","2":"Call his lawyer and tell them his circumstance.","3":"Close the store and go to court.","4":"Call a fellow employee and ask them to take over\u2014pay them if need be.","5":"Call a family member or friend and ask them to stand in for him at the store.","6":"R_1pfptn5NHWoAITf"},"19":{"1":"Lock the door of the store and go to his appointment.","2":"Call another coworker to come in.","3":"Call corporate to see what they can do.","4":"Call the court and see if he can be a little late.","5":"Missed his court appointment.","6":"R_1rBphvdw3otUTwT"},"20":{"1":"Call the boss.","2":"Close store.","3":"Leave note on door.","4":"Text boss.","5":"Quit.","6":"R_28Hu4dJvo1bBtOp"},"21":{"1":"Call the boss again and leave a message.","2":"Call a coworker for help.","3":"Contact the owner's emergency contact.","4":"Lock the store and leave a note.","5":"Inform the customers and seek assistance from neighbours.","6":"R_2I3GLk4ENruE9Vg"},"22":{"1":"Call the boss and leave a message.","2":"Notify a Co-worker.","3":"Alerting the store security.","4":"Closing the store temporarily.","5":"Document the situation.","6":"R_2eM4lcuYu5tfunU"},"23":{"1":"Give him a text message.","2":"Leave him a voicemail.","3":"Call a trustworthy friend to look after the store.","4":"Close the store and also leave a message for him.","5":"Get one of your siblings to watch the store.","6":"R_316ZRMJghIPfHCG"},"24":{"1":"Try calling his boss.","2":"Send him a message.","3":"Lock the shop.","4":"Go to the court.","5":"Stay at the shop.","6":"R_32OrViZvtk0cfip"},"25":{"1":"Leave anyway.","2":"Try calling the boss.","3":"Missed the court.","4":"Close up and leave a note.","5":"Stay until the boss shows.","6":"R_346RSAXMpOOSu79"},"26":{"1":"Lock up the shop and go to court.","2":"Wait a little longer for the owner.","3":"Skip the court appointment.","4":"Call the court and explain.","5":"Reschedule the appointment.","6":"R_3BXe3MkPaYAHQyu"},"27":{"1":"Call his lawyer, see if he can change court appt.","2":"Call a co-worker to wait for the boss to show up.","3":"Close the store if the apt cannot be changed.","4":"Have a friend go to the boss's house.","5":"Cry.","6":"R_3ClO8HXw735AwKB"},"28":{"1":"Text his boss about his need to leave.","2":"Contact his attorney about being late.","3":"Contact other store workers to find coverage.","4":"If there's a manager higher up than the owner, Jeff could explain the situation and ask for guidance. The manager might have a backup plan or be able to contact the owner.","5":"If possible, Jeff could try to reschedule his court appointment. This would require contacting the court and explaining the situation.","6":"R_3EDX2biNCypIGSE"},"29":{"1":"Call another colleague and see if he can help.","2":"Close the store while away.","3":"Quit the job and find another one.","4":"Wait and see if the boss arrives before 8 a.m.","5":"Skip the court appointment (not the best idea).","6":"R_3Ea8aK90rB1mdue"},"30":{"1":"Calls the owner.","2":"Calls a co-worker nearby.","3":"Check the schedule.","4":"Notify the manager or other branch office.","5":"Lock the store.","6":"R_3GN9uIXPDKwy275"},"31":{"1":"Jeff can lock the store, put up a sign, and leave for court.","2":"Wait and see if his boss arrives on time.","3":"Jeff could hire a replacement in case his boss doesn't show.","4":"Jeff could call hospitals to see if his boss were hurt.","5":"Jeff could leave the store unlocked and leave.","6":"R_3HzWRb7OlSvSi0v"},"32":{"1":"Call the court, let them know he's trying to come in.","2":"Leave message explaining situation on boss's phone.","3":"Wait an extra five minutes.","4":"Call in another worker if possible.","5":"Boss doesn't show or call within five minutes, close up shop.","6":"R_3NfHYUYzWPJFF3b"},"33":{"1":"He could try to call him again.","2":"He could get mad at his boss.","3":"He could try to see if his boss is okay.","4":"He could try to close the store to go to the court.","5":"He could not go to court and wait for his boss to come back.","6":"R_3PHqwmQkOjQPc2t"},"34":{"1":"Contact a coworker or backup.","2":"Leave a Note for the Boss.","3":"Contact the police for non-emergency assistance.","4":"Try Alternative Methods to Reach the Boss.","5":"Call the court.","6":"R_3R7Ee9ri1xKBpff"},"35":{"1":"He could stay and miss court.","2":"He could lock the door and leave.","3":"He could call another employee.","4":"He could just leave.","5":"He could text his boss and say why he was leaving.","6":"R_3ReVhaxfBloav88"},"36":{"1":"Call another employee to cover.","2":"Call the store manager.","3":"Close the store down and leave for his apt.","4":"Wait a few minutes longer to see if he shows up.","5":"Idk.","6":"R_3S6UjJG08PiCEPp"},"37":{"1":"Court never starts at 8 a.m., and nobody answers the phone before 8 a.m., but I guess he should call the court and get an adjournment if possible.","2":"Offer to do a screen-time call or some kind of telepresence.","3":"Call his attorney, if he has one, and explain.","4":"I don't know if it's criminal or civil. If criminal, just skip court and explain later.","5":"If civil, he needs to weigh against his job; if it's civil for high settlement, he should just lock the store and go.","6":"R_3TZbSUK6pjoBxp2"},"38":{"1":"Wait.","2":"Close and leave a note for the boss.","3":"Keep calling.","4":"Say he's gonna be a bit late.","5":"Call someone else to re-read.","6":"R_3hTY6vVsznCQz9T"},"39":{"1":"Contact co-worker.","2":"Contact Boss.","3":"Wait.","4":"Message Boss.","5":"Leave work.","6":"R_3hzhNe5kZRkNRve"},"40":{"1":"Keep phoning his boss.","2":"Call a co-worker.","3":"Shut down the store and leave.","4":"Call his lawyer.","5":"Quit his job.","6":"R_3pBhiBfoQjMZ2V3"},"41":{"1":"Keep calling his boss.","2":"Change the court appointment.","3":"Call the boss's wife and tell her the problem.","4":"Lock up the store and attend court.","5":"Wait and see if the boss shows up.","6":"R_3plErBG0o99AMKZ"},"42":{"1":"Lock up the store and go to court.","2":"Call Jeff's boss even more until he picks up.","3":"Call Jeff's boss's family.","4":"Stay at the store and be late for court.","5":"Call one of Jeff's co-workers to cover for him.","6":"R_3rZlti00mf6qgCw"},"43":{"1":"Jeff stays patient and postpones his appointment.","2":"Jeff should listen to his boss.","3":"Jeff should contact his boss a little bit earlier.","4":"Jeff should stay patient and ask his boss why he is not picking up calls.","5":"Jeff should stay patient.","6":"R_3wCWQztEFMuESAx"},"44":{"1":"Call another employee and see if they can come in on an emergency to cover for him.","2":"Call his boss to see what the holdup might be and wait if it is not too long.","3":"Call his boss to see what the holdup might be and lock up the store if the wait is too long.","4":"Contact his lawyer and see if a continuance is possible.","5":"Missed his court appointment.","6":"R_52HHUcflPbAFLFf"},"45":{"1":"Close the store down and leave.","2":"Missed the court date.","3":"Quit his job.","4":"Call a friend to take over.","5":"Continue calling his boss and hope they show up.","6":"R_5CfFrpbgdlKYh7S"},"46":{"1":"Get mad.","2":"Quit.","3":"Scream at his boss.","4":"Be calm.","5":"Relax.","6":"R_5Cye5rvDuqKReQJ"},"47":{"1":"Get another employee to cover for him.","2":"Call the court and inform them of the situation.","3":"Continue to call the owner\/boss.","4":"Close the store and go to court.","5":"Stay at the store and miss court.","6":"R_5EgbdD2MwKgbJT7"},"48":{"1":"See if anyone else can swing by to help.","2":"Close up the store.","3":"Keep calling his boss.","4":"Missed his appointment.","5":"Try to reschedule the appointment.","6":"R_5HOqqLtIEk6a2ZP"},"49":{"1":"Close the store with a note.","2":"Text his boss and let him know.","3":"Contact the court appointment.","4":"See if a co-worker can cover for him.","5":"Missed the appointment.","6":"R_5KxvFmEl4eN7DXR"},"50":{"1":"Texting his boss about what he will do and its reasons.","2":"Securing the store.","3":"Taking his appointment on time.","4":"Coming back to the store as soon as possible.","5":"Helping his boss with something else later.","6":"R_5Ldu5Sj0J03MiIu"},"51":{"1":"Lock the door and go.","2":"Walkout.","3":"Call the court.","4":"Missed court.","5":"Scream.","6":"R_5MSXi1UQzBU8zv3"},"52":{"1":"Leave and put a note on the locked door.","2":"Try to get someone to watch the store, and leave.","3":"Quit his job.","4":"Leave.","5":"Missed his appointment.","6":"R_5PvF1S60eajf04m"},"53":{"1":"Call the court office and let them know beforehand about his situation and that he'll be late.","2":"Call in a co-worker to cover until the boss shows up.","3":"Continue calling the boss and even leaving a voicemail or text explaining the situation, and continue to wait for a response.","4":"Close\/lock up the store and leave after leaving the voicemail or text to the boss.","5":"Cancel the court appointment if possible.","6":"R_5QAPkrHYGtvwLut"},"54":{"1":"Jeff could call the court clerk or whoever is in charge and let them know he was going to be late.","2":"Jeff could just not go and take his chances on the consequences.","3":"Jeff could quit his job and leave the store to go.","4":"Jeff could stay at work and keep trying to get a hold of his boss.","5":"Jeff could call other employees to come in and cover the rest of his shift.","6":"R_5RVbon0W8XsjWia"},"55":{"1":"Close up the shop and go.","2":"Close the store and go to the boss's house.","3":"Send a note to the court that he will be late.","4":"Stay at the store until his boss comes.","5":"Refuse to sell to anyone.","6":"R_5UEstXgXyKAUHFT"},"56":{"1":"Stay back until the boss comes.","2":"Lock the store and keep the key in a safe place for him to come get it.","3":"Goes to check the boss at home.","4":"Calls any friend or family that might know his whereabouts.","5":"Leave the convenience store and go to his appointment carelessly.","6":"R_5XpUEq4GIuQvetv"},"57":{"1":"Jeff could close the store and give his boss the reasons why he did.","2":"Jeff could call the court to let them know about his situation.","3":"Jeff could not call the court but be absent.","4":"Jeff could call his lawyer.","5":"Jeff could leave the store unattended.","6":"R_5aulyey3yG8PXoJ"},"58":{"1":"Call other co-workers.","2":"Write a note, close the store, and just leave.","3":"Call the boss until the boss answers.","4":"Call the boss's family members.","5":"Reschedule the court appointment.","6":"R_5hylUXm07Br8SGU"},"59":{"1":"Call the boss's wife.","2":"Have a friend go to boss's house.","3":"Call another worker to come in.","4":"Lock the store and leave.","5":"Skip court.","6":"R_5kMNt0gG6xGwQJD"},"60":{"1":"Call his boss and leave a voicemail explaining his court appointment and leave.","2":"Close shop and leave for his court appointment, leave a note for boss with explanation.","3":"Call an employee, ask if they can come in, and explain the situation.","4":"Jeff could just clock out of his shift and leave work.","5":"Stay and see if he can reschedule his court appointment.","6":"R_5kzSBtreK87WgDQ"},"61":{"1":"Call his boss.","2":"Call his attorney.","3":"If the boss doesn't show up, he needs to stay.","4":"He needs to call some co-workers to help with covering up the shift.","5":"Call family members to let them know about the situation.","6":"R_5nPfHw3O1iw4AOn"},"62":{"1":"Call a colleague.","2":"Call boss's wife.","3":"Call the court to explain and see if the date can be moved.","4":"Call Corporate.","5":"Last case scenario, close up and go to the appointment.","6":"R_5oBfzJd8oflVt23"},"63":{"1":"Call or text the boss multiple times.","2":"Contact a coworker or backup.","3":"Inform Customers of the Delay.","4":"Close the Store Temporarily (If Possible).","5":"Alert a family member or friend.","6":"R_5qIbmcmlSBbB56x"},"64":{"1":"Try to call a different employee.","2":"Leave anyway.","3":"Close the store if he knows how to.","4":"Call for a welfare check.","5":"Try and call the court and change the day depending on what it is.","6":"R_5tmA0q620A1GGus"},"65":{"1":"Contact the boss's emergency contact.","2":"Alert a coworker or back up.","3":"Document the situation.","4":"Inform the store's customers.","5":"Consider leaving after a reasonable wait.","6":"R_5xz0PrPzqNyIgb7"},"66":{"1":"Felt worried.","2":"Call.","3":"Report to work.","4":"Do his duties.","5":"Disappointed.","6":"R_64Mlypf2TgMbmz6"},"67":{"1":"1. Call the boss again and leave a message.","2":"2. Contact a co-worker or another employee to cover the shift.","3":"3. Notify the store\u2019s security or manager (if applicable) about the delay.","4":"4. Try to arrange for a temporary replacement or find someone in the store who can help until the boss arrives.","5":"5. If no help is available, consider leaving a note or informing a customer about the situation and leaving for the court appointment.","6":"R_6CpCYqUbssasO1L"},"68":{"1":"Jeff should call a co-worker to work for him.","2":"Jeff should close the store and go to court.","3":"Jeff could call the court to explain.","4":"Jeff could ask the court to reschedule.","5":"Jeff could quit his job.","6":"R_6IAeyh3yCz7vUGM"},"69":{"1":"Temporarily close the store.","2":"Contact the court to see if the appointment can be pushed back.","3":"Leave his boss a voicemail.","4":"Try to contact another employee to cover the shift.","5":"Just leave.","6":"R_6L4wNwTzxkkeJnX"},"70":{"1":"Lock the shop.","2":"Forgo his court appointment.","3":"Wait until his boss arrives, and then try to make the appointment.","4":"Call a trusted person or colleague to come cover for him.","5":"Set fire to the shop. I am running out of options here.","6":"R_6LIRgvTCPrQONe8"},"71":{"1":"He could lock the store if he had the keys and leave.","2":"He could stay until the boss comes.","3":"He could call his attorney and explain the situation\/ask to reschedule.","4":"He could call his friend or co-worker and ask them to cover for the boss.","5":"He could try to call the boss's family and inquire about where he is.","6":"R_6MSVzFHUWrpm50I"},"72":{"1":"Call the next person in line of management to come in.","2":"Call the owner's family.","3":"Call the boss's emergency contact.","4":"Call the courts to let them know\/lawyer.","5":"Leave the remaining employees in charge.","6":"R_6SRtp44g5ttufV7"},"73":{"1":"Leave the store unattended.","2":"Call the police for a welfare check on his boss.","3":"Stay and work until relieved.","4":"Call another employee.","5":"Close the store.","6":"R_6YbOL8ZdNaZuHmq"},"74":{"1":"Find out if there is a transportation delay.","2":"Contact other people who work for the store and ask if they can step in.","3":"Close the store and leave a note.","4":"Contact convenience store headquarters and ask for help.","5":"Ask a trusted relative or friend to step in.","6":"R_6g0Hs6TEwcmmwBT"},"75":{"1":"Call the court and say that he's running late.","2":"Call the court and try to reschedule.","3":"Call his boss.","4":"Call a co-worker to fill in for the boss.","5":"Leave the store unattended and go to his appointment.","6":"R_6jeQDjP0f1ICJuw"},"76":{"1":"Call other employees to fill in.","2":"Call the court and let them know he will be late.","3":"Reschedule his court appointment.","4":"Call a family member of his boss to ask for help.","5":"Call a friend who can take over the store.","6":"R_6jqYLUMt97mQsda"},"77":{"1":"Leave a note for his boss and go to court.","2":"Call up the court and ask to reschedule.","3":"Ask a friend to cover for him.","4":"Go to the boss's home and see if he is available.","5":"Continue to call the boss for additional time.","6":"R_6kNuNPNFAKSyN3S"},"78":{"1":"Call his boss again and leave a clear, urgent voicemail.","2":"Text or call a co-worker to cover for him until the boss arrives.","3":"Let a trusted regular customer know he needs to lock up and leave.","4":"Post a quick \"temporarily closed\" sign and leave the store secured.","5":"Explain the situation at court if he\u2019s late.","6":"R_6plmU6Tgn0BiLtn"},"79":{"1":"Lock the store and go to the court appointment.","2":"Call someone else to take his place at the store until the boss comes.","3":"Try to call someone at the court.","4":"Postpone his appointment if he can.","5":"Miss the appointment and hope nothing bad happens.","6":"R_6rDIPY1kPprneQi"},"80":{"1":"Ask his collegues to cover up for him while he goes for his appointment.","2":"Keep calling his boss till he picks up.","3":"Lock the store and go for his appointment, and leave a text for his boss on where he kept the keys.","4":"Lock the shop, go to the appointment, and get back later.","5":"Reschedule the appointment to the next date.","6":"R_6rOYPyDRQWMNwFP"},"81":{"1":"Call the court to explain the situation and request a delay or rescheduling of his appointment (if possible).","2":"Leave a note for the boss explaining the situation and his court appointment, and secure the store according to company protocol.","3":"Attempt to contact nearby convenience stores or competitor stores to ask if they can send temporary staff.","4":"Call other employees or management (if available) to cover the shift or inform them of the boss' absence.","5":"Call a family member or friend to cover for him temporarily while he attends his court appointment.","6":"R_6uP6OOuNejdcIe3"},"82":{"1":"Call coworkers and ask if they can cover the store until the boss arrives.","2":"Lock the store with a note saying we will reopen shortly.","3":"Contact the court or lawyer to say you might need more time.","4":"Call to see if he can reschedule.","5":"Wait for a good boss and arrive late.","6":"R_6zBHPyYPpZHrSA9"},"83":{"1":"Call another worker to fill in.","2":"Reschedule the court appointment.","3":"Send someone to the boss' house.","4":"Close the store down.","5":"Missed the court appointment.","6":"R_70vIFXS6ejXemnv"},"84":{"1":"Wait a little bit longer.","2":"He should have let his boss know beforehand, if the boss is running late, close us the store and go to court.","3":"Stay and work until the boss arrives and miss the court date.","4":"Call the judge and let them know the situation.","5":"Leave the store, but lock the door and leave his boss a message.","6":"R_710EYMMzCCNmc1x"},"85":{"1":"Keep calling him.","2":"Close the store and leave.","3":"Ask someone else to come in to cover for him.","4":"Quit.","5":"Stay and don't go to court.","6":"R_71Y4sWvyzStdHjm"},"86":{"1":"Prioritize his court appointment.","2":"Document everything.","3":"Call the police or authorities.","4":"Leave a note and lock up.","5":"Call a colleague or back-up contact.","6":"R_71d2fLSYJMHxME9"},"87":{"1":"Lock up and leave.","2":"Stay.","3":"Call his boss.","4":"Wait a little later than usual.","5":"Call another employee.","6":"R_72WAzU0jf8bT65J"},"88":{"1":"Try calling an alternative number to reach the boss, e.g., the boss's family member.","2":"Leave a voice message for the boss.","3":"Send a text message to his boss.","4":"Close the store and go to his court appointment.","5":"Call the court and explain his predicament.","6":"R_72n64wF7PssOQ7v"},"89":{"1":"He could just leave.","2":"He could call his boss.","3":"He could go on strike.","4":"He could call a different employer.","5":"He could call the boss's family.","6":"R_74NxEjV7dEE5904"},"90":{"1":"Try to contact someone else who knows the boss to see if they can get a hold of them.","2":"Make a sign to put up on the door that the store is temporarily closed, and then leave a note for his boss.","3":"Could contact the police to report them missing.","4":"Could contact the court and see what options he has for changing the court appointment.","5":"Contact another co-worker to see if they can cover for at least the duration of his court appointment.","6":"R_75yy6rmSUauMNtI"},"91":{"1":"Lock up the store and leave if he has the keys.","2":"Call the courthouse to see if he can reschedule.","3":"Call his lawyer, if he has one, to represent him or postpone the case.","4":"Continue to attempt to contact his boss.","5":"Try to find a co-worker to stand in for him.","6":"R_7CyjUM1lnYTRXWr"},"92":{"1":"Contact another employee.","2":"Leave a notice.","3":"Reach out to emergency contacts.","4":"Contact the court.","5":"Stay until he absolutely has to leave.","6":"R_7NnYslnXUagUp2N"},"93":{"1":"Call his boss's boss.","2":"Call his coworkers to see if they can cover for him.","3":"Lock the store up so he can go to court on time.","4":"Quit on the spot.","5":"Put a sign on the door saying the store is closed.","6":"R_7PiTrt6sUtipXwT"},"94":{"1":"Jeff could lock up, leave a note for his boss, and leave for his appointment.","2":"Jeff could call a co-worker to cover for him.","3":"Jeff could call the court to see if his appointment could possibly be rescheduled.","4":"Jeff could call the court to explain the situation and advise that he will be late.","5":"Jeff could walk out and quit, leaving the store unstaffed.","6":"R_7RvzucUpWomndJz"},"95":{"1":"Jeff can contact other store employees.","2":"Jeff can leave a note and close temporarily.","3":"He can also try other different ways to contact his boss.","4":"I also think he can reach out to nearby businesses to inform them of his sign out for the day.","5":"Lastly, I think he can document his actions for accountability.","6":"R_7SxpkpXtIoUbFSN"},"96":{"1":"Leave and close the store.","2":"Call a lawyer.","3":"Wait.","4":"Keep calling Boss.","5":"Leave.","6":"R_7YnrqDWDo1qaZVv"},"97":{"1":"Lock up the store and leave.","2":"Call some other employee to take over.","3":"Leave a note for his boss.","4":"Wait it out.","5":"Ditch the court appointment.","6":"R_7d1d18cbc3kH9qi"},"98":{"1":"Contact other employees to see if they can come in early to cover the shift.","2":"Call the police to report the situation.","3":"Close the Store Early.","4":"Leave a note for his boss explaining the situation.","5":"Seek Legal Advice.","6":"R_7eITVZii96Fx1HJ"},"99":{"1":"Call another co-worker to take over his shift.","2":"Close up the store and let his boss know that he needed to leave for his court appointment.","3":"Miss the court appointment and stay to work.","4":"Leave and assume that the boss will be there soon.","5":"Try to reschedule the court appointment.","6":"R_7fkOe4dbCqL1JhN"},"100":{"1":"Just leave the store.","2":"Call the court to explain his situation.","3":"Call his boss.","4":"Close the store then leave.","5":"Ignore the court appointment.","6":"R_7lKxI48EgTdnMm4"},"101":{"1":"Call his boss and let him know he has to leave.","2":"Close the store when he leaves, so people can't get in.","3":"Stay and miss his appointment.","4":"Call another employee to request coverage.","5":"Call the police to report Jeff missing.","6":"R_7pflm8v9g0RcukR"},"102":{"1":"Call directly the assistant manager.","2":"Leave a voicemail for the manager.","3":"Leave a note on the desk.","4":"Close the convenience store until the manager is there.","5":"Stay there.","6":"R_7whRUS1A3tz0DzI"},"103":{"1":"Jeff could call other employees to ask to take a shift.","2":"Jeff could call the regional manager.","3":"Jeff could lock the door and leave.","4":"Jeff could call his boss's wife.","5":"Jeff can try boss's house phone or email.","6":"R_8xJ9v7zSTbpsHIJ"}},"Randomization":"Subset","TotalRandSubset":1}}},"71":{"Type":"Standard","SubType":"","Description":"Comprehension Check1","ID":"BL_dnbkVIeVATz6tme","BlockElements":[{"Type":"Question","QuestionID":"QID871"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},"72":{"Type":"Standard","SubType":"","Description":"Instructions_2","ID":"BL_3CwBVzFQSpocIdw","BlockElements":[{"Type":"Question","QuestionID":"QID874"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Collapsed"}},"73":{"Type":"Standard","SubType":"","Description":"Comprehension_Check2","ID":"BL_cBLacnaSIKuZLDg","BlockElements":[{"Type":"Question","QuestionID":"QID875"}],"Options":{"BlockLocking":false,"RandomizeQuestions":"false","BlockVisibility":"Collapsed"}},"77":{"Type":"Standard","SubType":"","Description":"Demographics and Feedback","ID":"BL_4NuZwFXlOCyuKSW","BlockElements":[{"Type":"Question","QuestionID":"QID1218934339"},{"Type":"Question","QuestionID":"QID1216872380"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1218934341"},{"Type":"Question","QuestionID":"QID1216872382"},{"Type":"Question","QuestionID":"QID1216872383"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID990"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID1216872384"},{"Type":"Page Break"},{"Type":"Questio