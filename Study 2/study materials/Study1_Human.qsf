nation":"Redirect","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=C1JJSPO5"}}],"Properties":{"Count":66}}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"dc798511-93ea-4943-8385-599194d42378"}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"1040","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"RS","PrimaryAttribute":"RS_3xuiIcjNf03aR2C","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"true","NoIndex":"Yes","SurveyExpiration":null,"SurveyTermination":"Redirect","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"  &lt;&lt;  ","NextButton":"  &gt;&gt;  ","SkinLibrary":"mpib","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*2014","overrides":null},"NewScoring":1,"ShowExportTags":"false","CollectGeoLocation":"false","SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","SurveyMetaDescription":"Qualtrics sophisticated online survey software solutions make creating online surveys easy. Learn more about Research Suite and get a free account today.","PasswordProtection":"No","AnonymizeResponse":"No","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=C1JJSPO5","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]},"libraryId":"","nextButtonMid":"","previousButtonMid":"","headerMid":"","footerMid":"","QuestionsPerPage":"","PageTransition":"Slide","HighlightQuestions":"off","SecureResponseFiles":"false","ActiveResponseSet":null,"BallotBoxStuffingPreventionBehavior":"DefaultMessage","BallotBoxStuffingPreventionMessage":"","BallotBoxStuffingPreventionMessageLibrary":"","BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":true,"AutoConfirmStart":true,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":"","SurveyLinkCompletedMessageLibrary":"","ResponseSummary":"No","PartialDataCloseAfter":"LastActivity","RelevantID":"true","RelevantIDLockoutPeriod":"+30 days","PartialDeletion":null,"EOSMessage":null,"EOSMessageLibrary":null,"CustomStyles":{"customCSS":""}}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Study Information and Statement of Informed Consent for Adult Participants \u00a0 Thank you for your i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5;\">\n<h2>Study Information and Statement of Informed Consent for Adult Participants<\/h2>\n\n<div>&nbsp;<\/div>\n\n<p>Thank you for your interest in participating in our study on <strong>\u201cJudgments in Social Scenarios\u201d<\/strong>. Please take your time to read this text carefully.<\/p>\n\n<p>&nbsp;<\/p>\n\n<section>\n<h3>1. General Information about the Study<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>This study is a research project of the <b>[......]<\/b>&nbsp;In this study, we are interested in your judgments about everyday social scenarios. The study is being conducted by <b>[.....].<\/b>&nbsp;The responsible ethics committee has no ethical objections to the study.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>2. Procedure and Content of the Study<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>You will read a social scenario and be asked to read some ideas generated by participants that took part in a previous study. You will then be asked a series of questions and for your opinion on the scenario. We will also ask you to provide us with some background information (e.g., age, gender, race\/ethnicity). In this study, you will not allowed to switch tabs.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>3. Risks and Compensation<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>There are no major risks involved in this study.<\/p>\n\n<p>The study will take about <strong>9&nbsp;minutes<\/strong> to complete. You will receive compensation of <strong>\u00a31.35<\/strong>. If you decide to voluntary terminate your participation, you will receive <strong>\u00a30<\/strong>. If you switch tabs more than once, the survey will end and you will not be paid.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>4. Data Handling and Confidentiality<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>All data collected from you will be stored and scientifically analyzed in accordance with data protection laws (EU General Data Protection Regulation [GDPR], German Federal Data Protection Act). The study eill be hosted on <a href=\"https:\/\/www.qualtrics.com\/\">Qualtrics<\/a>.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>No contact information will be collected in the study. If you choose to participate in the study, we will link broad information about your age, gender and ethnicity to your answers throughout the survey. We will not store your Prolific ID.The study data will be stored for at least 10 years in accordance with the Good Scientific Practice of the German Research Foundation and the rules of the Max Planck Society.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>At the end of the data collection, it is planned to upload the research data (excluding your Prolific ID) to the Open Science Framework <a href=\"https:\/\/osf.io\/\">Open Science Framework (OSF)<\/a> for archiving and further scientific use. This will allow other researchers to verify or replicate the results of the study and improve the quality of scientific research. The study data can also be used for new research questions beyond the purpose of this study. The Open Science Framework is located outside the European Union. Once uploaded there, the data will be made publicly available worldwide, i.e., the data can be viewed, downloaded, and used by interested parties. This also means that the data leaves the scope of European data protection law and that you may not be able to enforce your rights as a data subject. From the time of publication on the platform, the use of this data can no longer be controlled, subsequently restricted or deleted anywhere, and this is beyond the control or responsibility of the MPIB.&nbsp;<\/p>\n\n<p>&nbsp;<br>\nThe results of the study will only be published without direct reference to you. If the results of the study are published, your identity will remain confidential. This means that it will not be possible to tell from the results which person provided the information, nor will it be possible to tell from the research data that you took part in a study, unless you have given separate consent for personal publication.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>Results will only be published anonymously without direct reference to you.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>5. Legal Basis<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>The legal basis for the processing of your data is your consent, in accordance with Article 6(1)(a) of the GDPR. You may withdraw your consent at any time with effect for the future. You may also withdraw your consent to the processing and use of your data at any time without negative consequences.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>6. Data Subject Rights<\/h3>\n\n<div>&nbsp;<\/div>\n\n<ul>\n\t<li>Right of access (Art. 15 GDPR)<\/li>\n\t<li>Right to rectification (Art. 16 GDPR)<\/li>\n\t<li>Right to erasure (Art. 17 GDPR)<\/li>\n\t<li>Right to data portability (Art. 20 GDPR)<\/li>\n\t<li>Right to restriction of processing (Art. 18 GDPR)<\/li>\n\t<li>Right to object (Art. 21 GDPR)<\/li>\n\t<br>\n<\/ul>\n\n<p>Complaints can be directed to the Bavarian Data Protection Authority, P.O. Box 606, 91511 Ansbach, Germany.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n\n<section>\n<h3>7. Voluntary Participation<\/h3>\n\n<div>&nbsp;<\/div>\n\n<p>Participation is voluntary. You may withdraw at any time without giving a reason or facing any negative consequences. To withdraw, contact the researcher through Prolific or email [.....].&nbsp;Since no personally identifiable data is collected, your data cannot be linked to you after the study\u2019s completion, and withdrawal of your data afterward is not possible.<\/p>\n\n<p>&nbsp;<\/p>\n<\/section>\n<\/div>","DefaultChoices":false,"DataExportTag":"Consent","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Study Information and Statement of Informed Consent for Adult Participants \u00a0 Thank you for your i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID1","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var qid   = this.questionId;\n  var $q    = jQuery('#' + qid);\n  var $text = $q.find('.QuestionText');\n\n  \/\/ Style the consent text as a scrollable box\n  $text.css({\n    'max-height': '700px',    \/\/ adjust height if you like\n    'overflow': 'auto',\n    'border': '1px solid #ccc',\n    'border-radius': '6px',\n    'padding': '12px',\n    'background': '#fff'\n  });\n  \/\/ Start at top\n  $text.scrollTop(0);\n\n});"}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1000","SecondaryAttribute":"In this situation, here are five actions that a previous participant believed Heinz could do. \u00a0 \u00a0.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">\n\n<div style=\"text-align: center;\"><b>In this situation, here are five actions that a previous participant believed Heinz could do.<\/b><\/div>\n&nbsp; &nbsp;&nbsp; &nbsp;\n\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B2D8D8; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color:#000000; font-family: Georgia, serif;\">${lm:\/\/Field\/1}<\/span>\n<\/div>\n\n<br>\n\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B2D8D8; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color:#000000; font-family: Georgia, serif;\">${lm:\/\/Field\/2}<\/span>\n<\/div>\n\n<br>\n\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B2D8D8; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color:#000000; font-family: Georgia, serif;\">${lm:\/\/Field\/3}<\/span>\n<\/div>\n\n<br>\n\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B2D8D8; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color:#000000; font-family: Georgia, serif;\">${lm:\/\/Field\/4}<\/span>\n<\/div>\n\n<br>\n\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B2D8D8; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color:#000000; font-family: Georgia, serif;\">${lm:\/\/Field\/5}<\/span>\n<\/div>\n\n\t\n\t<span> <span>\n<\/span><\/span><\/span><\/span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\n    \/\/ ===========================\n    \/\/  TAB SWITCH DETECTION\n    \/\/ ===========================\n    let tabSwitchCount = parseInt(Qualtrics.SurveyEngine.getEmbeddedData('tabSwitchCount')) || 0;\n\n    const blurHandler = function () {\n        tabSwitchCount++;\n        Qualtrics.SurveyEngine.setEmbeddedData('tabSwitchCount', tabSwitchCount);\n\n        if (tabSwitchCount === 1) {\n            alert(\"!!! Please do not switch tabs during the test. Switching tabs again will flag your result as compromised !!!\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Warning');\n        } else {\n            alert(\"!!! Your result is compromised !!! The survey will end after this block.\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Yes');\n        }\n    };\n\n    window.addEventListener('blur', blurHandler);\n\n    Qualtrics.SurveyEngine.addOnUnload(function () {\n        window.removeEventListener('blur', blurHandler);\n    });\n\n\n    \/\/ ===========================\n    \/\/  LOOP & MERGE VALUE STORAGE\n    \/\/ ===========================\n    var iteration = parseInt(Qualtrics.SurveyEngine.getEmbeddedData('iteration')) || 1;\n\n    var optionValue = \"${lm:\/\/Field\/6}\";\n\n    \/\/ Hardcode scenario ID\n    var scenarioValue = \"1\"; \/\/ \n\n    var optionFieldName = \"option_id_\" + iteration;\n    var scenarioFieldName = \"scenario_id_\" + iteration;\n\n    \/\/ Store the values in the embedded data\n    Qualtrics.SurveyEngine.setEmbeddedData(optionFieldName, optionValue);\n    Qualtrics.SurveyEngine.setEmbeddedData(scenarioFieldName, scenarioValue);\n\n    \/\/ Increment iteration for the next loop\n    Qualtrics.SurveyEngine.setEmbeddedData('iteration', iteration + 1);\n\n    \/\/ Optional: console debugging\n    \/\/ console.log(\"Stored \" + optionValue + \" in \" + optionFieldName);\n    \/\/ console.log(\"Stored \" + scenarioValue + \" in \" + scenarioFieldName);\n    \/\/ console.log(\"Next iteration: \" + (iteration + 1));\n});","DefaultChoices":false,"DataExportTag":"S1-FR","QuestionID":"QID1000","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this situation, here are five actions that a previous participant believed Heinz could do. \u00a0 \u00a0...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1001","SecondaryAttribute":"Here are some things Heinz could do, as suggested by Chat-GPT ${lm:\/\/Field\/1}","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Here are some things Heinz could do, as suggested by Chat-GPT<br><br>${lm:\/\/Field\/1}<br><\/span><\/span><\/span>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q317","QuestionID":"QID1001","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Here are some things Heinz could do, as suggested by Chat-GPT ${lm:\/\/Field\/1}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1002","SecondaryAttribute":"After doing this, Heinz' wife gets the medication later than necessary, and she soon gets more il...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family: Arial, Helvetica, sans-serif; color: #000000; font-size: 16px;\">\n<br>\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B3E5FC; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color: #000000; font-family: Georgia, serif;\">After doing this, Heinz' wife gets the medication later than necessary, and she soon gets more ill.<\/span><\/div><br>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><em>Please rate how much you agree with the following statement:<\/em><\/span><\/span><\/span><br>\n&nbsp;\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\"Heinz should be blamed for his wife getting more ill.\"<\/strong><\/span><\/span>&nbsp;<\/div>\n\n<span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\t\n\tvar q = jQuery(\"#\" + this.questionId);\n    \n    \/\/ --- Hide all handles initially ---\n    q.find(\".handle\").css('visibility', 'hidden');\n    \n    \/\/ --- When user clicks or touches the track, show handles ---\n    q.find(\".track\").on(\"click touchstart\", function() {\n        jQuery(this).find(\".handle\").css('visibility', 'visible');\n    });\n\n    let tabSwitchCount = parseInt(Qualtrics.SurveyEngine.getEmbeddedData('tabSwitchCount')) || 0;\n\n    const blurHandler = function () {\n        tabSwitchCount++;\n        Qualtrics.SurveyEngine.setEmbeddedData('tabSwitchCount', tabSwitchCount);\n\n        if (tabSwitchCount === 1) {\n            alert(\"!!! Please do not switch tabs during the test. Switching tabs again will flag your result as compromised !!!\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Warning');\n        } else {\n            alert(\"!!! Your result is compromised !!! The survey will end after this block.\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Yes');\n        }\n    };\n\n\n    window.addEventListener('blur', blurHandler);\n\n\n    Qualtrics.SurveyEngine.addOnUnload(function () {\n        window.removeEventListener('blur', blurHandler);\n    });\n});","DefaultChoices":false,"DataExportTag":"C1-S1-B","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"NotApplicable":false,"MobileFirst":false},"QuestionDescription":"After doing this, Heinz' wife gets the medication later than necessary, and she soon gets more il...","Choices":{"4":{"Display":"&nbsp;"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":7,"Labels":{"1":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\ndisagree<\/em><\/span><br \/>\n&nbsp;"},"2":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\nagree<\/em><\/span><br \/>\n&nbsp;"}},"QuestionID":"QID1002","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"Condition","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1003","SecondaryAttribute":"As a result, Josh does not make his originally scheduled flight, so other people going on the saf...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family: Arial, Helvetica, sans-serif; color: #000000; font-size: 16px;\">\n<br>\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B3E5FC; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color: #000000; font-family: Georgia, serif;\">As a result, Josh does not make his originally scheduled flight, so other people going on the safari have to wait for him.<\/span><\/div><br>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><em>Please rate how much you agree with the following statement:<\/em><\/span><\/span><\/span><br>\n&nbsp;\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\"Josh should be blamed for the safari being delayed.\"<\/strong><\/span><\/span>&nbsp;<\/div>\n\n<span><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\t\n\tvar q = jQuery(\"#\" + this.questionId);\n    \n    \/\/ --- Hide all handles initially ---\n    q.find(\".handle\").css('visibility', 'hidden');\n    \n    \/\/ --- When user clicks or touches the track, show handles ---\n    q.find(\".track\").on(\"click touchstart\", function() {\n        jQuery(this).find(\".handle\").css('visibility', 'visible');\n    });\n\n    let tabSwitchCount = parseInt(Qualtrics.SurveyEngine.getEmbeddedData('tabSwitchCount')) || 0;\n\n    const blurHandler = function () {\n        tabSwitchCount++;\n        Qualtrics.SurveyEngine.setEmbeddedData('tabSwitchCount', tabSwitchCount);\n\n        if (tabSwitchCount === 1) {\n            alert(\"!!! Please do not switch tabs during the test. Switching tabs again will flag your result as compromised !!!\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Warning');\n        } else {\n            alert(\"!!! Your result is compromised !!! The survey will end after this block.\");\n            Qualtrics.SurveyEngine.setEmbeddedData('compromised', 'Yes');\n        }\n    };\n\n\n    window.addEventListener('blur', blurHandler);\n\n\n    Qualtrics.SurveyEngine.addOnUnload(function () {\n        window.removeEventListener('blur', blurHandler);\n    });\n});","DefaultChoices":false,"DataExportTag":"C1-S2-B","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"NotApplicable":false,"MobileFirst":false},"QuestionDescription":"As a result, Josh does not make his originally scheduled flight, so other people going on the saf...","Choices":{"4":{"Display":"&nbsp;"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":7,"Labels":{"1":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\ndisagree<\/em><\/span><br \/>\n&nbsp;"},"2":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\nagree<\/em><\/span><br \/>\n&nbsp;"}},"QuestionID":"QID1003","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"Condition","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_6QJc0lBxS7XQcKi","Element":"SQ","PrimaryAttribute":"QID1004","SecondaryAttribute":"After Darya does this, the concert staff at the entrance become suspicious of Darya and her frien...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family: Arial, Helvetica, sans-serif; color: #000000; font-size: 16px;\">\n<br>\n<div style=\"margin-left: 40px; margin-right: 40px; background-color: #B3E5FC; padding: 20px; border-radius: 5px; text-align: justify;\">\n  <span style=\"color: #000000; font-family: Georgia, serif;\">After Darya does this, the concert staff at the entrance become suspicious of Darya and her friends and refuse to let them in.<\/span><\/div><br>\n<br