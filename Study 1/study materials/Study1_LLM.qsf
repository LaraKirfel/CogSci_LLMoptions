idden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Here are some things Eamon could do, as suggested by Chat-GPT: \u00a0${e:\/\/Field\/C4S4_Response}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    setTimeout(function() {\n        \/\/ Retrieve the LLM response from the embedded data\n        var response = \"${e:\/\/Field\/C4S4_Response}\";\n        \n              \/\/ Log the raw LLM response to the console\n        console.log(\"Raw LLM Response: \", response);\n\n        \/\/ Sanitize the response by removing unwanted characters\n        response = response.replace(\/\\u00a0\/g, ' ')\n                           .replace(\/\\s+\/g, ' ')\n                           .replace(\/<br>\/g, '');\n\n        \/\/ Log the sanitized response to the console\n        console.log(\"Sanitized LLM Response: \", response);\n\n        \/\/ Split the response using the '#' delimiter\n        var actions = response.split('#');\n\n        \/\/ Log the split actions to the console\n        console.log(\"Split Actions: \", actions);\n\n        \/\/ Remove any empty elements that might occur if response starts with a '#'\n        actions = actions.filter(action => action.trim() !== \"\");\n\n        \/\/ Trim whitespace from each action\n        for (var i = 0; i < actions.length; i++) {\n            actions[i] = actions[i].trim();\n        }\n\n\n        \/\/ Check if we got exactly 5 actions\n        if (actions.length === 5) {\n            \/\/ Store each action as embedded data\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S4Action1\", actions[0]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S4Action2\", actions[1]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S4Action3\", actions[2]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S4Action4\", actions[3]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S4Action5\", actions[4]);\n        } else {\n            console.error(\"Error: Expected 5 actions but got \" + actions.length);\n        }\n    }, 3000);  \/\/ Delay by 3 seconds to ensure data is ready\n});","QuestionText_Unsafe":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\">Here are some things Darya could do, as suggested by Chat-GPT:<\/span><br>\n<br>\n<span style=\"color:#000000;\">&nbsp;${e:\/\/Field\/C4S3_Response}<\/span><\/span><\/span>","DataExportTag":"C4-S4-FR ","QuestionID":"QID975"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID976","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":5,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":141,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"C4-S4-t ","QuestionID":"QID976"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID977","SecondaryAttribute":"Now, you will read about what Eamon decided to do. Eamon honks at the driver. After Eamon does th...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\">Now, you will read about what Eamon decided to do.<br>\n<br>\nEamon honks at the driver.<br>\n<br>\nAfter Eamon does this, the drifting car crashes into another car, resulting in a pileup accident.<br>\n<br>\n<em>Please rate how much you agree with the following statement:<\/em><\/span><br>\n<br>\n<strong>