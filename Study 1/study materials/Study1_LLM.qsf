actions = response.split('#');\n\n        \/\/ Log the split actions to the console\n        console.log(\"Split Actions: \", actions);\n\n        \/\/ Remove any empty elements that might occur if response starts with a '#'\n        actions = actions.filter(action => action.trim() !== \"\");\n\n        \/\/ Trim whitespace from each action\n        for (var i = 0; i < actions.length; i++) {\n            actions[i] = actions[i].trim();\n        }\n\n\n        \/\/ Check if we got exactly 5 actions\n        if (actions.length === 5) {\n            \/\/ Store each action as embedded data\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C3S2Action1\", actions[0]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C3S2Action2\", actions[1]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C3S2Action3\", actions[2]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C3S2Action4\", actions[3]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C3S2Action5\", actions[4]);\n        } else {\n            console.error(\"Error: Expected 5 actions but got \" + actions.length);\n        }\n    }, 3000);  \/\/ Delay by 3 seconds to ensure data is ready\n});","QuestionText_Unsafe":"<span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Here are some things Heinz could do, as suggested by Chat-GPT:<br \/>\n<br \/>\n&nbsp;${e:\/\/Field\/C3S1_Response}<\/span><\/span><\/span>","DataExportTag":"C3-S2-FR\u00a0","QuestionID":"QID887"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID888","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":5,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Cl