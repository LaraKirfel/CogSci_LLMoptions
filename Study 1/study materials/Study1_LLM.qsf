1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID17\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In this study, you'll read 3 short scenarios.\n\nYou will be asked to come up with some possibilities the agent could do in each scenario.\nThen, you will be asked to answer some questions about scena...<\/span> <span class=\"LeftOpDesc\">I will be asked questions about possibilities that I myself generated.<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID17\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID17","QuestionIDFromLocator":"QID17","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":null,"messageID":null,"subMessageID":"VE_ERROR"}}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID537","SecondaryAttribute":"If you experienced any other issues with the survey or if you have any suggestions for improvemen...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">If you experienced any other issues with the survey or if you have any suggestions for improvements or thoughts you would like to share, please comment below.&nbsp;<\/span><\/span><\/p><p><br><\/p>","DefaultChoices":false,"DataExportTag":"feedback3","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":653,"InputHeight":29},"QuestionDescription":"If you experienced any other issues with the survey or if you have any suggestions for improvemen...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":