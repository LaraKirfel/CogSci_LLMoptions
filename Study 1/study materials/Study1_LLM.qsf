tica,sans-serif;\">As a result, the dog suffers a heatstroke before anyone arrives for help and suffers from serious neurological damages.<br \/>\n<br \/>\n<em>Please rate how much you agree with the following statement:<\/em><br \/>\n<br \/>\n<strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&quot;Erica should be blamed for the dog&#39;s subsequent damages.&quot;<\/strong><\/span><\/span><\/span>","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"NotApplicable":false,"MobileFirst":false},"QuestionDescription":"As a result, the dog suffers a heatstroke before anyone arrives for help and suffers from serious...","Choices":{"4":{"Display":"&nbsp;"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":7,"Labels":{"1":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\ndisagree<\/em><\/span><br \/>\n&nbsp;"},"2":{"Display":"<span style=\"font-size:14px;\"><em>Completely<br \/>\nagree<\/em><\/span><br \/>\n&nbsp;"}},"QuestionJS":false,"QuestionText_Unsafe":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">After Cameron tries to do this, the woman attempts to walk all the way to her destination. As a result, the woman is late.&nbsp;<br \/>\n<br \/>\n<em>Please rate how much you agree with the following statement:<\/em><br \/>\n<br \/>\n<strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&quot;Cameron should be blamed for the woman being late to her destination.&quot;<\/strong><\/span><\/span>","DataExportTag":"C3-S6-B ","QuestionID":"QID1005"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID1006","SecondaryAttribute":"Please read the following scenario:","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><em>Please read the following scenario:<\/em><\/span><\/span><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read the following scenario:","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><em>Please read the following scenario:<\/em><\/span><\/span>","DataExportTag":"Q1006","QuestionID":"QID1006"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID1007","SecondaryAttribute":"Erica is leaving the mall on a hot summer day. In the parking lot, she notices a dog in the back...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Erica is leaving the mall on a hot summer day. In the parking lot, she notices a dog in the back of a car without any of its windows open. The dog is panting heavily and looks tired.&nbsp;<\/span><\/span><\/span><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Erica is leaving the mall on a hot summer day. In the parking lot, she notices a dog in the back...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Eamon is driving home on a two-lane road and thinks the driver ahead of him is intoxicated. The car has been slowly drifting between the two lanes and is currently driving in the middle of road.<\/span><\/span><\/span><\/p>","DataExportTag":"C4-Scenario6 ","QuestionID":"QID1007"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID1008","SecondaryAttribute":"Here are some things Erica could do, as suggested by Chat-GPT: \u00a0${e:\/\/Field\/C4S6_Response}","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\">Here are some things Erica could do, as suggested by Chat-GPT:<\/span><br>\n<br>\n<span style=\"color:#000000;\">&nbsp;${e:\/\/Field\/C4S6_Response}<\/span><\/span><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Here are some things Erica could do, as suggested by Chat-GPT: \u00a0${e:\/\/Field\/C4S6_Response}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    setTimeout(function() {\n        \/\/ Retrieve the LLM response from the embedded data\n        var response = \"${e:\/\/Field\/C4S6_Response}\";\n        \n        \/\/ Log the raw LLM response to the console\n        console.log(\"Raw LLM Response: \", response);\n\n        \/\/ Sanitize the response by removing unwanted characters\n        response = response.replace(\/\\u00a0\/g, ' ')\n                           .replace(\/\\s+\/g, ' ')\n                           .replace(\/<br>\/g, '');\n\n        \/\/ Log the sanitized response to the console\n        console.log(\"Sanitized LLM Response: \", response);\n\n        \/\/ Split the response using the '#' delimiter\n        var actions = response.split('#');\n\n        \/\/ Log the split actions to the console\n        console.log(\"Split Actions: \", actions);\n\n        \/\/ Remove any empty elements that might occur if response starts with a '#'\n        actions = actions.filter(action => action.trim() !== \"\");\n\n        \/\/ Trim whitespace from each action\n        for (var i = 0; i < actions.length; i++) {\n            actions[i] = actions[i].trim();\n        }\n\n\n        \/\/ Check if we got exactly 5 actions\n        if (actions.length === 5) {\n            \/\/ Store each action as embedded data\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S6Action1\", actions[0]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S6Action2\", actions[1]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S6Action3\", actions[2]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S6Action4\", actions[3]);\n            Qualtrics.SurveyEngine.setEmbeddedData(\"C4S6Action5\", actions[4]);\n        } else {\n            console.error(\"Error: Expected 5 actions but got \" + actions.length);\n        }\n    }, 3000);  \/\/ Delay by 3 seconds to ensure data is ready\n});","QuestionText_Unsafe":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\">Here are some things Eamon could do, as suggested by Chat-GPT:<\/span><br>\n<br>\n<span style=\"color:#000000;\">&nbsp;${e:\/\/Field\/C4S4_Response}<\/span><\/span><\/span>","DataExportTag":"C4-S6-FR ","QuestionID":"QID1008"}},{"SurveyID":"SV_74lfKBubMMSg194","Element":"SQ","PrimaryAttribute":"QID1009","SecondaryAttribute":"Timing","Terti