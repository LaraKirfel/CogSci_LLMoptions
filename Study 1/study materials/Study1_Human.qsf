":"Redirect","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=C1JJSPO5"}}],"Properties":{"Count":122}}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"486a97ce-4648-4418-ad8b-57df005d4753"}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"989","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"RS","PrimaryAttribute":"RS_8koD172o0kCS5Cu","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"true","NoIndex":"Yes","SurveyExpiration":null,"SurveyTermination":"Redirect","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"  &lt;&lt;  ","NextButton":"  &gt;&gt;  ","SkinLibrary":"mpib","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*2014","overrides":null},"NewScoring":1,"ShowExportTags":"false","CollectGeoLocation":"false","SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","SurveyMetaDescription":"Qualtrics sophisticated online survey software solutions make creating online surveys easy. Learn more about Research Suite and get a free account today.","PasswordProtection":"No","AnonymizeResponse":"No","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=C1JJSPO5","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]},"libraryId":"","nextButtonMid":"","previousButtonMid":"","headerMid":"","footerMid":"","QuestionsPerPage":"","PageTransition":"Slide","HighlightQuestions":"off","SecureResponseFiles":"false","ActiveResponseSet":null,"BallotBoxStuffingPreventionBehavior":"DefaultMessage","BallotBoxStuffingPreventionMessage":"","BallotBoxStuffingPreventionMessageLibrary":"","BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":true,"AutoConfirmStart":true,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":"","SurveyLinkCompletedMessageLibrary":"","ResponseSummary":"No","PartialDataCloseAfter":"LastActivity","RelevantID":"true","RelevantIDLockoutPeriod":"+30 days","PartialDeletion":null,"EOSMessage":null,"EOSMessageLibrary":null,"CustomStyles":{"customCSS":""}}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Study Information and Statement of Informed Consent for Adult Participants \u00a0 Thank you for your i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><strong>S<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">tudy Information and Statement of Informed Consent for Adult Participants<\/span><\/span><\/strong><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Thank you for your interest in participating in our &nbsp;study. Please take your time to read this text carefully. If you have any questions, we are happy to answer them. By agreeing, you consent that you have read the information presented and that you are willing to participate in the study.&nbsp;<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>&nbsp;1. Aim of the study&nbsp;<\/strong><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">In this study, we are interested in people's judgments about everyday social scenarios.<br>\n<br>\n<strong>2. Procedure and content of the study<\/strong><\/span><\/span><\/div><div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><\/strong><b><br><\/b>In this study, you will read about a social scenario. You will then be asked a series of questions and for your opinion on the scenario. In the end, you will be asked to provide demographic information. Further information regarding the task will be provided later.<br>\n<br>\n<strong>3. Are there any risks involved?&nbsp;<\/strong><\/span><\/span><\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Participating in this study is associated with no risks.&nbsp;<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>4. What will happen to the information and data collected?<\/strong>&nbsp;<\/span><\/span><\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This study is a research project of the [.......]. The data collected will be used for research purposes only. The data collected will be used for research purposes only. During the data analysis, your data may be shared with our collaborators. Your Prolific ID will be not be saved in our dataset.&nbsp;<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">The study data may also be made publicly accessible via research databases or scientific publications (typically via the Internet). This sharing of data makes it possible for other researchers to check or replicate the results of the study and enhances the quality of scientific research. The study data may also be used for new research questions going beyond the purposes of this particular study. Please note that once study data are publicly accessible, further distribution by others cannot be ruled out as this is beyond the area of influence or responsibility of the MPI for Human Development. Therefore, as a matter of principle, study data are only transferred or made publicly accessible without your Prolific ID.&nbsp;<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>&nbsp;5. Participation is voluntary&nbsp;<\/strong><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Participation in this study is voluntary. You may withdraw from the study at any time without giving any reason and without any negative consequences. Please note that compensation will only be provided to participants who complete the entire study; if you choose to withdraw or do not finish the study, you will not receive compensation. You may also withdraw your consent to data processing and usage at any time with effect for the future and without negative consequences. For further questions or requests to withdraw your data, please contact [.......].<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>6. Consent<\/strong><\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This document has informed you about participation in this study on idea generation. The study involves generating ideas about a social scenario and making a series of judgments about these ideas and the scenario. It lasts approximately 7 minutes.<\/span><\/span><\/div>","DefaultChoices":false,"DataExportTag":"Consent_Condition1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Study Information and Statement of Informed Consent for Adult Participants \u00a0 Thank you for your i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID1","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SQ","PrimaryAttribute":"QID114","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"C1-S2-t","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID114","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":105,"NextAnswerId":1}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SQ","PrimaryAttribute":"QID1216872380","SecondaryAttribute":"\u00a0 In this part of the experiment, we'd like you to answer a series of background questions. \u00a0 You.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">In this part of the experiment, we&#39;d like you to answer a series of background questions.<\/span><\/span><br \/>\n&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Your answers to these questions are very helpful, and are for research purposes only.&nbsp;Remember that your responses are entirely anonymous. If you feel uncomfortable with a&nbsp;question in this section, you can leave the question blank.<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 In this part of the experiment, we'd like you to answer a series of background questions. \u00a0 You...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON"}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">In this part of the experiment, we&#39;d like you to answer a series of background questions.<\/span><\/span><br \/>\n&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Your answers to these questions are very helpful, and are for research purposes only.&nbsp;Remember that your responses are entirely anonymous. If you feel uncomfortable with a&nbsp;question in this section, you can leave the question blank.<\/span><\/span><\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"Q1","QuestionID":"QID1216872380"}},{"SurveyID":"SV_7WAUs8h39ApcuMe","Element":"SQ","PrimaryAttribute":"QID1216872381","SecondaryAttribute":"What is your age?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">What is your age?<\/span><\/span><\/div><div><br><\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibil